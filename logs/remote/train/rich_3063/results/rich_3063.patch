+from rich.markup import render
+
+def test_escapes():
+    test_cases = [
+        ("test\\[", "test["),
+        ("test\\\\", "test\\"),
+        ("test\\\\\\", "test\\"),
+        ("test\\\\[", "test\\["),
+        ("test\\[bold]", "test[bold]"),
+    ]
+
+    for markup, expected in test_cases:
+        result = render(markup)
+        actual = result.plain
+        print(f"Markup: {markup!r} | Expected: {expected!r} | Result: {actual!r} | Match: {actual == expected}")
+
+if __name__ == "__main__":
+    test_escapes()
