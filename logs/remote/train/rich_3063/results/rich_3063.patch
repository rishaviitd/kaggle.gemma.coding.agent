@@ -0,0 +1,17 @@
+from rich.markup import render
+from rich.text import Text
+
+def test_backslash():
+    test_cases = [
+        ("test\\", "test\\"),
+        ("test\\\\", "test\\\\"),
+        ("test\\[", "test["),
+        ("test\\[bold]", "test[bold]"),
+        ("test\\[bold] text", "test[bold] text"),
+    ]
+    for markup, expected in test_cases:
+        result = render(markup)
+        print(f"Markup: {markup!r} -> Result: {result} (Expected: {expected!r})")
+
+if __name__ == "__main__":
+    test_backslash()
