diff --git a/fix_markup.py b/fix_markup.py
new file mode 100644
index 00000000..7fb1b395
--- /dev/null
+++ b/fix_markup.py
@@ -0,0 +1,10 @@
+with open("rich/markup.py", "r") as f:
+    content = f.read()
+
+lines = content.splitlines()
+for i, line in enumerate(lines):
+    if "re.sub" in line and "plain_text" in line and "r\"" in line:
+        lines[i] = r'            plain_text = re.sub(r"\\([\\\[])", r"\1", plain_text)'
+
+with open("rich/markup.py", "w") as f:
+    f.write("\n".join(lines) + "\n")
