+from rich._wrap import divide_line
+from rich.cells import cell_len
+
+def test_cjk_wrap():
+    text = "Hello こんにちは" # "Hello " (6 cells), "こんにちは" (10 cells)
+    width = 8
+    # "Hello " fits (6 cells).
+    # "こんにちは" (10 cells) does not fit in remaining 2 cells.
+    # Move to new line.
+    # Now on new line of width 8.
+    # "こんにちは" (10 cells) > 8, so it should be folded.
+    # "こん" (4) + "にち" (4) = 8.
+    # "は" (2)
+    # Expected divides: [6, 8, 10]
+    divides = divide_line(text, width, fold=True)
+    print(f"Text: {text}, Width: {width}, Divides: {divides}")
+    
+    parts = []
+    last = 0
+    for d in divides:
+        parts.append(text[last:d])
+        last = d
+    parts.append(text[last:])
+    print(f"Parts: {parts}")
+
+
+if __name__ == "__main__":
+    test_cjk_wrap()
