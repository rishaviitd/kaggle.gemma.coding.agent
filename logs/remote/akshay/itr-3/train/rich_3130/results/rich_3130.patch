+from rich.console import Console
+from rich.markdown import Markdown
+
+markdown_text = """
+| Header |
+| --- |
+| [link](https://google.com) and text |
+"""
+
+console = Console(record=True)
+console.print(Markdown(markdown_text))
+output = console.export()
+print(output)
+
+# We expect to see both the link and the text.
+# If the bug exists, only the last part might be rendered.
