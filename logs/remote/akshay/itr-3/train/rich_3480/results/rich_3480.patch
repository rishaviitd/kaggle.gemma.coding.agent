@@ -0,0 +1,22 @@
+from rich.text import Text, Span
+
+def test_infinite_loop_style():
+    print("Testing style...")
+    t = Text("hello", style="red")
+    t.append(t)
+    print("Style test done")
+
+def test_infinite_loop_spans():
+    print("Testing spans...")
+    t = Text("hello")
+    t._spans.append(Span(0, 5, "red"))
+    t.append(t)
+    print("Spans test done")
+
+if __name__ == "__main__":
+    try:
+        test_infinite_loop_style()
+        test_infinite_loop_spans()
+        print("All tests passed!")
+    except Exception as e:
+        print(f"Caught exception: {e}")
