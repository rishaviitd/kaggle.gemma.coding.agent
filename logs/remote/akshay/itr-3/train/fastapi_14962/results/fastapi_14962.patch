@@ -0,0 +1,36 @@
+
+from fastapi import FastAPI
+from fastapi.testclient import TestClient
+from pydantic import BaseModel
+from unittest.mock import patch
+
+app = FastAPI()
+
+class Item(BaseModel):
+    name: str
+    price: float
+
+@app.get("/item", response_model=Item)
+async def get_item():
+    return Item(name="Test Item", price=10.5)
+
+client = TestClient(app)
+
+def test_jsonable_encoder_called():
+    with patch("fastapi.routing.jsonable_encoder") as mock_encoder:
+        response = client.get("/item")
+        print(f"Response status: {response.status_code}")
+        if mock_encoder.called:
+            print("jsonable_encoder was called")
+        else:
+            print("jsonable_encoder was NOT called")
+            raise AssertionError("jsonable_encoder was NOT called")
+
+if __name__ == "__main__":
+    try:
+        test_jsonable_encoder_called()
+        print("Test passed!")
+    except Exception as e:
+        import traceback
+        traceback.print_exc()
+        print(f"Test failed: {e}")
