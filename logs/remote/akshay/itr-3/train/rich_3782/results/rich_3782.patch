+
+from rich.console import Console
+from rich.syntax import Syntax
+from rich.color import Color
+
+def test_padding(padding_value):
+    console = Console(width=20, force_terminal=True)
+    # Use a background style to trigger the padding behavior
+    syntax = Syntax("print('hi')", background_style="on blue", padding=padding_value)
+    
+    # Capture the output
+    with console.capture() as capture:
+        console.print(syntax)
+    
+    output = capture.get()
+    lines = output.splitlines()
+    
+    print(f"Testing padding={padding_value}")
+    print(f"Output:\n{output}")
+    print(f"Number of lines: {len(lines)}")
+    for i, line in enumerate(lines):
+        print(f"Line {i}: {repr(line)} (len {len(line)})")
+    print("-" * 20)
+
+if __name__ == "__main__":
+    test_padding(None)
+    test_padding((0, 0, 0, 0))
+    test_padding(1)
