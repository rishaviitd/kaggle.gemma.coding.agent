@@ -0,0 +1,21 @@
+from rich.console import Console, ConsoleOptions
+from rich.syntax import Syntax
+from rich.segment import Segment
+
+def test_syntax_padding_styles():
+    console = Console(width=20)
+    code = "print('hi')"
+    # Use a background color to see if padding has it
+    syntax = Syntax(code, "python", background_color="blue", padding=1)
+    
+    # Render the syntax object
+    segments = console.render(syntax)
+    
+    # We expect the segments to have the blue background style.
+    # The background color is part of the style.
+    
+    for i, segment in enumerate(segments):
+        print(f"Segment {i}: text='{segment.text}', style={segment.style}")
+
+if __name__ == "__main__":
+    test_syntax_padding_styles()
