@@ -0,0 +1,21 @@
+
+from fastapi import FastAPI
+import pytest
+from httpx import AsyncClient
+
+app = FastAPI()
+
+@app.vibe("/vibe")
+async def vibe_route():
+    return {"message": "vibe check passed"}
+
+@pytest.mark.asyncio
+async def test_vibe_route():
+    async with AsyncClient(app=app, base_url="http://test") as ac:
+        response = await ac.get("/vibe")
+        assert response.status_code == 200
+        assert response.json() == {"message": "vibe check passed"}
+
+if __name__ == "__main__":
+    import asyncio
+    asyncio.run(test_vibe_route())
