--- /dev/null
+++ b/repro_trailing.py
@@ -0,0 +1,11 @@
+from rich.markup import render
+from rich.text import Text
+
+def test_trailing_backslash():
+    s = "test\\"
+    escaped = "test\\\\" # Manually escaping the backslash
+    print(f"Render escaped + tag: {render(escaped + ' [bold]Hello[/bold]').plain!r}")
+    print(f"Render non-escaped + tag: {render(s + ' [bold]Hello[/bold]').plain!r}")
+
+if __name__ == "__main__":
+    test_trailing_backslash()
