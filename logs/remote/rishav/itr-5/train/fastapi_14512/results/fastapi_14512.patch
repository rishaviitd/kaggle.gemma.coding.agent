+from fastapi import FastAPI, Body
+from typing import Literal, Union, Annotated
+from pydantic import BaseModel, Field
+import json
+
+class Cat(BaseModel):
+    meow: bool
+    type: Literal["cat"]
+
+class Dog(BaseModel):
+    bark: bool
+    type: Literal["dog"]
+
+CatDog = Annotated[Union[Cat, Dog], Field(discriminator="type")]
+
+app = FastAPI()
+
+@app.post("/test")
+async def test(data: Annotated[CatDog, Body()]):
+    return data
+
+if __name__ == "__main__":
+    print(json.dumps(app.openapi(), indent=2))
