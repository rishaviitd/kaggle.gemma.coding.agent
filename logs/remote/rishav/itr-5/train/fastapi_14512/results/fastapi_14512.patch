@@ -0,0 +1,51 @@
+from fastapi import FastAPI, Body
+from fastapi.testclient import TestClient
+from typing import Literal, Union, Annotated
+from pydantic import BaseModel, Field
+
+class Cat(BaseModel):
+    meow: bool
+    type: Literal["cat"]
+
+class Dog(BaseModel):
+    bark: bool
+    type: Literal["dog"]
+
+CatDog = Annotated[Union[Cat, Dog], Field(discriminator="type")]
+
+app = FastAPI()
+
+@app.post("/test")
+async def test(data: Annotated[CatDog, Body()]):
+    return data
+
+client = TestClient(app)
+
+def test_cat():
+    response = client.post("/test", json={"type": "cat", "meow": True})
+    assert response.status_code == 200
+    assert response.json() == {"type": "cat", "meow": True}
+
+def test_dog():
+    response = client.post("/test", json={"type": "dog", "bark": True})
+    assert response.status_code == 200
+    assert response.json() == {"type": "dog", "bark": True}
+
+def test_invalid():
+    response = client.post("/test", json={"type": "bird", "fly": True})
+    assert response.status_code == 422
+
+if __name__ == "__main__":
+    try:
+        test_cat()
+        print("test_cat passed")
+        test_dog()
+        print("test_dog passed")
+        test_invalid()
+        print("test_invalid passed")
+        print("All tests passed!")
+    except Exception as e:
+        print(f"Test failed: {e}")
+        import traceback
+        traceback.print_exc()
+        exit(1)
