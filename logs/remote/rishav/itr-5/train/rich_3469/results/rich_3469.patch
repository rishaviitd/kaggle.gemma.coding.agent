@@ -0,0 +1,17 @@
+from rich.console import Console
+from rich.rule import Rule
+from io import StringIO
+
+def test_rule_width():
+    output = StringIO()
+    console = Console(file=output, width=20, force_terminal=True, color_system=None)
+    # Test centered rule
+    rule = Rule("Title", align="center")
+    console.print(rule)
+    line = output.getvalue().strip('\n')
+    print(f"Line: '{line}'")
+    print(f"Length: {len(line)}")
+    assert len(line) == 20
+
+if __name__ == "__main__":
+    test_rule_width()
