diff --git a/repro.py b/repro.py
new file mode 100644
index 00000000..d954ed77
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,24 @@
+from fastapi import FastAPI
+from fastapi.testclient import TestClient
+
+app = FastAPI(
+    title="Test App",
+    version="1.0.0",
+    external_docs={
+        "description": "External API docs",
+        "url": "https://fastapi.tiangolo.com/",
+    }
+)
+
+client = TestClient(app)
+
+def test_external_docs():
+    response = client.get("/openapi.json")
+    assert response.status_code == 200
+    data = response.json()
+    assert data["info"]["externalDocs"]["description"] == "External API docs"
+    assert data["info"]["externalDocs"]["url"] == "https://fastapi.tiangolo.com/"
+    print("Test passed!")
+
+if __name__ == "__main__":
+    test_external_docs()
