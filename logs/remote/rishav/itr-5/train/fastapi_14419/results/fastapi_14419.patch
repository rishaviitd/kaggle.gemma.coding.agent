diff --git a/repro.py b/repro.py
new file mode 100644
index 00000000..e3b8aa1c
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,30 @@
+
+from fastapi import FastAPI, Depends
+from fastapi.testclient import TestClient
+
+app = FastAPI()
+
+counter = 0
+
+def dep_no_scopes():
+    global counter
+    counter += 1
+    return counter
+
+@app.get("/")
+def read_root(d1=Depends(dep_no_scopes), d2=Depends(dep_no_scopes)):
+    return {"d1": d1, "d2": d2}
+
+client = TestClient(app)
+
+def test_cache_no_scopes():
+    global counter
+    counter = 0
+    response = client.get("/")
+    assert response.status_code == 200
+    data = response.json()
+    assert data["d1"] == data["d2"]
+    assert counter == 1
+
+if __name__ == "__main__":
+    test_cache_no_scopes()
diff --git a/repro_diff_scopes.py b/repro_diff_scopes.py
new file mode 100644
index 00000000..019139c6
--- /dev/null
+++ b/repro_diff_scopes.py
@@ -0,0 +1,38 @@
+
+from fastapi import FastAPI, Depends, Security
+from fastapi.security import SecurityScopes
+from fastapi.testclient import TestClient
+
+app = FastAPI()
+
+counter = 0
+
+def sub_dep(security_scopes: SecurityScopes):
+    global counter
+    counter += 1
+    return counter
+
+def dep1(sd=Security(sub_dep, scopes=["admin"])):
+    return sd
+
+def dep2(sd=Security(sub_dep, scopes=["user"])):
+    return sd
+
+@app.get("/")
+def read_root(d1=Depends(dep1), d2=Depends(dep2)):
+    return {"d1": d1, "d2": d2}
+
+client = TestClient(app)
+
+def test_cache_sub_deps_with_different_scopes():
+    global counter
+    counter = 0
+    response = client.get("/")
+    assert response.status_code == 200
+    data = response.json()
+    # d1 and d2 should be different because they have different scopes
+    assert data["d1"] != data["d2"]
+    assert counter == 2
+
+if __name__ == "__main__":
+    test_cache_sub_deps_with_different_scopes()
