+import requests
+from requests.utils import should_bypass_proxies
+
+def test_no_proxy_behavior():
+    test_cases = [
+        ("example.com", "http://example.com", True),
+        ("example.com", "http://sub.example.com", True),
+        ("example.com", "http://myexample.com", False),
+        ("example.com", "http://example.com:8080", True),
+        ("example.com", "http://sub.example.com:8080", True),
+        ("example.com", "http://myexample.com:8080", False),
+    ]
+    
+    for no_proxy, url, expected in test_cases:
+        result = should_bypass_proxies(url, no_proxy=no_proxy)
+        print(f"no_proxy={no_proxy}, url={url}, expected={expected}, result={result}")
+        assert result == expected
+    print("All tests passed!")
+
+if __name__ == "__main__":
+    test_no_proxy_behavior()
