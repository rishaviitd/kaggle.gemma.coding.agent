+
+import inspect
+from typing import TYPE_CHECKING, ForwardRef
+
+if TYPE_CHECKING:
+    class User:
+        pass
+
+def get_user(user: "User"):
+    return user
+
+try:
+    print("Trying inspect.signature(get_user, eval_str=True)")
+    sig = inspect.signature(get_user, eval_str=True)
+    print("Success!")
+    print(f"Annotation: {sig.parameters['user'].annotation}")
+except Exception as e:
+    print(f"Failed: {e}")
+
+try:
+    print("\nTrying inspect.signature(get_user, eval_str=False)")
+    sig = inspect.signature(get_user, eval_str=False)
+    print("Success!")
+    print(f"Annotation: {sig.parameters['user'].annotation}")
+except Exception as e:
+    print(f"Failed: {e}")
