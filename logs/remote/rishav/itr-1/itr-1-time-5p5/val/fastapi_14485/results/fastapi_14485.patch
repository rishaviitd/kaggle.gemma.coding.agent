diff --git a/repro_return.py b/repro_return.py
new file mode 100644
index 00000000..ea6b71f2
--- /dev/null
+++ b/repro_return.py
@@ -0,0 +1,25 @@
+
+import inspect
+from typing import TYPE_CHECKING, ForwardRef
+
+if TYPE_CHECKING:
+    class User:
+        pass
+
+def get_user() -> "User":
+    return None
+
+def get_typed_return_annotation(call):
+    # Simulating the current FastAPI implementation
+    if True: # simulating sys.version_info >= (3, 10)
+        try:
+            signature = inspect.signature(call, eval_str=True)
+        except NameError as e:
+            print(f"Caught expected NameError: {e}")
+            return None
+    else:
+        signature = inspect.signature(call)
+    
+    return signature.return_annotation
+
+print(f"Return annotation: {get_typed_return_annotation(get_user)}")
