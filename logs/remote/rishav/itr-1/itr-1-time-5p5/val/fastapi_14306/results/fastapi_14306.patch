+# Cache for endpoint context
+_endpoint_context_cache: Dict[Callable[..., Any], str] = {}
+
+
+def get_endpoint_context(call: Callable[..., Any], methods: Sequence[str], path: str) -> str:
+    if call in _endpoint_context_cache:
+        return _endpoint_context_cache[call]
+
+    try:
+        unwrapped = inspect.unwrap(call)
+        file = inspect.getfile(unwrapped)
+        line = inspect.getlineno(unwrapped)
+        name = unwrapped.__name__
+        method = methods[0] if methods else "UNKNOWN"
+        context = f"File {file}, line {line}, in {name}\n    {method} {path}"
+    except Exception:
+        context = ""
+
+    _endpoint_context_cache[call] = context
+    return context
+
 
