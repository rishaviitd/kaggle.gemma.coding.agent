diff --git a/repro_scopes.py b/repro_scopes.py
new file mode 100644
index 00000000..f320e0fc
--- /dev/null
+++ b/repro_scopes.py
@@ -0,0 +1,44 @@
+import asyncio
+from fastapi import FastAPI, Depends, Security, Request
+from fastapi.dependencies.utils import SecurityScopes
+from fastapi.testclient import TestClient
+
+app = FastAPI()
+
+# We use a global to capture scopes since we can't easily return them from deep dependencies
+captured_scopes = {}
+
+async def dep_1(security_scopes: SecurityScopes):
+    captured_scopes["dep_1"] = security_scopes.scopes
+    return "dep_1"
+
+async def dep_2(security_scopes: SecurityScopes, d1 = Depends(dep_1)):
+    captured_scopes["dep_2"] = security_scopes.scopes
+    return "dep_2"
+
+@app.get("/")
+async def root(d2 = Security(dep_2, scopes=["scope2"])):
+    return d2
+
+client = TestClient(app)
+
+def test_security_scopes_propagation():
+    global captured_scopes
+    captured_scopes = {}
+    
+    response = client.get("/")
+    
+    print(f"Captured scopes: {captured_scopes}")
+    
+    assert captured_scopes["dep_2"] == ["scope2"]
+    assert captured_scopes["dep_1"] == ["scope2"]
+
+if __name__ == "__main__":
+    try:
+        test_security_scopes_propagation()
+        print("Test passed!")
+    except Exception as e:
+        print(f"Test failed: {e}")
+        import traceback
+        traceback.print_exc()
+        exit(1)
