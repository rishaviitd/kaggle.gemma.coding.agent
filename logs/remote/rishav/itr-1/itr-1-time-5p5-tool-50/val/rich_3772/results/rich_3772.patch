@@ -0,0 +1,18 @@
+
+from rich.traceback import install
+import sys
+
+install(show_locals=True)
+
+class BadRepr:
+    def __repr__(self):
+        raise RuntimeError("Fail!")
+
+def fail():
+    x = BadRepr()
+    raise ValueError("Original Error")
+
+try:
+    fail()
+except Exception:
+    sys.excepthook(*sys.exc_info())
