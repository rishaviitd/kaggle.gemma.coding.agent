     return not (current_status_code < 200 or current_status_code in {204, 205, 304})
 
 
+_ENDPOINT_CONTEXT_CACHE: Dict[Callable, str] = {}
+
+
+def get_endpoint_context(call: Callable, method: str, path: str) -> str:
+    if call in _ENDPOINT_CONTEXT_CACHE:
+        return _ENDPOINT_CONTEXT_CACHE[call]
+    try:
+        source_file = inspect.getsourcefile(call)
+        if source_file:
+            lines, start_line = inspect.getsourcelines(call)
+            context = f"File {source_file}, line {start_line}, in {call.__name__}\n    {method} {path}"
+            _ENDPOINT_CONTEXT_CACHE[call] = context
+            return context
+    except Exception:
+        pass
+    return ""
+
+
 def get_path_param_names(path: str) -> Set[str]:
     return set(re.findall("{(.*?)}", path))
 
