+++ b/repro_none.py
@@ -0,0 +1,20 @@
+from rich.console import Console, ConsoleDimensions, ConsoleOptions
+from rich.padding import Padding
+
+options = ConsoleOptions(
+    size=ConsoleDimensions(80, 25),
+    legacy_windows=False,
+    min_width=1,
+    max_width=None,
+    is_terminal=False,
+    encoding="utf-8",
+    max_height=25,
+)
+console = Console()
+try:
+    # This should fail if max_width is None and expand=True
+    list(Padding("Hello", expand=True).__rich_console__(console, options))
+except Exception as e:
+    print(f"Caught expected exception: {e}")
+except Exception as e:
+    print(f"Caught exception: {e}")
