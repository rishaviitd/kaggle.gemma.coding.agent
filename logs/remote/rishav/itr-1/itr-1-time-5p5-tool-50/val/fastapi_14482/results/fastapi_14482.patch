new file mode 100644
index 00000000..58ac1397
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,25 @@
+from fastapi import FastAPI, Body
+from pydantic import BaseModel, ConfigDict
+from fastapi.testclient import TestClient
+
+class MyType:
+    pass
+
+app = FastAPI()
+
+@app.post("/multiple")
+def multiple(foo: MyType, other: int = Body(...)):
+    return {"foo": foo, "other": other}
+
+client = TestClient(app)
+
+def test_multiple():
+    print("Testing multiple body parameters with arbitrary type...")
+    try:
+        response = client.post("/multiple", json={"foo": "some value", "other": 1})
+        print(f"Response: {response.status_code}, {response.json()}")
+    except Exception as e:
+        print(f"Error: {e}")
+
+if __name__ == "__main__":
+    test_multiple()
