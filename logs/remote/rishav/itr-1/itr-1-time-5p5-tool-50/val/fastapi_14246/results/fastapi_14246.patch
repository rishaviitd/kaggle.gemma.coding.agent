+from fastapi import FastAPI, Body
+from pydantic import BaseModel
+from fastapi.openapi.utils import get_openapi
+import json
+
+class NestedModel(BaseModel):
+    name: str
+
+class MainModel(BaseModel):
+    item: NestedModel
+    description: str
+
+app = FastAPI()
+
+@app.post("/test", response_model=MainModel)
+def test_endpoint(item: MainModel = Body(...)):
+    return item
+
+# We want to test separate_input_output_schemas=True
+openapi_schema = get_openapi(
+    title=app.title,
+    version=app.version,
+    openapi_version=app.openapi_version,
+    description=app.description,
+    routes=app.routes,
+    separate_input_output_schemas=True
+)
+
+print(json.dumps(openapi_schema, indent=2))
+
+# Verification logic
+schemas = openapi_schema.get("components", {}).get("schemas", {})
+print("\nSchemas found:", list(schemas.keys()))
+
+# If separate_input_output_schemas=True, we expect different schemas for input and output
+# for both MainModel and NestedModel.
+# Typically, they might be named something like 'MainModel' and 'MainModel_Response'
+# or they might just be different entries if the naming logic differs.
+# Let's see what's actually produced.
