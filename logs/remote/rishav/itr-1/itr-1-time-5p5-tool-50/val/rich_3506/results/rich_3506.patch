@@ -0,0 +1,20 @@
+from rich.segment import Segment
+from rich.cells import cell_len
+
+def test_split_cells():
+    # Wide character: 😊 is 2 cells
+    text = "A😊B"
+    segment = Segment(text)
+    print(f"Text: {text}, Cell length: {segment.cell_length}")
+    
+    cut = 2
+    before, after = segment._split_cells(segment, cut)
+    print(f"Cut at {cut}: before='{before.text}', after='{after.text}'")
+    
+    # Expected: maybe ('A😊', 'B') or ('A', '😊B')
+    # Current: ('A ', ' B')
+    
+    assert before.text != "A " or after.text != " B", "It replaced the wide character with spaces!"
+
+if __name__ == "__main__":
+    test_split_cells()
