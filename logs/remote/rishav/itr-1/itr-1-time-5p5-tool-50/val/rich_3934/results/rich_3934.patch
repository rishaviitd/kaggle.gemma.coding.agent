@@ -0,0 +1,31 @@
+from rich.live import Live
+from rich.table import Table
+import time
+
+def make_table(rows):
+    table = Table(title="Test Table")
+    table.add_column("Col")
+    for row in rows:
+        table.add_row(row)
+    return table
+
+# 1. Initial render
+rows1 = ["Row 1", "Row 2", "Row 3", "Row 4"]
+table1 = make_table(rows1)
+
+# 2. Empty render
+table2 = Table(title="Empty Table")
+table2.add_column("Col")
+
+# 3. Final render
+rows3 = ["Final Row"]
+table3 = make_table(rows3)
+
+with Live(table1, refresh_per_second=4) as live:
+    time.sleep(0.1)
+    live.update(table2)
+    time.sleep(0.1)
+    live.update(table3)
+    time.sleep(0.1)
+
+print("--- After Live ---")
