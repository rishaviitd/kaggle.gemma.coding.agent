@@ -0,0 +1,27 @@
+from fastapi import FastAPI, Depends, Security
+from fastapi.security import OAuth2PasswordBearer
+from fastapi.openapi.utils import get_openapi
+import json
+
+app = FastAPI()
+oauth2_scheme = OAuth2PasswordBearer(tokenUrl="token")
+
+async def dep_no_scopes():
+    return await oauth2_scheme()
+
+async def dep_with_scopes(token: str = Security(oauth2_scheme, scopes=["me"])):
+    return token
+
+async def parent_dep(token: str = Security(oauth2_scheme, scopes=["me"]), sub=Depends(dep_no_scopes)):
+    return token
+
+@app.get("/path1")
+async def path1(dep=Depends(parent_dep)):
+    return {"message": "path1"}
+
+@app.get("/path2")
+async def path2(dep=Depends(dep_no_scopes)):
+    return {"message": "path2"}
+
+openapi_schema = app.openapi()
+print(json.dumps(openapi_schema, indent=2))
