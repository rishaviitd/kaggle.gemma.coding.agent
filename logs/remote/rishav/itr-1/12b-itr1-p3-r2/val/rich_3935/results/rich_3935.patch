+from rich.console import Console, ConsoleOptions, ConsoleDimensions
+from rich.padding import Padding
+from rich.style import Style
+
+def test_padding_overflow():
+    # max_width = 3
+    # left = 2, right = 2
+    # width - left - right = 3 - 2 - 2 = -1
+    # update_width(-1) -> max_width = 0
+    # content width = 0
+    # total width = 2 + 0 + 2 = 4
+    # 4 > 3, so it overflows.
+    
+    options = ConsoleOptions(
+        ConsoleDimensions(100, 100),
+        max_height=100,
+        legacy_windows=False,
+        min_width=0,
+        max_width=3,
+        is_terminal=False,
+        encoding="utf-8",
+    )
+    
+    console = Console(options=options)
+    console.begin_capture()
+    console.print(Padding("foo", 2, 2))
+    output = console.end_capture()
+    
+    # If it fits in 3, the output should be 3 characters wide.
+    # But it's 4 characters wide.
+    print(f"Output: {output}")
+    assert len(output.rstrip()) <= 3
+
+if __name__ == "__main__":
+    test_padding_overflow()
