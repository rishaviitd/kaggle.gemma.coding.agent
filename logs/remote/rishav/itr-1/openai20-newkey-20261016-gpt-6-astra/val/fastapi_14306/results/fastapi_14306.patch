+    def __str__(self) -> str:
+        count = len(self._errors)
+        message = f"{count} validation error{'s' if count != 1 else ''}:\n"
+        for err in self._errors:
+            message += f"  {err}\n"
+        context = self.endpoint_context
+        if context:
+            message += "\n"
+            if context.get("file") and context.get("line"):
+                message += f'  File "{context["file"]}", line {context["line"]}'
+                if context.get("function"):
+                    message += f', in {context["function"]}'
+                message += "\n"
+            elif context.get("function"):
+                message += f'  Endpoint: {context["function"]}\n'
+            if context.get("path"):
+                method = context.get("method", "")
+                message += f'    {method} {context["path"]}\n'
+        return message
+
 
