+def _get_endpoint_context(endpoint: Optional[Callable[..., Any]]) -> Dict[str, Any]:
+    """Extract source information once, when the endpoint handler is built."""
+    if endpoint is None:
+        return {}
+    try:
+        endpoint = inspect.unwrap(endpoint)
+        if isinstance(endpoint, functools.partial):
+            endpoint = endpoint.func
+        if not inspect.isfunction(endpoint) and not inspect.ismethod(endpoint):
+            endpoint = endpoint.__call__
+        code = endpoint.__code__
+        return {
+            "file": code.co_filename,
+            "line": code.co_firstlineno,
+            "function": endpoint.__name__,
+        }
+    except (AttributeError, TypeError, ValueError):
+        return {}
+
+
+def _endpoint_context(source: Dict[str, Any], scope: Scope) -> Dict[str, Any]:
+    route = scope.get("route")
+    if route is None:
+        return source
+    return {
+        **source,
+        "path": route.path,
+        "method": scope.get("method", "WS"),
+    }
+
