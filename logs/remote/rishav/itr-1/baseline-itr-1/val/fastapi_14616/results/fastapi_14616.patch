+from typing import Annotated
+from pydantic import BaseModel, Field, Json
+from fastapi._compat.v2 import ModelField
+from fastapi.params import Form
+
+class MyModel(BaseModel):
+    tags: Annotated[Json[list[str]], Form()]
+
+# Simulate how FastAPI creates ModelField
+# In FastAPI, ModelField is created from FieldInfo
+field_info = MyModel.model_fields['tags']
+model_field = ModelField(field_info=field_info, name='tags')
+
+print(f"Field info: {field_info}")
+print(f"Metadata: {field_info.metadata}")
+print(f"Annotation: {field_info.annotation}")
+
+from fastapi._compat.v2 import is_sequence_field
+print(f"is_sequence_field: {is_sequence_field(model_field)}")
diff --git a/repro_v2.py b/repro_v2.py
new file mode 100644
