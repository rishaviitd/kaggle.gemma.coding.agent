+from rich.table import Table
+from rich.console import Console
+
+console = Console()
+
+# Test Table.grid as a class method
+try:
+    table = Table.grid(expand=True)
+    print("Table.grid() worked")
+except Exception as e:
+    print(f"Table.grid() failed: {e}")
+
+# Test Table.grid as an instance method
+try:
+    t = Table()
+    table = t.grid(expand=True)
+    print("t.grid() worked")
+except Exception as e:
+    print(f"t.grid() failed: {e}")
