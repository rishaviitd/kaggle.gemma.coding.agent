+from rich.console import Console, ConsoleOptions, ConsoleDimensions
+from rich.padding import Padding
+
+def test_padding_empty():
+    console = Console(width=10, color_system=None)
+    padding = Padding("", (1, 1, 1, 1), expand=False)
+    
+    options = ConsoleOptions(
+        ConsoleDimensions(10, 25),
+        max_height=25,
+        legacy_windows=False,
+        min_width=0,
+        max_width=10,
+        is_terminal=False,
+        encoding="utf-8",
+    )
+    
+    result = list(padding.__rich_console__(console, options))
+    print(f"Result length: {len(result)}")
+    for i, segment in enumerate(result):
+        print(f"Segment {i}: {repr(segment)}")
+
+if __name__ == "__main__":
+    test_padding_empty()
