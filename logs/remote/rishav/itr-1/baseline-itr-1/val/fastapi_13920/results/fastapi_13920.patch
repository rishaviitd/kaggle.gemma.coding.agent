+def is_typealiastype(tp: Any) -> bool:
+    try:
+        from typing import TypeAliasType
+        return isinstance(tp, TypeAliasType)
+    except ImportError:
+        return False
+
+
+def unwrap_type_alias(annotation: Any) -> Any:
+    while is_typealiastype(annotation):
+        annotation = annotation.__value__
+    return annotation
