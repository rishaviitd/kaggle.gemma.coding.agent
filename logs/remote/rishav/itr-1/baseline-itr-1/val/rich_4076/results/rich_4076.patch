diff --git a/repro_newlines.py b/repro_newlines.py
new file mode 100644
index 00000000..da0e37c9
--- /dev/null
+++ b/repro_newlines.py
@@ -0,0 +1,18 @@
+from rich.text import Text
+
+text = Text("Line 1\n\nLine 3")
+print(f"Original: {repr(text.plain)}")
+lines = text.split()
+print(f"Split (default): {lines}")
+for i, line in enumerate(lines):
+    print(f"Line {i}: {repr(line.plain)}")
+
+lines_allow_blank = text.split(allow_blank=True)
+print(f"Split (allow_blank=True): {lines_allow_blank}")
+for i, line in enumerate(lines_allow_blank):
+    print(f"Line {i}: {repr(line.plain)}")
+
+fit_lines = text.fit(10)
+print(f"Fit lines: {fit_lines}")
+for i, line in enumerate(fit_lines):
+    print(f"Fit Line {i}: {repr(line.plain)}")
