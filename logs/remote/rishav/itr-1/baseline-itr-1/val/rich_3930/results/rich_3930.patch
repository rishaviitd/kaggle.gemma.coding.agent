+        if get_character_cell_size(char) > 0 and text[i - 1] != "\u200d":
+            graphemes.append(current_grapheme)
+            current_grapheme = char
+        else:
+            current_grapheme += char
+
+    graphemes.append(current_grapheme)
+    return graphemes
