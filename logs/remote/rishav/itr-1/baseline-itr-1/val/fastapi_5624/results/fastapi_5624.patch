--- /dev/null
+++ b/repro.py
@@ -0,0 +1,35 @@
+
+from fastapi import FastAPI, Depends, Security
+from fastapi.security import OAuth2PasswordBearer
+from fastapi.dependencies.utils import SecurityScopes
+from fastapi.testclient import TestClient
+
+auth_scheme = OAuth2PasswordBearer(tokenUrl="token")
+
+async def dep_c(security_scopes: SecurityScopes):
+    return f"c:{security_scopes.scopes}"
+
+async def dep_b(security_scopes: SecurityScopes, _ = Security(dep_c, scopes=["scope_b"])):
+    return f"b:{security_scopes.scopes}"
+
+async def dep_a(security_scopes: SecurityScopes, _ = Security(dep_b, scopes=["scope_a"])):
+    return f"a:{security_scopes.scopes}"
+
+app = FastAPI()
+
+@app.get("/")
+async def root(res = Security(dep_a, scopes=["root_scope"])):
+    return res
+
+def test_security_scopes_propagation():
+    with TestClient(app) as client:
+        response = client.get("/")
+        print(f"Response: {response.json()}")
+        # dep_a should have ["root_scope"]
+        # dep_b should have ["root_scope", "scope_a"]
+        # dep_c should have ["root_scope", "scope_a", "scope_b"]
+        # root returns dep_a's return value, which is "a:['root_scope']"
+        assert response.json() == "a:['root_scope']"
+
+if __name__ == "__main__":
+    test_security_scopes_propagation()
