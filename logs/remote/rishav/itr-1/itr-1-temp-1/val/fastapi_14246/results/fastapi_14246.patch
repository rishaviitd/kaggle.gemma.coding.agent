+    name: str
+
+class ItemRequest(BaseModel):
+    sub_item: SubItem
+
+class ItemResponse(BaseModel):
+    sub_item: SubItem
+    id: int
+
+app = FastAPI(separate_input_output_schemas=True)
+
+@app.post("/items/", response_model=ItemResponse)
+def create_item(item: ItemRequest):
+    return {"sub_item": item.sub_item, "id": 1}
+
+openapi_schema = get_openapi(app, app.openapi_url)
+print(openapi_schema["components"]["schemas"].keys())
