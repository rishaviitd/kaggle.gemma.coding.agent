@@ -0,0 +1,31 @@
+from fastapi import FastAPI, UploadFile, File
+from fastapi.testclient import TestClient
+
+app = FastAPI()
+
+@app.post("/upload")
+async def upload_file(file: UploadFile = File()):
+    return {"filename": file.filename}
+
+client = TestClient(app)
+
+def test_openapi_schema():
+    response = client.get("/openapi.json")
+    schema = response.json()
+    
+    # Find the upload_file operation
+    paths = schema.get("paths", {})
+    upload_path = paths.get("/upload", {}).get("post", {})
+    request_body = upload_path.get("requestBody", {})
+    content = request_body.get("content", {})
+    multipart = content.get("multipart/form-data", {})
+    properties = multipart.get("schema", {}).get("properties", {})
+    file_schema = properties.get("file", {})
+    
+    print(f"File schema: {file_schema}")
+    assert file_schema.get("contentMediaType") == "application/octet-stream"
+    assert "format" not in file_schema
+
+if __name__ == "__main__":
+    test_openapi_schema()
+    print("Test passed!")
