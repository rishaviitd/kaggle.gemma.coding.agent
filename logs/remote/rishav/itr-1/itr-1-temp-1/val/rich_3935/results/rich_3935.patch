new file mode 100644
index 00000000..79269c2c
--- /dev/null
+++ b/repro_none.py
@@ -0,0 +1,33 @@
+from rich.console import Console, ConsoleOptions
+from rich.padding import Padding
+
+console = Console()
+options = ConsoleOptions(
+    max_height=10,
+    size=console.size,
+    legacy_windows=console.legacy_windows,
+    min_width=1,
+    max_width=None, # SET TO NONE
+    encoding=console.encoding,
+    is_terminal=console.is_terminal,
+)
+
+# Case 1: expand=True
+try:
+    # We use console.render_lines or similar because console.print creates its own options
+    # Actually we can just call __rich_console__ directly
+    padding = Padding("Hello", (1, 1, 1, 1), expand=True)
+    for segment in padding.__rich_console__(console, options):
+        print(segment)
+    print("Case 1 passed")
+except Exception as e:
+    print(f"Case 1 failed: {e}")
+
+# Case 2: expand=False
+try:
+    padding = Padding("Hello", (1, 1, 1, 1), expand=False)
+    for segment in padding.__rich_console__(console, options):
+        print(segment)
+    print("Case 2 passed")
+except Exception as e:
+    print(f"Case 2 failed: {e}")
