@@ -0,0 +1,49 @@
+
+from typing import Annotated, Union, Literal
+from fastapi import FastAPI, Body
+from pydantic import BaseModel, Field
+from fastapi.params import Discriminator
+
+app = FastAPI()
+
+class Item1(BaseModel):
+    type: Literal["type1"]
+    name: str
+
+class Item2(BaseModel):
+    type: Literal["type2"]
+    age: int
+
+def discriminator_func(v):
+    return v.get("type")
+
+# This is the problematic type
+ComplexType = Annotated[
+    Union[Annotated[Item1, "Tag1"], Annotated[Item2, "Tag2"]], 
+    Discriminator(discriminator_func)
+]
+
+@app.post("/test")
+async def test_endpoint(item: ComplexType):
+    return item
+
+if __name__ == "__main__":
+    import inspect
+    from fastapi.routing import APIRoute
+    
+    # Get the route
+    route = next(r for r in app.routes if r.path == "/test")
+    
+    # Check the parameters
+    for param in route.dependant.body_params:
+        print(f"Body param: {param.name}, model: {param.model}")
+    
+    for param in route.dependant.query_params:
+        print(f"Query param: {param.name}, model: {param.model}")
+
+    if any(p.name == "item" for p in route.dependant.query_params):
+        print("BUG: 'item' is treated as a query parameter")
+    elif any(p.name == "item" for p in route.dependant.body_params):
+        print("SUCCESS: 'item' is treated as a body parameter")
+    else:
+        print("NOT FOUND: 'item' is neither body nor query")
