+from rich.traceback import install
+import sys
+
+class CyclicGroup(ExceptionGroup):
+    def __init__(self, message, exceptions):
+        super().__init__(message, exceptions)
+        self._cycle = True
+
+    @property
+    def exceptions(self):
+        return (self,) # Cycle!
+
+install()
+
+# Create a dummy exception to satisfy the non-empty requirement
+dummy = RuntimeError("dummy")
+raise CyclicGroup("cycle", [dummy])
