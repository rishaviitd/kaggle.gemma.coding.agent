+def _create_lifespan_from_handlers(
+    startup_handlers: Sequence[Callable],
+    shutdown_handlers: Sequence[Callable],
+) -> Lifespan[Any]:
+    @asynccontextmanager
+    async def lifespan(app: AppType) -> AsyncIterator[None]:
+        for handler in startup_handlers:
+            if is_async_callable(handler):
+                await handler(app)
+            else:
+                await run_in_threadpool(handler, app)
+        try:
+            yield None
+        finally:
+            for handler in reversed(shutdown_handlers):
+                if is_async_callable(handler):
+                    await handler(app)
+                else:
+                    await run_in_threadpool(handler, app)
+
+    return lifespan
+
