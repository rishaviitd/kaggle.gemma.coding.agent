@@ -0,0 +1,15 @@
+from rich.console import Console
+from rich.color import Color
+
+console = Console(width=20, force_terminal=True)
+text = "[red on blue]This is a very long line that should be soft wrapped by the terminal and maintain its background color[/]"
+
+print("--- soft_wrap=True ---")
+with console.capture() as capture:
+    console.print(text, soft_wrap=True)
+print(repr(capture.get()))
+
+print("\n--- soft_wrap=False ---")
+with console.capture() as capture:
+    console.print(text, soft_wrap=False)
+print(repr(capture.get()))
