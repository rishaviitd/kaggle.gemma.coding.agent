+from rich.text import Text
+from rich.console import Console
+
+console = Console(force_terminal=True)
+
+text = Text("Hello\tWorld", style="white")
+text.stylize("red", 0, 6) # "Hello\t" should be red
+text.expand_tabs(8)
+
+print(f"Text: {text.plain}")
+print(f"Spans: {text._spans}")
+
+expected_span = (0, 8, "red")
+if any(s == expected_span for s in text._spans):
+    print("SUCCESS")
+else:
+    print("FAILURE")
