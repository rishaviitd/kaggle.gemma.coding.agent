+def iter_graphemes(text: str) -> Generator[str, None, None]:
+    """Iterate over the graphemes in a string.
+
+    A grapheme is defined as a character with a non-zero width followed by
+    any number of zero-width characters.
+    """
+    if not text:
+        return
+
+    grapheme = []
+    for char in text:
+        if get_character_cell_size(char) == 0:
+            grapheme.append(char)
+        else:
+            if grapheme:
+                yield "".join(grapheme)
+            grapheme = [char]
+    if grapheme:
+        yield "".join(grapheme)
+
