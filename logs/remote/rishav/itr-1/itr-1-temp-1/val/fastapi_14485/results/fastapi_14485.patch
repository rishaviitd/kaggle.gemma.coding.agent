diff --git a/repro.py b/repro.py
new file mode 100644
index 00000000..b757cbe7
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,29 @@
+
+import inspect
+from typing import TYPE_CHECKING, ForwardRef
+from fastapi import FastAPI, Depends
+from fastapi.dependencies.utils import get_typed_annotation
+
+# Simulate the environment
+if TYPE_CHECKING:
+    class User:
+        pass
+
+def get_current_user(user: "User"):
+    return user
+
+def test_resolution():
+    # This is what fastapi/dependencies/utils.py does
+    globalns = get_current_user.__globals__
+    annotation = get_current_user.__annotations__["user"]
+    
+    print(f"Annotation: {annotation}, Type: {type(annotation)}")
+    
+    try:
+        resolved = get_typed_annotation(annotation, globalns)
+        print(f"Resolved: {resolved}")
+    except Exception as e:
+        print(f"Error resolving: {e}")
+
+if __name__ == "__main__":
+    test_resolution()
