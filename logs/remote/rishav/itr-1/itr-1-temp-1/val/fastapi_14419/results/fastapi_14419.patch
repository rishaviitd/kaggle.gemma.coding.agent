+from fastapi import FastAPI, Depends, Security
+from fastapi.security.oauth2 import SecurityScopes
+from fastapi.testclient import TestClient
+import pytest
+
+app = FastAPI()
+
+# This dependency depends on the scopes
+def dep_b(scopes: SecurityScopes):
+    return list(scopes.scopes)
+
+# This dependency depends on dep_b with some scopes, but doesn't have scopes itself
+def dep_a(b = Security(dep_b, scopes=["scope_a"])):
+    return b
+
+# This dependency depends on dep_a
+def dep_c(a = Depends(dep_a)):
+    return a
+
+@app.get("/")
+async def root(
+    c1 = Security(dep_c, scopes=["scope1"]), 
+    c2 = Security(dep_c, scopes=["scope2"])
+):
+    return {"c1": c1, "c2": c2}
+
+client = TestClient(app)
+
+def test_dependency_cache_bug():
+    response = client.get("/")
+    print(f"Response: {response.json()}")
+    assert response.status_code == 200
+    data = response.json()
+    # c1 should be ["scope1", "scope_a"]
+    # c2 should be ["scope2", "scope_a"]
+    assert data["c1"] == ["scope1", "scope_a"]
+    assert data["c2"] == ["scope2", "scope_a"]
+
+if __name__ == "__main__":
+    test_dependency_cache_bug()
