+from rich.console import Console
+from rich.padding import Padding
+from rich.measure import Measurement
+from rich.text import Text
+
+def test_padding_measurement():
+    console = Console()
+    
+    # Case 1: max_width=10, extra_width=4, content_width=4
+    # Expected: 8
+    options1 = console.options.update(max_width=10)
+    padding1 = Padding(Text("text"), pad=(0, 4, 0, 0))
+    m1 = padding1.__rich_measure__(console, options1)
+    print(f"Case 1: max_width=10, extra_width=4, content_width=4, result={m1.maximum}")
+
+    # Case 2: max_width=5, extra_width=4, content_width=4
+    # Expected: 5
+    options2 = console.options.update(max_width=5)
+    padding2 = Padding(Text("text"), pad=(0, 4, 0, 0))
+    m2 = padding2.__rich_measure__(console, options2)
+    print(f"Case 2: max_width=5, extra_width=4, content_width=4, result={m2.maximum}")
+
+    # Case 3: max_width=5, extra_width=6, content_width=4
+    # Expected: 5
+    options3 = console.options.update(max_width=5)
+    padding3 = Padding(Text("text"), pad=(0, 6, 0, 0))
+    m3 = padding3.__rich_measure__(console, options3)
+    print(f"Case 3: max_width=5, extra_width=6, content_width=4, result={m3.maximum}")
+
+    # Case 4: max_width=5, extra_width=4, content_width=1
+    # Expected: 5
+    options4 = console.options.update(max_width=5)
+    padding4 = Padding(Text("a"), pad=(0, 4, 0, 0))
+    m4 = padding4.__rich_measure__(console, options4)
+    print(f"Case 4: max_width=5, extra_width=4, content_width=1, result={m4.maximum}")
+
+    # Case 5: max_width=5, extra_width=4, content_width=0
+    # Expected: 4
+    options5 = console.options.update(max_width=5)
+    padding5 = Padding(Text(""), pad=(0, 4, 0, 0))
+    m5 = padding5.__rich_measure__(console, options5)
+    print(f"Case 5: max_width=5, extra_width=4, content_width=0, result={m5.maximum}")
+
+if __name__ == "__main__":
+    test_padding_measurement()
