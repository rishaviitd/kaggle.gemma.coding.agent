@@ -0,0 +1,28 @@
+import requests
+import os
+
+def test_no_proxy_behavior(url, no_proxy):
+    os.environ["no_proxy"] = no_proxy
+    try:
+        from requests.utils import should_bypass_proxies
+        bypass = should_bypass_proxies(url, no_proxy)
+        print(f"URL: {url}, no_proxy: {no_proxy}, bypass: {bypass}")
+    finally:
+        if "no_proxy" in os.environ:
+            del os.environ["no_proxy"]
+
+if __name__ == "__main__":
+    # Case 1: Exact match
+    test_no_proxy_behavior("http://example.com", "example.com")
+    
+    # Case 2: Subdomain match
+    test_no_proxy_behavior("http://sub.example.com", "example.com")
+    
+    # Case 3: Incorrect match (the bug)
+    test_no_proxy_behavior("http://myexample.com", "example.com")
+    
+    # Case 4: Host with port
+    test_no_proxy_behavior("http://example.com:8080", "example.com")
+    
+    # Case 5: Subdomain with port
+    test_no_proxy_behavior("http://sub.example.com:8080", "example.com")
