@@ -0,0 +1,28 @@
+
+from fastapi import FastAPI
+from pydantic import BaseModel
+from typing import List
+import json
+
+class Item(BaseModel):
+    name: str
+    description: str
+
+class User(BaseModel):
+    username: str
+    items: List[Item]
+
+app = FastAPI()
+
+@app.get("/user", response_model=User)
+def get_user():
+    return {"username": "test", "items": [{"name": "item1", "description": "desc1"}]}
+
+openapi_schema = app.openapi()
+schemas = openapi_schema.get("components", {}).get("schemas", {})
+print(f"Schemas: {list(schemas.keys())}")
+
+if "Item-Input" in schemas and "Item-Output" in schemas:
+    print("SUCCESS: Item is separated into Input and Output")
+else:
+    print("FAILURE: Item is not separated into Input and Output")
