+from typing import Any, Literal, Annotated
+from pydantic import BaseModel
+from fastapi import FastAPI, Body
+from fastapi.testclient import TestClient
+
+class Pie(BaseModel):
+    time_to_cook: int
+    num_ingredients: int
+
+class ApplePie(Pie):
+    fruit: Literal["apple"] = "apple"
+
+class PumpkinPie(Pie):
+    filling: Literal["pumpkin"] = "pumpkin"
+
+def get_discriminator_value(v: Any) -> str:
+    if isinstance(v, dict):
+        return v.get("fruit", v.get("filling"))
+    return getattr(v, "fruit", getattr(v, "filling", None))
+
+# This is the problematic type
+from pydantic import Discriminator, Tag
+
+Dessert = Annotated[
+    Annotated[ApplePie, Tag("apple")] | Annotated[PumpkinPie, Tag("pumpkin")],
+    Discriminator(get_discriminator_value),
+]
+
+app = FastAPI()
+
+@app.post("/dessert")
+async def dinner(dessert: Dessert) -> dict[str, Any]:
+    return dessert.model_dump()
+
+client = TestClient(app)
+
+def test_dessert_body():
+    # Test ApplePie
+    response = client.post("/dessert", json={"time_to_cook": 10, "num_ingredients": 5, "fruit": "apple"})
+    print(f"Status: {response.status_code}, Body: {response.json()}")
+    assert response.status_code == 200
+    assert response.json() == {"time_to_cook": 10, "num_ingredients": 5, "fruit": "apple"}
+
+    # Test PumpkinPie
+    response = client.post("/dessert", json={"time_to_cook": 20, "num_ingredients": 3, "filling": "pumpkin"})
+    assert response.status_code == 200
+    assert response.json() == {"time_to_cook": 20, "num_ingredients": 3, "filling": "pumpkin"}
+
+if __name__ == "__main__":
+    try:
+        test_dessert_body()
+        print("Test passed!")
+    except Exception as e:
+        print(f"Test failed: {e}")
+        import traceback
+        traceback.print_exc()
+        exit(1)
