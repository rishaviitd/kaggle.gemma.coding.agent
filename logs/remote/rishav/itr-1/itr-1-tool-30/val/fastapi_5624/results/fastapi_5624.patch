diff --git a/repro_security_scopes.py b/repro_security_scopes.py
new file mode 100644
index 00000000..ccaf3b0c
--- /dev/null
+++ b/repro_security_scopes.py
@@ -0,0 +1,46 @@
+
+from fastapi import FastAPI, Depends, Security
+from fastapi.dependencies.utils import get_dependant
+from fastapi.security import OAuth2PasswordBearer
+
+oauth2_scheme = OAuth2PasswordBearer(tokenUrl="token")
+
+def dep_a():
+    return "a"
+
+def dep_b():
+    return "b"
+
+def dep_c():
+    return "c"
+
+def root_sec(b = Security(dep_b, scopes=['b_scope']), c = Security(dep_c, scopes=['c_scope'])):
+    return "root"
+
+def test_security_scope_bleed():
+    # Simulate a call to get_dependant for the root function
+    # with initial security scopes ['root_scope']
+    root_dependant = get_dependant(
+        path="/",
+        call=root_sec,
+        security_scopes=['root_scope']
+    )
+    
+    # root_dependant.dependencies should contain dependants for dep_b and dep_c
+    b_dependant = root_dependant.dependencies[0]
+    c_dependant = root_dependant.dependencies[1]
+    
+    print(f"B scopes: {b_dependant.security_scopes}")
+    print(f"C scopes: {c_dependant.security_scopes}")
+    
+    assert b_dependant.security_scopes == ['root_scope', 'b_scope']
+    assert c_dependant.security_scopes == ['root_scope', 'c_scope']
+
+if __name__ == "__main__":
+    try:
+        test_security_scope_bleed()
+        print("Test passed!")
+    except AssertionError as e:
+        print("Test failed!")
+        import traceback
+        traceback.print_exc()
