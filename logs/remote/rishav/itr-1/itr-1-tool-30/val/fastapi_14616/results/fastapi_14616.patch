+from typing import Annotated, List, get_origin, get_args
+from pydantic import Json
+from fastapi import Form
+from fastapi._compat import ModelField, is_sequence_field
+from pydantic.fields import FieldInfo
+from fastapi._compat import shared
+
+# Mocking ModelField and FieldInfo for testing
+class MockModelField:
+    def __init__(self, annotation):
+        self.field_info = FieldInfo(annotation=annotation)
+        self.name = "items"
+
+annotation = Json[List[str]]
+print(f"Annotation: {annotation}")
+print(f"Origin: {get_origin(annotation)}")
+print(f"Args: {get_args(annotation)}")
+
+field = MockModelField(annotation)
+print(f"Is sequence field: {is_sequence_field(field)}")
+
+print(f"shared.field_annotation_is_sequence({annotation}): {shared.field_annotation_is_sequence(annotation)}")
+print(f"shared._annotation_is_sequence({annotation}): {shared._annotation_is_sequence(annotation)}")
+print(f"shared._annotation_is_sequence({get_origin(annotation)}): {shared._annotation_is_sequence(get_origin(annotation))}")
