@@ -0,0 +1,30 @@
+
+from fastapi import FastAPI, Depends, Security
+from fastapi.security import OAuth2PasswordBearer
+from fastapi.openapi.utils import get_openapi
+
+app = FastAPI()
+oauth2_scheme = OAuth2PasswordBearer(tokenUrl="token")
+
+def sub_dep():
+    return Security(oauth2_scheme)
+
+def parent_dep(security_scopes: list[str] = Security(oauth2_scheme)):
+    return Depends(sub_dep)
+
+@app.get("/route1", dependencies=[Security(parent_dep, scopes=["scope1"])])
+def route1():
+    return {"message": "route1"}
+
+@app.get("/route2", dependencies=[Security(sub_dep)])
+def route2():
+    return {"message": "route2"}
+
+if __name__ == "__main__":
+    import json
+    openapi_schema = get_openapi(
+        title="Test",
+        version="0.1.0",
+        routes=app.routes
+    )
+    print(json.dumps(openapi_schema, indent=2))
