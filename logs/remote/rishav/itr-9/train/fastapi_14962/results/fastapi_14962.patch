new file mode 100644
index 00000000..71d015b6
--- /dev/null
+++ b/benchmark_serialization.py
@@ -0,0 +1,29 @@
+
+from fastapi import FastAPI
+from pydantic import BaseModel
+from fastapi.testclient import TestClient
+import time
+
+class Item(BaseModel):
+    name: str
+    description: str
+    price: float
+    tax: float
+
+app = FastAPI()
+
+@app.get("/item", response_model=Item)
+async def read_item():
+    return Item(name="Foo", description="The foo", price=12.5, tax=1.2)
+
+client = TestClient(app)
+
+def benchmark():
+    start = time.time()
+    for _ in range(1000):
+        client.get("/item")
+    end = time.time()
+    print(f"Time taken: {end - start:.4f}s")
+
+if __name__ == "__main__":
+    benchmark()
