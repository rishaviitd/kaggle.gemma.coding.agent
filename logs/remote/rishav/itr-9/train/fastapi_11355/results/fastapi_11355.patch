+from __future__ import annotations
+from fastapi import FastAPI, Query
+from pydantic import BaseModel
+from fastapi.dependencies.utils import get_typed_signature
+from typing import Annotated
+import inspect
+
+app = FastAPI()
+
+class Item(BaseModel):
+    name: str
+    price: float
+
+@app.get("/items/")
+async def read_items(item: Annotated[Item, Query()]):
+    return item
+
+def test_annotations():
+    # Use FastAPI's get_typed_signature
+    sig = get_typed_signature(read_items)
+    print(f"Typed Signature: {sig}")
+    for name, param in sig.parameters.items():
+        print(f"Parameter {name}: {param.annotation} (type: {type(param.annotation)})")
+
+if __name__ == "__main__":
+    test_annotations()
