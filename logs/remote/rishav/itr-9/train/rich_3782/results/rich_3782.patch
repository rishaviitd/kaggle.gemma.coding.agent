+from rich.console import Console
+from rich.syntax import Syntax
+from rich.padding import PaddingDimensions
+
+console = Console(width=40, force_terminal=True)
+
+code = "print('hello')"
+# No padding
+print("--- No Padding ---")
+syntax_no_padding = Syntax(code, "python", padding=0)
+console.print(syntax_no_padding)
+
+# With padding
+print("\n--- With Padding (1, 1, 1, 1) ---")
+syntax_padding = Syntax(code, "python", padding=(1, 1, 1, 1))
+console.print(syntax_padding)
