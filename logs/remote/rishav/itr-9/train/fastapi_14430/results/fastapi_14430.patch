+++ b/repro.py
@@ -0,0 +1,29 @@
+
+from typing import Union, List, Optional, Sequence
+import types
+from fastapi._compat.shared import field_annotation_is_sequence, field_annotation_is_scalar_sequence, field_annotation_is_scalar
+
+def test():
+    # Python 3.10+ union syntax
+    # list[int] | None
+    t1 = list[int] | None
+    print(f"list[int] | None: sequence={field_annotation_is_sequence(t1)}, scalar_sequence={field_annotation_is_scalar_sequence(t1)}")
+
+    # list[int] | str
+    t2 = list[int] | str
+    print(f"list[int] | str: sequence={field_annotation_is_sequence(t2)}, scalar_sequence={field_annotation_is_scalar_sequence(t2)}")
+
+    # list[int] | dict[str, int]
+    t3 = list[int] | dict[str, int]
+    print(f"list[int] | dict[str, int]: sequence={field_annotation_is_sequence(t3)}, scalar_sequence={field_annotation_is_scalar_sequence(t3)}")
+
+    # Optional[list[int]]
+    t4 = Optional[List[int]]
+    print(f"Optional[List[int]]: sequence={field_annotation_is_sequence(t4)}, scalar_sequence={field_annotation_is_scalar_sequence(t4)}")
+
+    # list[int]
+    t5 = list[int]
+    print(f"list[int]: sequence={field_annotation_is_sequence(t5)}, scalar_sequence={field_annotation_is_scalar_sequence(t5)}")
+
+if __name__ == "__main__":
+    test()
