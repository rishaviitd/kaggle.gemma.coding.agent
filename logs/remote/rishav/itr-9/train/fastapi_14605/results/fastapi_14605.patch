@@ -0,0 +1,25 @@
+import warnings
+from pydantic.v1 import BaseModel
+from fastapi._compat.main import get_cached_model_fields
+try:
+    from fastapi.exceptions import FastAPIDeprecationWarning
+except ImportError:
+    # Define it here if it doesn't exist yet, so the script doesn't crash
+    class FastAPIDeprecationWarning(DeprecationWarning):
+        pass
+
+class MyModel(BaseModel):
+    foo: str
+
+with warnings.catch_warnings(record=True) as w:
+    warnings.simplefilter("always")
+    get_cached_model_fields(MyModel)
+    get_cached_model_fields(MyModel)
+    
+    # Check if FastAPIDeprecationWarning was raised
+    warnings_raised = [
+        warn for warn in w 
+        if warn.category is FastAPIDeprecationWarning and "Pydantic v1 is deprecated" in str(warn.message)
+    ]
+    print(f"Warnings found: {len(warnings_raised)}")
+    assert len(warnings_raised) == 1
