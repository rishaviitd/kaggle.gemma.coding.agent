diff --git a/test_protocol.py b/test_protocol.py
new file mode 100644
index 00000000..daf0a67f
--- /dev/null
+++ b/test_protocol.py
@@ -0,0 +1,14 @@
+from typing import Protocol, runtime_checkable
+
+@runtime_checkable
+class SupportsRead(Protocol):
+    def read(self, length: int = ...):
+        ...
+
+class Proxy:
+    def read(self, length=None):
+        return b"data"
+
+p = Proxy()
+print(f"isinstance(p, SupportsRead): {isinstance(p, SupportsRead)}")
+print(f"hasattr(p, 'read'): {hasattr(p, 'read')}")
