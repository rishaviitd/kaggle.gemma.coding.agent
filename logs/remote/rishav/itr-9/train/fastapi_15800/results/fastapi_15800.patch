+from fastapi import FastAPI, APIRouter
+from fastapi.staticfiles import StaticFiles
+import os
+
+def test_fastapi_frontend():
+    app = FastAPI()
+    try:
+        app.frontend("/", directory="static")
+        print("FastAPI.frontend exists")
+    except AttributeError:
+        print("FastAPI.frontend does not exist")
+
+def test_apirouter_frontend():
+    router = APIRouter()
+    try:
+        router.frontend("/", directory="static")
+        print("APIRouter.frontend exists")
+    except AttributeError:
+        print("APIRouter.frontend does not exist")
+
+if __name__ == "__main__":
+    # Create a dummy static directory
+    os.makedirs("static", exist_ok=True)
+    with open("static/index.html", "w") as f:
+        f.write("Hello World")
+    
+    test_fastapi_frontend()
+    test_apirouter_frontend()
