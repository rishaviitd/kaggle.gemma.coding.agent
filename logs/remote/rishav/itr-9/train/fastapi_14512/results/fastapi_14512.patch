@@ -0,0 +1,58 @@
+from fastapi import FastAPI, Body
+from fastapi.testclient import TestClient
+from typing import Literal, Union, Annotated
+from pydantic import BaseModel, Field
+
+class Cat(BaseModel):
+    meow: bool
+    kind: Literal["cat"]
+
+class Dog(BaseModel):
+    bark: bool
+    kind: Literal["dog"]
+
+CatDog = Annotated[Union[Cat, Dog], Field(discriminator="kind")]
+
+app = FastAPI()
+
+@app.post("/pet")
+async def create_pet(pet: Annotated[CatDog, Body()]):
+    return pet
+
+client = TestClient(app)
+
+def test_tagged_union_body():
+    # Test cat
+    response = client.post("/pet", json={"kind": "cat", "meow": True})
+    print(f"Cat response: {response.status_code} {response.json()}")
+    assert response.status_code == 200
+    assert response.json() == {"kind": "cat", "meow": True}
+
+    # Test dog
+    response = client.post("/pet", json={"kind": "dog", "bark": True})
+    print(f"Dog response: {response.status_code} {response.json()}")
+    assert response.status_code == 200
+    assert response.json() == {"kind": "dog", "bark": True}
+
+    # Test invalid discriminator
+    response = client.post("/pet", json={"kind": "bird", "fly": True})
+    print(f"Invalid discriminator response: {response.status_code} {response.json()}")
+    assert response.status_code == 422
+    # If discriminator is working, we should see 'union_tag_invalid'
+    assert any("union_tag_invalid" in str(error) for error in response.json()["detail"])
+
+    # Test missing discriminator
+    response = client.post("/pet", json={"meow": True})
+    print(f"Missing discriminator response: {response.status_code} {response.json()}")
+    assert response.status_code == 422
+    # If discriminator is working, we should see 'union_tag_invalid' or similar
+    assert any("union_tag_invalid" in str(error) for error in response.json()["detail"])
+
+if __name__ == "__main__":
+    try:
+        test_tagged_union_body()
+        print("Test passed!")
+    except Exception as e:
+        print(f"Test failed: {e}")
+        import traceback
+        traceback.print_exc()
