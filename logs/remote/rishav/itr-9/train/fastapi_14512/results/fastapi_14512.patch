@@ -0,0 +1,48 @@
+
+from fastapi import FastAPI, Body
+from fastapi.testclient import TestClient
+from pydantic import BaseModel, Field
+from typing import Union, Annotated, Literal
+import pytest
+
+app = FastAPI()
+
+class Cat(BaseModel):
+    kind: Literal["cat"]
+    meow: str
+
+class Dog(BaseModel):
+    kind: Literal["dog"]
+    bark: str
+
+Pet = Annotated[Union[Cat, Dog], Field(discriminator="kind")]
+
+@app.post("/pet")
+async def create_pet(pet: Annotated[Pet, Body()]):
+    return pet
+
+client = TestClient(app)
+
+def test_discriminator_lost():
+    # Send a request with an invalid 'kind'
+    # If discriminator is working, it should fail with a specific error about the discriminator.
+    # If discriminator is lost, it will try to validate against Cat and Dog.
+    response = client.post("/pet", json={"kind": "bird", "meow": "no"})
+    
+    # Pydantic v2 error for invalid discriminator is usually 'union_tag_invalid'
+    # Let's see what we get.
+    print(f"Response status: {response.status_code}")
+    print(f"Response body: {response.json()}")
+    
+    # Check if any error has type 'union_tag_invalid'
+    errors = response.json()["detail"]
+    found_discriminator_error = any(err["type"] == "union_tag_invalid" for err in errors)
+    assert found_discriminator_error, f"Discriminator error not found. Errors: {errors}"
+
+if __name__ == "__main__":
+    try:
+        test_discriminator_lost()
+        print("Test passed!")
+    except Exception as e:
+        print(f"Test failed: {e}")
+        exit(1)
