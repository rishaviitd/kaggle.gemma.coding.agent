@@ -0,0 +1,26 @@
+from typing import Literal, Union, Annotated
+from pydantic import BaseModel, Field, TypeAdapter, ValidationError
+
+class Cat(BaseModel):
+    meow: bool
+    kind: Literal["cat"]
+
+class Dog(BaseModel):
+    bark: bool
+    kind: Literal["dog"]
+
+CatDog = Annotated[Union[Cat, Dog], Field(discriminator="kind")]
+
+adapter = TypeAdapter(CatDog)
+
+try:
+    print("Testing valid cat...")
+    print(adapter.validate_python({"kind": "cat", "meow": True}))
+    
+    print("\nTesting valid dog...")
+    print(adapter.validate_python({"kind": "dog", "bark": True}))
+    
+    print("\nTesting invalid discriminator...")
+    print(adapter.validate_python({"kind": "bird", "fly": True}))
+except ValidationError as e:
+    print(e.json())
