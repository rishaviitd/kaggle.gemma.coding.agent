+_endpoint_metadata_cache: Dict[Tuple[Callable[..., Any], str, str], str] = {}
+
+
+def _get_endpoint_metadata(
+    *, endpoint: Callable[..., Any], method: str, path: str
+) -> str:
+    cache_key = (endpoint, method, path)
+    if cache_key in _endpoint_metadata_cache:
+        return _endpoint_metadata_cache[cache_key]
+    metadata = ""
+    try:
+        filepath = inspect.getsourcefile(endpoint) or ""
+        source_lines, lineno = inspect.getsourcelines(endpoint)
+        for offset, line in enumerate(source_lines):
+            stripped = line.strip()
+            if stripped.startswith("async def ") or stripped.startswith("def "):
+                lineno = lineno + offset
+                break
+        funcname = getattr(endpoint, "__name__", str(endpoint))
+        metadata = (
+            f'  File "{filepath}", line {lineno}, in {funcname}\n'
+            f"    {method} {path}"
+        )
+    except (OSError, TypeError):
+        metadata = ""
+    _endpoint_metadata_cache[cache_key] = metadata
+    return metadata
+
