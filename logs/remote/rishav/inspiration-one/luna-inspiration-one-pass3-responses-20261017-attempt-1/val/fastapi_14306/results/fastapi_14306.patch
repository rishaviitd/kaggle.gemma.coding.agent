+@functools.lru_cache(maxsize=None)
+def _get_endpoint_source(endpoint: Callable[..., Any]) -> Tuple[str, int, str]:
+    try:
+        filename = inspect.getsourcefile(endpoint)
+        line_number = inspect.getsourcelines(endpoint)[1]
+    except (OSError, TypeError):
+        return "", 0, getattr(endpoint, "__name__", "<unknown>")
+    return filename or "", line_number, getattr(endpoint, "__name__", "<unknown>")
+
+
+def _get_endpoint_context(
+    endpoint: Callable[..., Any], method: str, path: str
+) -> str:
+    filename, line_number, name = _get_endpoint_source(endpoint)
+    if not filename:
+        return f"{method} {path}"
+    return f'File "{filename}", line {line_number}, in {name}\n    {method} {path}'
+
