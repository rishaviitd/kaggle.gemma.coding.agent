+_REGIONAL_INDICATOR_RANGE = (0x1F1E6, 0x1F1FF)
+_SKIN_TONE_RANGE = (0x1F3FB, 0x1F3FF)
+_VARIATION_SELECTOR_RANGES = ((0xFE00, 0xFE0F), (0xE0100, 0xE01EF))
+
+
+def _in_range(codepoint: int, ranges: tuple[tuple[int, int], ...]) -> bool:
+    return any(start <= codepoint <= end for start, end in ranges)
+
+
+def split_graphemes(text: str) -> list[str]:
+    """Split text in to a list of grapheme clusters (sequences that produce a single glyph).
+
+    Handles combining characters, zero-width joiner sequences, variation selectors,
+    skin tone modifiers, regional indicator pairs, and CR LF.
+
+    Args:
+        text (str): Text to split.
+
+    Returns:
+        list[str]: A list of strings, each of which is a single grapheme cluster.
+    """
+    graphemes: list[str] = []
+    append = graphemes.append
+    current = ""
+    previous_codepoint = -1
+    previous_was_zwj = False
+    regional_run = 0
+    for character in text:
+        codepoint = ord(character)
+        if not current:
+            current = character
+            regional_run = 1 if _in_range(codepoint, (_REGIONAL_INDICATOR_RANGE,)) else 0
+        else:
+            is_extend = (
+                _in_range(codepoint, _VARIATION_SELECTOR_RANGES)
+                or _in_range(codepoint, (_SKIN_TONE_RANGE,))
+                or codepoint == 0x200D
+                or previous_was_zwj
+                or (codepoint != 0x200D and get_character_cell_size(character) == 0
+                    and codepoint >= 0x300)
+                or (previous_codepoint == 0x0D and codepoint == 0x0A)
+            )
+            is_regional_pair = (
+                _in_range(codepoint, (_REGIONAL_INDICATOR_RANGE,))
+                and regional_run == 1
+            )
+            if is_extend or is_regional_pair:
+                current += character
+                regional_run = 0
+            else:
+                append(current)
+                current = character
+                regional_run = 1 if _in_range(codepoint, (_REGIONAL_INDICATOR_RANGE,)) else 0
+        previous_was_zwj = codepoint == 0x200D
+        previous_codepoint = codepoint
+    if current:
+        append(current)
+    return graphemes
+
