+def _merge_security_definitions(
+    target: Dict[str, Any], new: Dict[str, Any]
+) -> None:
+    # Merge security schemes with the same name, combining OAuth2 flow scopes
+    # so that schemes declared with different scopes are not lost.
+    for name, definition in new.items():
+        existing = target.get(name)
+        if existing is None:
+            target[name] = definition
+            continue
+        new_flows = definition.get("flows")
+        if not new_flows:
+            continue
+        existing_flows = existing.setdefault("flows", {})
+        for flow_name, flow in new_flows.items():
+            existing_flow = existing_flows.get(flow_name)
+            if existing_flow is None:
+                existing_flows[flow_name] = flow
+                continue
+            existing_scopes = existing_flow.setdefault("scopes", {})
+            for scope_name, scope_desc in flow.get("scopes", {}).items():
+                existing_scopes.setdefault(scope_name, scope_desc)
+
+
 def get_openapi_security_definitions(
     flat_dependant: Dependant,
 ) -> Tuple[Dict[str, Any], List[Dict[str, Any]]]:
