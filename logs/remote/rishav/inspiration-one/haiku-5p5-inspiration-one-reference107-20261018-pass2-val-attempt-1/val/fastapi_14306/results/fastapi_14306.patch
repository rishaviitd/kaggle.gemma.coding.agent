+def _extract_endpoint_context(
+    func: Any, *, path: Optional[str] = None, method: Optional[str] = None
+) -> Dict[str, Any]:
+    """
+    Collect source location and route info for an endpoint. Computed once per
+    route (not per request) and only used to enrich validation error messages.
+    """
+    ctx: Dict[str, Any] = {
+        "function": getattr(func, "__name__", type(func).__name__),
+    }
+    try:
+        ctx["file"] = inspect.getsourcefile(func) or inspect.getfile(func)
+        ctx["line"] = inspect.getsourcelines(func)[1]
+    except (OSError, TypeError):
+        pass
+    if path is not None:
+        ctx["path"] = path
+    if method is not None:
+        ctx["method"] = method
+    return ctx
+
