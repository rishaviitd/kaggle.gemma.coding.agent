+# Copy from typing-inspection: typing_inspection/introspection.py
+def is_typealiastype(tp: Any) -> bool:
+    """Return whether the provided argument is an instance of `TypeAliasType`.
+
+    Args:
+        tp: The type to check.
+
+    Returns:
+        `True` if the type is an instance of `TypeAliasType`, `False` otherwise.
+    """
+    return type(tp).__name__ == "TypeAliasType"
