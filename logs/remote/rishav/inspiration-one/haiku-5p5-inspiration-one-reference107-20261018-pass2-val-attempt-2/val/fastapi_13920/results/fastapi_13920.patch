+# Adapted from typing-inspection: typing_inspection/introspection.py
+def is_typealiastype(tp: Any) -> bool:
+    """Return whether the provided argument is an instance of `TypeAliasType`."""
+    type_alias_type = getattr(typing, "TypeAliasType", None)
+    if type_alias_type is not None and isinstance(tp, type_alias_type):
+        return True
+    try:
+        import typing_extensions
+
+        type_alias_type = getattr(typing_extensions, "TypeAliasType", None)
+    except ImportError:  # pragma: no cover
+        return False
+    return type_alias_type is not None and isinstance(tp, type_alias_type)
+
