+def _get_endpoint_ctx(
+    endpoint: Callable[..., Any],
+    path: str,
+    method: Optional[str] = None,
+) -> Dict[str, Any]:
+    unwrapped = inspect.unwrap(endpoint)
+    code = getattr(unwrapped, "__code__", None)
+    ctx: Dict[str, Any] = {
+        "function": getattr(unwrapped, "__name__", None),
+        "path": path,
+        "method": method,
+    }
+    if code is not None:
+        ctx["file"] = code.co_filename
+        ctx["line"] = code.co_firstlineno
+    return ctx
