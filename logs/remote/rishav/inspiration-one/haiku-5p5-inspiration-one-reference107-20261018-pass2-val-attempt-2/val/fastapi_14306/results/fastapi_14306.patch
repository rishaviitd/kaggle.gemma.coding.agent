 class ValidationException(Exception):
-    def __init__(self, errors: Sequence[Any]) -> None:
+    def __init__(
+        self,
+        errors: Sequence[Any],
+        *,
+        endpoint_ctx: Optional[Dict[str, Any]] = None,
+    ) -> None:
         self._errors = errors
+        self.endpoint_ctx = endpoint_ctx or {}
 
     def errors(self) -> Sequence[Any]:
         return self._errors
 
+    def _format_endpoint_context(self) -> str:
+        ctx = self.endpoint_ctx
+        if not ctx:
+            return ""
+        lines = []
+        if ctx.get("file") and ctx.get("line") and ctx.get("function"):
+            lines.append(
+                f'  File "{ctx["file"]}", line {ctx["line"]}, in {ctx["function"]}'
+            )
+        if ctx.get("path"):
+            lines.append(f"    {ctx.get('method') or ''} {ctx['path']}".rstrip())
+        if not lines:
+            return ""
+        return "\n" + "\n".join(lines) + "\n"
+
+    def __str__(self) -> str:
+        message = f"{len(self._errors)} validation errors:\n"
+        for err in self._errors:
+            message += f"  {err}\n"
+        return message + self._format_endpoint_context()
+
 
