+        # TTY_COMPATIBLE env var overrides TTY detection: "0" means not a tty,
+        # "1" means a tty. Any other value falls through to normal detection.
+        tty_compatible = self._environ.get("TTY_COMPATIBLE")
+        if tty_compatible == "0":
+            return False
+        if tty_compatible == "1":
+            return True
+
         isatty: Optional[Callable[[], bool]] = getattr(self.file, "isatty", None)
         try:
             return False if isatty is None else isatty()
