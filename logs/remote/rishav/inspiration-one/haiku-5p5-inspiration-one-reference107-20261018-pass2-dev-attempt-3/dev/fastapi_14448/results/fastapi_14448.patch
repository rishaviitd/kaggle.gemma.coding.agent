+    def _call_chain(self) -> List[Any]:
+        # Collect every callable level: wrappers (__wrapped__) and partials
+        # (.func), so that async/generator detection looks at all of them.
+        chain: List[Any] = []
+        current = self.call
+        seen: set = set()
+        while current is not None and id(current) not in seen:
+            seen.add(id(current))
+            chain.append(current)
+            if isinstance(current, partial):
+                current = current.func
+            elif hasattr(current, "__wrapped__"):
+                current = current.__wrapped__
+            else:
+                break
+        return chain
