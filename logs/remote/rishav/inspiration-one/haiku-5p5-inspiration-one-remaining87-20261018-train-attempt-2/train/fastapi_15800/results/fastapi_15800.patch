+    def frontend(
+        self,
+        path: str,
+        *,
+        directory: str,
+        name: str | None = None,
+    ) -> None:
+        """
+        Serve a frontend build directory (e.g. `dist`) at the given path.
+
+        Directories are served as HTML (`index.html` is used for directory
+        requests).
+        """
