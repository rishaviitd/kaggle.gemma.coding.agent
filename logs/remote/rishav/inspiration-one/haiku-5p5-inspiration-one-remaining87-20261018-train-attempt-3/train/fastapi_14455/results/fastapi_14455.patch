+def _merge_security_definition(
+    existing: Dict[str, Any], new: Dict[str, Any]
+) -> Dict[str, Any]:
+    # The same security scheme name can be declared with different OAuth2 scopes,
+    # merge them so that all the scopes are declared in a single security scheme
+    existing_flows = existing.get("flows")
+    new_flows = new.get("flows")
+    if not existing_flows or not new_flows:
+        return new
+    for flow_name, new_flow in new_flows.items():
+        if flow_name not in existing_flows:
+            existing_flows[flow_name] = new_flow
+            continue
+        existing_scopes = existing_flows[flow_name].setdefault("scopes", {})
+        for scope_name, scope_description in new_flow.get("scopes", {}).items():
+            existing_scopes.setdefault(scope_name, scope_description)
+    return existing
+
+
+def _merge_security_schemes(
+    target: Dict[str, Any], source: Dict[str, Any]
+) -> Dict[str, Any]:
+    for name, definition in source.items():
+        if name in target:
+            target[name] = _merge_security_definition(target[name], definition)
+        else:
+            target[name] = definition
+    return target
+
