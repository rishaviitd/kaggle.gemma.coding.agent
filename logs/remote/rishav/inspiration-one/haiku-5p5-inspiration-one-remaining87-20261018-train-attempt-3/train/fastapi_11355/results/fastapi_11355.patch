+def _get_globalns(call: Callable[..., Any]) -> Dict[str, Any]:
+    unwrapped = inspect.unwrap(call)
+    globalns = getattr(unwrapped, "__globals__", None)
+    if globalns is not None:
+        return globalns
+    # Classes and callable instances have no __globals__; use their module
+    # namespace instead (needed for stringified annotations on Python 3.10).
+    target = unwrapped if inspect.isclass(unwrapped) else type(unwrapped)
+    module = sys.modules.get(getattr(target, "__module__", ""), None)
+    if module is not None:
+        return vars(module)
+    return {}
+
