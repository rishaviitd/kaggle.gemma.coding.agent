+def _extract_endpoint_context(
+    endpoint: Callable[..., Any], *, route: str
+) -> Optional[Dict[str, Any]]:
+    # Computed once per route (not per request) and attached to validation errors
+    try:
+        code = getattr(inspect.unwrap(endpoint), "__code__", None)
