+from .cells import cell_len, get_character_cell_size
 
 re_word = re.compile(r"\s*\S+\s*")
 
 
+def _chop_forward(text: str, width: int) -> List[str]:
+    """Split text into lines of at most `width` cells, filling from the start."""
+    lines: List[str] = []
+    line: List[str] = []
+    line_size = 0
+    for character in text:
+        size = get_character_cell_size(character)
+        if line and line_size + size > width:
+            lines.append("".join(line))
+            line = []
+            line_size = 0
+        line.append(character)
+        line_size += size
+    if line:
+        lines.append("".join(line))
+    return lines
+
