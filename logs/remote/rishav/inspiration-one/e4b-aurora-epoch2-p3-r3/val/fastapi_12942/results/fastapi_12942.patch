@@ -0,0 +1,24 @@
+from typing_extensions import Tag
+from typing import Annotated
+from typing_extensions import Union
+from pydantic import BaseModel, Discriminator
+from fastapi import FastAPI
+from fastapi.testclient import TestClient
+class Pie(BaseModel):
+    time_to_cook: int
+    num_ingredients: int
+class ApplePie(Pie):
+    fruit: str = 'apple'
+class PumpkinPie(Pie):
+    filling: str = 'pumpkin'
+def get_discriminator_value(v: any) -> str:
+    if isinstance(v, dict):
+        return v.get('fruit', v.get('filling'))
+    return getattr(v, 'fruit', getattr(v, 'filling', None))
+Dessert = Annotated[Annotated[ApplePie, Tag('apple')] | Annotated[PumpkinPie, Tag('pumpkin')], Discriminator(get_discriminator_value)]
+app = FastAPI()
+@app.post('/dessert')
+async def dinner(dessert: Dessert) -> dict:
+    return dessert.model_dump()
+c = TestClient(app)
+print(c.post('/dessert', json={'time_to_cook': 1, 'num_ingredients': 2, 'fruit': 'apple'}).status_code, c.post('/dessert', json={'time_to_cook': 1, 'num_ingredients': 2, 'filling': 'pumpkin'}).status_code)
