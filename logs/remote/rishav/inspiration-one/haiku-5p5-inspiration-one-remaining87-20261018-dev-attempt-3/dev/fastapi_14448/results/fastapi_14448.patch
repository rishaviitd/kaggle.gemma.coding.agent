+def _unwrap_all(call: Any) -> List[Any]:
+    """
+    Return every callable level in the chain, from the outermost to the
+    innermost, following `__wrapped__` (functools.wraps) and `partial.func`
+    repeatedly, in any combination.
+    """
+    levels: List[Any] = []
+    current = call
+    while current is not None and not any(current is seen for seen in levels):
+        levels.append(current)
+        if isinstance(current, partial):
+            current = current.func
+        elif hasattr(current, "__wrapped__"):
+            current = current.__wrapped__
+        else:
+            break
+    return levels
+
