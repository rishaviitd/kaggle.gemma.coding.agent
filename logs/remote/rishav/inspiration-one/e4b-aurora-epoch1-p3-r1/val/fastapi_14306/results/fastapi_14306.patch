+    def _get_endpoint_context(self) -> Optional[str]:
+        """Extract the endpoint context from the request, if available."""
+        if not self.request:
+            return None
+        
+        # Cache the context per endpoint to avoid repeated extraction
+        if not hasattr(self, "_endpoint_context"):
+            self._endpoint_context = self._get_endpoint_context.__self__._cache.get(
+                (self.request, self.exc_value.__class__, self.exc_value.args), None
+            )
+        
+        if self._endpoint_context is not None:
+            return self._endpoint_context
+
+        try:
+            # Extract the endpoint context once per endpoint
+            context = self._extract_endpoint_context()
+            self._endpoint_context = context
+            return context
+        except Exception:
+            # Fallback: if endpoint extraction fails, return nothing
+            return None
+
+    def _extract_endpoint_context(self) -> Optional[str]:
+        """Extract the endpoint context from the request."""
+        from fastapi import FastAPI, Request
+        from fastapi.routing import APIRouter
+        
+        if not isinstance(self.request, Request):
+            return None
+
+        # Get the route handler and method
+        route = self.request.scope.get("route", None)
+        if not route:
+            return None
+        
+        # Get the endpoint function and HTTP method
+        endpoint = route.endpoint
+        method = self.request.method
+        
+        if not endpoint:
+            return None
+
+        # Get the source file and line number of the endpoint function
+        try:
+            source_file = endpoint.__code__.co_filename
+            line = endpoint.__code__.co_firstlineno
+        except AttributeError:
+            # Built-in functions or objects without a __code__ attribute
+            return None
+
+        # Format the context string
+        context = (
+            f"  File "{source_file}", line {line}, in {endpoint.__name__}
+"
+            f"    {method} {route.path}"
+        )
+        return context
+
