+    def _extract_context(self) -> str:
+        # Extract context once per endpoint and cache it
+        exc_type = type(self)
+        exc_name = exc_type.__name__
+        
+        # Use the exception's __cause__ or __context__ to find the endpoint
+        exc = getattr(self, "__cause__", None) or getattr(self, "__context__", None)
+        if not exc:
+            return ""
+
+        # Get the frame where the exception was raised
+        exc_type_name = exc_type.__name__
+        exc_value_name = exc_type.__name__
+        
+        # Walk the stack to find the FastAPI routing frame
+        for frame in exc.__traceback__:
+            if exc_type_name in frame.exc_value.__name__:
+                code = frame.f_code
+                frame_file = frame.f_lineno
+                
+                # Check if this frame is in an app's request/websocket handler
+                if (
+                    "fastapi.routing" in code.co_filename
+                    and ("def " in code.co_name or "async def " in code.co_name)
+                ):
+                    # Get the route from the frame's globals
+                    frame_globals = frame.f_globals
+                    route = frame_globals.get("_", "")
+                    
+                    # Heuristic: look for a route decorator on the function
+                    for dec in inspect.getsource(code.co_name).split("\n"):
+                        if dec.strip().startswith("@"):
+                            route = dec.strip()
+                            break
+                    
+                    # Extract HTTP method from the route string
+                    method = ""
+                    for m in ["@app.get", "@app.post", "@app.put", "@app.delete", "@app.patch", "@app.websocket"]:
+                        if route.startswith(m):
+                            method = m.split(".")[-1].replace("@", "")
+                            break
+                    
+                    return (
+                        f"\n  File \"{frame.f_code.co_filename}\", line {frame_file}, in {code.co_name}\n"
+                        f"    {method} {route}\n"
+                    )
+        return ""
+
