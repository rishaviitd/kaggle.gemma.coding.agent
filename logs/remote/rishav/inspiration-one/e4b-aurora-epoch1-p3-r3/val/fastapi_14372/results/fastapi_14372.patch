diff --git a/fastapi/params.py b/fastapi/params.py
index 6a58d580..5f561beb 100644
--- a/fastapi/params.py
+++ b/fastapi/params.py
@@ -768,7 +768,30 @@ class Depends:
     use_cache: bool = True
     scope: Union[Literal["function", "request"], None] = None
 
+    def __hash__(self) -> None:
+        raise TypeError("unhashable")
+
+    def __eq__(self, o: Any) -> bool:
+        if not isinstance(o, Depends):
+            return False
+        return (
+            self.dependency == o.dependency
+            and self.use_cache == o.use_cache
+            and self.scope == o.scope
+        )
+
 
 @dataclass
 class Security(Depends):
     scopes: Optional[Sequence[str]] = None
+
+    def __hash__(self) -> None:
+        raise TypeError("unhashable")
+
+    def __eq__(self, o: Any) -> bool:
+        if not isinstance(o, Security):
+            return False
+        return (
+            super().__eq__(o)
+            and self.scopes == o.scopes
+        )
