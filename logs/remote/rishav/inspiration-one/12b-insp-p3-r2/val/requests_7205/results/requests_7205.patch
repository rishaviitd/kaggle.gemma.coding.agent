diff --git a/check_netrc.py b/check_netrc.py
new file mode 100644
index 00000000..1d3ff666
--- /dev/null
+++ b/check_netrc.py
@@ -0,0 +1,11 @@
+from netrc import netrc
+import os
+
+def check(content):
+    with open(".netrc", "w") as f:
+        f.write(content)
+    print(f"Content: {content.strip()} -> {netrc().authenticators('example.com')}")
+
+check("example.com:user:pass")
+check("example.com:")
+check("example.com:user:")
diff --git a/check_netrc_again.py b/check_netrc_again.py
new file mode 100644
index 00000000..1c025003
--- /dev/null
+++ b/check_netrc_again.py
@@ -0,0 +1,16 @@
+from netrc import netrc
+import os
+
+def check(content):
+    with open(".netrc", "w") as f:
+        f.write(content)
+    # We need to make sure netrc module uses this file.
+    # In some environments, netrc module might not respect NETRC env var.
+    # But it should.
+    os.environ["NETRC"] = os.getcwd()
+    auth = netrc().authenticators('example.com')
+    print(f"Content: {content.strip()} -> {auth}")
+
+check("example.com:user:pass")
+check("example.com:")
+check("example.com:user:")
