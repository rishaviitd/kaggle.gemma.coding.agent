+from rich.segment import Segment
+from rich.cells import cell_len
+
+def test_split():
+    # "🚀" is 2 cells wide
+    text = "🚀"
+    segment = Segment(text)
+    print(f"Original text: {text}, cell_length: {segment.cell_length}")
+    
+    cut = 1
+    s1, s2 = segment.split_cells(cut)
+    print(f"Split at {cut}: '{s1.text}' (len {s1.cell_length}), '{s2.text}' (len {s2.cell_length})")
+
+    text2 = "🚀A"
+    segment2 = Segment(text2)
+    print(f"\nOriginal text: {text2}, cell_length: {segment2.cell_length}")
+    
+    cut2 = 1
+    s1_2, s2_2 = segment2.split_cells(cut2)
+    print(f"Split at {cut2}: '{s1_2.text}' (len {s1_2.cell_length}), '{s2_2.text}' (len {s2_2.cell_length})")
+
+if __name__ == "__main__":
+    test_split()
