+def _get_endpoint_context(
+    endpoint: Callable[..., Any], *, method: Optional[str], path: str
+) -> Optional[str]:
+    """
+    Build a traceback-style description of an endpoint for server-side logs.
+    Returns None if the source location can't be determined.
+    """
+    try:
+        source_file = inspect.getsourcefile(endpoint) or inspect.getfile(endpoint)
+        line_no = inspect.getsourcelines(endpoint)[1]
