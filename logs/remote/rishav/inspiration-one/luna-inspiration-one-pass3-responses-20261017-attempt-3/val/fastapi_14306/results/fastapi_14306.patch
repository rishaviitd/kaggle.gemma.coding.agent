+@functools.lru_cache
+
+def _get_endpoint_source(endpoint: Callable[..., Any]) -> str:
+    endpoint = inspect.unwrap(endpoint)
+    sourcefile = inspect.getsourcefile(endpoint)
+    if sourcefile is None:
+        return ""
+    _, line_number = inspect.getsourcelines(endpoint)
+    return f'File "{os.path.abspath(sourcefile)}", line {line_number}, in {get_name(endpoint)}'
+
+
+def _get_endpoint_context(endpoint: Callable[..., Any], method: str, path: str) -> str:
+    source = _get_endpoint_source(endpoint)
+    if not source:
+        return ""
+    return f"{source}\\n    {method} {path}"
+
