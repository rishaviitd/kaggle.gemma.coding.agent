new file mode 100644
index 00000000..ddc37420
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,42 @@
+from rich.console import Console
+from rich.markdown import Markdown
+
+console = Console(force_terminal=True)
+
+markdown_no_header = """
+| Cell 1 | Cell 2 |
+"""
+# Wait, markdown tables REQUIRE a header and a separator line to be recognized as tables by most parsers.
+
+markdown_with_header_no_body = """
+| Header 1 | Header 2 |
+| -------- | -------- |
+"""
+
+print("Testing markdown with header but no body:")
+try:
+    console.print(Markdown(markdown_with_header_no_body))
+except Exception as e:
+    print(f"Caught exception: {e}")
+    import traceback
+    traceback.print_exc()
+
+print("\nTesting markdown with body but no header (if possible):")
+# In GFM, you can't really have a table without a header.
+# But maybe we can use HTML tags if rich supports them.
+markdown_html_no_header = """
+<table>
+  <tbody>
+    <tr>
+      <td>Cell 1</td>
+      <td>Cell 2</td>
+    </tr>
+  </tbody>
+</table>
+"""
+try:
+    console.print(Markdown(markdown_html_no_header))
+except Exception as e:
+    print(f"Caught exception: {e}")
+    import traceback
+    traceback.print_exc()
