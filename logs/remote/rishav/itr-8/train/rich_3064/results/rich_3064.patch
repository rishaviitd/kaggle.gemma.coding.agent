+++ b/repro_v2.py
@@ -0,0 +1,41 @@
+from rich.console import Console
+from rich.markdown import Markdown
+
+console = Console(force_terminal=True)
+
+markdown_with_header_no_body = """
+| Header 1 | Header 2 |
+| --- | --- |
+"""
+
+markdown_with_body_no_header = """
+| Row 1 Col 1 | Row 1 Col 2 |
+| Row 2 Col 1 | Row 2 Col 2 |
+"""
+# Note: Standard markdown tables usually require a header and a separator line.
+# If the separator line is missing, it might not be parsed as a table.
+# But let's see what happens.
+
+markdown_empty = """
+| |
+| --- |
+"""
+
+print("Testing markdown with header but no body:")
+try:
+    console.print(Markdown(markdown_with_header_no_body))
+except Exception as e:
+    print(f"Caught exception: {e}")
+
+print("\nTesting markdown with body but no header:")
+try:
+    # This might not be parsed as a table by markdown-it if it doesn't have the separator
+    console.print(Markdown(markdown_with_body_no_header))
+except Exception as e:
+    print(f"Caught exception: {e}")
+
+print("\nTesting markdown empty:")
+try:
+    console.print(Markdown(markdown_empty))
+except Exception as e:
+    print(f"Caught exception: {e}")
