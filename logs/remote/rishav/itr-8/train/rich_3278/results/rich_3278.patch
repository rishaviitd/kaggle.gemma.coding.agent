+from rich.ansi import AnsiDecoder
+
+decoder = AnsiDecoder()
+text = "Hello\x1b7World\x1b8!"
+decoded = decoder.decode_line(text)
+print(f"Decoded: {repr(decoded)}")
+# If \x1b7 and \x1b8 are not stripped, they will be in the decoded text.
+# If they are stripped, they should be gone.
