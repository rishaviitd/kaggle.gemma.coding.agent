+from fastapi import FastAPI, Body
+from fastapi.testclient import TestClient
+from typing import Annotated, Union, Literal
+from pydantic import BaseModel, Field
+import pytest
+
+app = FastAPI()
+
+class Cat(BaseModel):
+    type: Literal['cat']
+    meow: bool
+
+class Dog(BaseModel):
+    type: Literal['dog']
+    bark: bool
+
+@app.post("/pets")
+async def create_pet(pet: Annotated[Union[Cat, Dog], Field(discriminator='type'), Body()]):
+    return pet
+
+client = TestClient(app)
+
+def test_create_cat():
+    response = client.post("/pets", json={"type": "cat", "meow": True})
+    assert response.status_code == 200
+    assert response.json() == {"type": "cat", "meow": True}
+
+def test_create_dog():
+    response = client.post("/pets", json={"type": "dog", "bark": True})
+    assert response.status_code == 200
+    assert response.json() == {"type": "dog", "bark": True}
+
+def test_discriminator_works():
+    # This should fail because type is 'cat' but it doesn't match Cat (missing meow)
+    # and it shouldn't even try Dog because the discriminator is 'cat'
+    response = client.post("/pets", json={"type": "cat", "bark": True})
+    assert response.status_code == 422
+    # The error message should indicate that it tried to validate against Cat and failed
+    # If discriminator is working, it should only try Cat.
+
+def test_discriminator_wrong_type():
+    # This should fail because 'bird' is not a valid discriminator
+    response = client.post("/pets", json={"type": "bird", "meow": True})
+    assert response.status_code == 422
+
+if __name__ == "__main__":
+    try:
+        test_create_cat()
+        test_create_dog()
+        test_discriminator_works()
+        test_discriminator_wrong_type()
+        print("All tests passed!")
+    except Exception as e:
+        print(f"Test failed: {e}")
+        raise e
