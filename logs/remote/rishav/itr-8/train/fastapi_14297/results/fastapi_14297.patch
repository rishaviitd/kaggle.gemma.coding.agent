+from typing import List, Optional, get_origin, get_args, Union
+import types
+
+# Python 3.10+ syntax
+annotation = list[int] | None
+print(f"Annotation: {annotation}")
+origin = get_origin(annotation)
+print(f"Origin: {origin}")
+print(f"Origin is Union: {origin is Union}")
+print(f"Origin is UnionType: {origin is types.UnionType}")
