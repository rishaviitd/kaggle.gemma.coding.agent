diff --git a/_check.py b/_check.py
new file mode 100644
index 00000000..1762de0e
--- /dev/null
+++ b/_check.py
@@ -0,0 +1,50 @@
+
+from requests.utils import dict_to_sequence, to_key_val_list
+from requests.models import Request
+
+class ProxyRead:
+    def __getattr__(self, name):
+        if name == "read":
+            return lambda x=0: b"data"
+        raise AttributeError(name)
+
+class ProxyItems:
+    def __getattr__(self, name):
+        if name == "items":
+            return lambda: [("a", "b")]
+        raise AttributeError(name)
+
+def test_proxy_read():
+    # Test the logic used in models.py:164
+    # In prepare_body, if it's a SupportsRead, it returns data as is.
+    # We can't easily call prepare_body without a Request object.
+    # But we can check the logic:
+    from requests._types import SupportsRead
+    data = ProxyRead()
+    assert isinstance(data, SupportsRead) or hasattr(data, "read"), "ProxyRead should be identified as supporting read"
+
+def test_proxy_items():
+    # Test the logic used in utils.py:154 and 401
+    from requests.utils import dict_to_sequence, to_key_val_list
+    
+    d = ProxyItems()
+    # Test dict_to_sequence
+    items = list(dict_to_sequence(d))
+    assert items == [("a", "b")], f"Expected [('a', 'b')], got {items}"
+    
+    # Test to_key_val_list
+    # to_key_val_list(value) where value is ProxyItems
+    # It should return list(value.items())
+    encoded = to_key_val_list(d)
+    assert encoded == [("a", "b")], f"Expected [('a', 'b')], got {encoded}"
+
+if __name__ == "__main__":
+    try:
+        test_proxy_read()
+        print("test_proxy_read passed")
+        test_proxy_items()
+        print("test_proxy_items passed")
+        print("All tests passed!")
+    except Exception as e:
+        print(f"Test failed: {e}")
+        raise e
