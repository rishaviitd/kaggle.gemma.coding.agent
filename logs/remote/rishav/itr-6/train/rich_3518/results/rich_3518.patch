@@ -0,0 +1,31 @@
+from rich.table import Table, Column
+from rich.console import Console
+from rich.text import Text
+
+def test_add_row_highlight_true():
+    table = Table(highlight=True)
+    table.add_row("cell 1", "cell 2")
+    assert len(table.columns) == 2
+    for i, col in enumerate(table.columns):
+        assert col.highlight is True, f"Column {i} should have highlight=True"
+
+def test_add_row_highlight_false():
+    table = Table(highlight=False)
+    table.add_row("cell 1", "cell 2")
+    assert len(table.columns) == 2
+    for i, col in enumerate(table.columns):
+        assert col.highlight is False, f"Column {i} should have highlight=False"
+
+if __name__ == "__main__":
+    try:
+        test_add_row_highlight_true()
+        print("test_add_row_highlight_true passed!")
+        test_add_row_highlight_false()
+        print("test_add_row_highlight_false passed!")
+        print("All tests passed!")
+    except AssertionError as e:
+        print(f"Test failed: {e}")
+        exit(1)
+    except Exception as e:
+        print(f"An error occurred: {e}")
+        exit(1)
