+from rich.markdown import Markdown
+from rich.console import Console
+import io
+
+def test_markdown_table():
+    console = Console(file=io.StringIO(), force_terminal=True)
+    
+    # Standard table
+    markdown_text = "| Header 1 | Header 2 |\n|----------|----------|\n| Cell 1   | Cell 2   |"
+    try:
+        console.print(Markdown(markdown_text))
+        print("Standard table passed")
+    except Exception as e:
+        print(f"Standard table failed: {e}")
+
+    # Table with something that might cause an issue
+    # Try to see if we can trigger the RuntimeError
+    # Maybe a table with no header? (GFM requires header)
+    # Maybe a table with just a body?
+    
+    # Let's try to see what happens with a very simple table
+    markdown_text = "| Header 1 |\n|----------|\n| Cell 1 |"
+    try:
+        console.print(Markdown(markdown_text))
+        print("Simple table passed")
+    except Exception as e:
+        print(f"Simple table failed: {e}")
+
+if __name__ == "__main__":
+    test_markdown_table()
