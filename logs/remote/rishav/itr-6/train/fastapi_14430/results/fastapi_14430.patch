+from fastapi import FastAPI, Query
+from fastapi.testclient import TestClient
+from typing import List, Optional
+
+app = FastAPI()
+
+@app.get("/old")
+def read_old(q: Optional[List[str]] = Query(None)):
+    return {"q": q}
+
+@app.get("/new")
+def read_new(q: list[str] | None = Query(None)):
+    return {"q": q}
+
+client = TestClient(app)
+
+def test_old():
+    response = client.get("/old", params={"q": ["a", "b"]})
+    assert response.status_code == 200
+    assert response.json() == {"q": ["a", "b"]}
+
+def test_new():
+    response = client.get("/new", params={"q": ["a", "b"]})
+    assert response.status_code == 200
+    assert response.json() == {"q": ["a", "b"]}
+
+if __name__ == "__main__":
+    try:
+        test_old()
+        print("test_old passed")
+        test_new()
+        print("test_new passed")
+    except Exception as e:
+        print(f"Error: {e}")
+        import traceback
+        traceback.print_exc()
+        exit(1)
