+from fastapi import FastAPI, Query
+from fastapi.testclient import TestClient
+from typing import List, Optional, Annotated
+import json
+
+app = FastAPI()
+
+@app.get("/new")
+def read_new(q: Annotated[list[str] | None, Query()] = None):
+    return {"q": q}
+
+def test_schema():
+    schema = app.openapi()
+    schema_dict = schema
+    
+    paths = schema_dict['paths']
+    new_q = paths['/new']['get']['parameters'][0]['schema']
+    
+    print(f"New Q schema: {new_q}")
+    
+    # For list[str] | None, we expect anyOf: [array, null]
+    assert 'anyOf' in new_q, "Schema should have anyOf"
+    assert len(new_q['anyOf']) == 2, f"Schema should have 2 types in anyOf, got {len(new_q['anyOf'])}"
+
+if __name__ == "__main__":
+    try:
+        test_schema()
+        print("test_schema passed")
+    except Exception as e:
+        print(f"Error: {e}")
+        import traceback
+        traceback.print_exc()
+        exit(1)
