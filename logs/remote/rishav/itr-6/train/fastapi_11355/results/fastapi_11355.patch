+from __future__ import annotations
+from typing import List, Any, Dict, get_type_hints
+import inspect
+from fastapi.dependencies.utils import get_typed_annotation, get_typed_signature
+
+def root(q: List[str] = ["foo", "bar"]):
+    return {"q": q}
+
+def test_type():
+    sig = get_typed_signature(root)
+    q_param = sig.parameters['q']
+    print(f"Annotation: {q_param.annotation}")
+    print(f"Type: {type(q_param.annotation)}")
+
+if __name__ == "__main__":
+    test_type()
