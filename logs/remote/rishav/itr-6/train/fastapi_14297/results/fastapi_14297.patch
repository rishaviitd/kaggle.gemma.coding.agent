@@ -0,0 +1,39 @@
+
+from typing import List, Optional, Union
+from pydantic.fields import FieldInfo
+from fastapi._compat.v2 import ModelField, serialize_sequence_value
+import sys
+
+def test_serialize_sequence_value_union_type():
+    # Case 3: list[bytes] | None (Python 3.10+)
+    if sys.version_info < (3, 10):
+        print("Skipping Python 3.10+ UnionType test")
+        return
+
+    annotation = list[bytes] | None
+    class MockFieldInfo:
+        def __init__(self, annotation):
+            self.annotation = annotation
+    
+    field_info = MockFieldInfo(annotation)
+    field = ModelField(field_info=field_info, name="test_field")
+    
+    value = [b"hello", b"world"]
+    try:
+        result = serialize_sequence_value(field=field, value=value)
+        print(f"Result: {result}")
+        assert isinstance(result, list)
+        assert result == [b"hello", b"world"]
+    except Exception as e:
+        print(f"Caught exception: {type(e).__name__}: {e}")
+        import traceback
+        traceback.print_exc()
+        raise e
+
+if __name__ == "__main__":
+    try:
+        test_serialize_sequence_value_union_type()
+        print("test_serialize_sequence_value_union_type passed!")
+    except Exception as e:
+        print(f"Test failed: {e}")
+        exit(1)
