@@ -0,0 +1,55 @@
+
+from typing import List, Optional, Union
+from pydantic.fields import FieldInfo
+from fastapi._compat.v2 import ModelField, serialize_sequence_value
+import pytest
+
+def test_serialize_sequence_value_optional_list():
+    # Case 1: Optional[List[bytes]]
+    annotation = Optional[List[bytes]]
+    # Mock FieldInfo since creating a real one might be complex
+    class MockFieldInfo:
+        def __init__(self, annotation):
+            self.annotation = annotation
+    
+    field_info = MockFieldInfo(annotation)
+    field = ModelField(field_info=field_info, name="test_field")
+    
+    value = [b"hello", b"world"]
+    try:
+        result = serialize_sequence_value(field=field, value=value)
+        print(f"Result: {result}")
+        assert isinstance(result, list)
+        assert result == [b"hello", b"world"]
+    except TypeError as e:
+        print(f"Caught expected TypeError: {e}")
+        raise e
+    except Exception as e:
+        print(f"Caught unexpected exception: {type(e).__name__}: {e}")
+        raise e
+
+def test_serialize_sequence_value_list():
+    # Case 2: List[bytes]
+    annotation = List[bytes]
+    class MockFieldInfo:
+        def __init__(self, annotation):
+            self.annotation = annotation
+    
+    field_info = MockFieldInfo(annotation)
+    field = ModelField(field_info=field_info, name="test_field")
+    
+    value = [b"hello", b"world"]
+    result = serialize_sequence_value(field=field, value=value)
+    assert result == [b"hello", b"world"]
+
+if __name__ == "__main__":
+    try:
+        test_serialize_sequence_value_optional_list()
+        print("test_serialize_sequence_value_optional_list passed!")
+        test_serialize_sequence_value_list()
+        print("test_serialize_sequence_value_list passed!")
+    except Exception as e:
+        print(f"Test failed: {e}")
+        import traceback
+        traceback.print_exc()
+        exit(1)
