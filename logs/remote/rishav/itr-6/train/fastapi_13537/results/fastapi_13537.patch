index 00000000..91ef32f3
--- /dev/null
+++ b/_check.py
@@ -0,0 +1,34 @@
+from fastapi import FastAPI, Form
+from fastapi.testclient import TestClient
+from typing import Optional
+
+app = FastAPI()
+
+@app.post("/test")
+async def test_endpoint(value: Optional[str] = Form(None)):
+    return {"value": value}
+
+client = TestClient(app)
+
+def test_empty_string_form_value():
+    # Sending an empty string for the optional form field
+    # According to the issue, this should be interpreted as None if the default is None
+    # But it might be causing a validation error or being set to ""
+    response = client.post("/test", data={"value": ""})
+    print(f"Response status code: {response.status_code}")
+    print(f"Response body: {response.json()}")
+    
+    # If it's working as intended (for HTML forms), an empty string should be None
+    # if the default is None.
+    assert response.status_code == 200
+    assert response.json()["value"] is None
+
+if __name__ == "__main__":
+    try:
+        test_empty_string_form_value()
+        print("Test passed!")
+    except Exception as e:
+        print(f"Test failed: {e}")
+        import traceback
+        traceback.print_exc()
+        exit(1)
