+import sys
+from unittest.mock import MagicMock, patch
+
+# Create a mock for pydantic and pydantic.version
+mock_pydantic = MagicMock()
+mock_pydantic.__version__ = "2.12.0"
+mock_version = MagicMock()
+mock_version.VERSION = "2.12.0"
+
+with patch.dict("sys.modules", {
+    "pydantic": mock_pydantic,
+    "pydantic.version": mock_version,
+    "pydantic.v1": MagicMock(),
+}):
+    with patch("sys.version_info", (3, 14, 0)):
+        import fastapi._compat.v1 as v1
+        
+        print(f"BaseModel: {v1.BaseModel}")
+        print(f"create_model: {v1.create_model}")
+        
+        assert v1.BaseModel.__name__ == "Dummy"
+        assert callable(v1.create_model)
+        print("Verification successful!")
