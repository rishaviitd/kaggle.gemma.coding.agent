index 00000000..64d33591
--- /dev/null
+++ b/_check.py
@@ -0,0 +1,19 @@
+from requests.utils import super_len
+
+def test_super_len_unicode():
+    s = "🚀"
+    print(f"String: {s}")
+    print(f"len(s): {len(s)}")
+    # UTF-8 encoding of 🚀 is 4 bytes: \xf0\x9f\x9a\x80
+    expected_len = len(s.encode('utf-8'))
+    print(f"Expected len (encoded): {expected_len}")
+    actual_len = super_len(s)
+    print(f"Actual super_len: {actual_len}")
+    assert actual_len == expected_len, f"Expected {expected_len}, got {actual_len}"
+
+if __name__ == "__main__":
+    try:
+        test_super_len_unicode()
+        print("Test passed!")
+    except AssertionError as e:
+        print(f"Test failed: {e}")
