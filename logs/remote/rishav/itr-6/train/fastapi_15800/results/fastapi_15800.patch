diff --git a/_verify_frontend.py b/_verify_frontend.py
new file mode 100644
index 000000000..724b25fb6
--- /dev/null
+++ b/_verify_frontend.py
@@ -0,0 +1,52 @@
+import os
+import shutil
+from fastapi import FastAPI, APIRouter
+from fastapi.testclient import TestClient
+
+def test_fastapi_frontend():
+    # Setup static directory
+    static_dir = "test_static_dir"
+    os.makedirs(static_dir, exist_ok=True)
+    with open(os.path.join(static_dir, "index.html"), "w") as f:
+        f.write("Hello Frontend")
+
+    try:
+        app = FastAPI()
+        app.frontend("/", directory=static_dir)
+        client = TestClient(app)
+        response = client.get("/")
+        assert response.status_code == 200
+        assert response.text == "Hello Frontend"
+        print("FastAPI.frontend: PASSED")
+    except Exception as e:
+        print(f"FastAPI.frontend: FAILED - {e}")
+        raise e
+    finally:
+        shutil.rmtree(static_dir)
+
+def test_apirouter_frontend():
+    # Setup static directory
+    static_dir = "test_router_static_dir"
+    os.makedirs(static_dir, exist_ok=True)
+    with open(os.path.join(static_dir, "index.html"), "w") as f:
+        f.write("Hello Router Frontend")
+
+    try:
+        app = FastAPI()
+        router = APIRouter()
+        router.frontend("/static", directory=static_dir)
+        app.include_router(router)
+        client = TestClient(app)
+        response = client.get("/static")
+        assert response.status_code == 200
+        assert response.text == "Hello Router Frontend"
+        print("APIRouter.frontend: PASSED")
+    except Exception as e:
+        print(f"APIRouter.frontend: FAILED - {e}")
+        raise e
+    finally:
+        shutil.rmtree(static_dir)
+
+if __name__ == "__main__":
+    test_fastapi_frontend()
+    test_apirouter_frontend()
