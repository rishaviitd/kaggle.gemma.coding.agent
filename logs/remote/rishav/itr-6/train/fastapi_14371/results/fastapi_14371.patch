diff --git a/_check.py b/_check.py
new file mode 100644
index 00000000..04361ca9
--- /dev/null
+++ b/_check.py
@@ -0,0 +1,27 @@
+from fastapi import FastAPI, Query
+from pydantic import Field
+from fastapi.testclient import TestClient
+from typing import Annotated
+
+app = FastAPI()
+
+@app.get("/")
+def read_root(q: Annotated[str, Query(validation_alias="my_alias")] = "default"):
+    return {"q": q}
+
+client = TestClient(app)
+
+def test_validation_alias():
+    response = client.get("/?my_alias=hello")
+    print(f"Response: {response.json()}")
+    assert response.json() == {"q": "hello"}
+
+if __name__ == "__main__":
+    try:
+        test_validation_alias()
+        print("Test passed!")
+    except Exception as e:
+        print(f"Test failed: {e}")
+        import traceback
+        traceback.print_exc()
+        exit(1)
