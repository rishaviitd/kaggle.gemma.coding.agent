diff --git a/_check.py b/_check.py
new file mode 100644
index 00000000..0dc223e8
--- /dev/null
+++ b/_check.py
@@ -0,0 +1,46 @@
+from fastapi import FastAPI, Body
+from typing import Literal, Union, Annotated
+from pydantic import BaseModel, Field
+from fastapi.testclient import TestClient
+
+app = FastAPI()
+
+class Cat(BaseModel):
+    meow: bool
+    kind: Literal["cat"]
+
+class Dog(BaseModel):
+    bark: bool
+    kind: Literal["dog"]
+
+CatDog = Annotated[Union[Cat, Dog], Field(discriminator="kind")]
+
+@app.post("/test")
+async def test_endpoint(data: Annotated[CatDog, Body()]):
+    return data
+
+client = TestClient(app)
+
+def test_cat():
+    response = client.post("/test", json={"kind": "cat", "meow": True})
+    assert response.status_code == 200
+    assert response.json() == {"kind": "cat", "meow": True}
+
+def test_dog():
+    response = client.post("/test", json={"kind": "dog", "bark": True})
+    assert response.status_code == 200
+    assert response.json() == {"kind": "dog", "bark": True}
+
+def test_invalid():
+    response = client.post("/test", json={"kind": "bird", "fly": True})
+    assert response.status_code == 422
+
+if __name__ == "__main__":
+    try:
+        test_cat()
+        test_dog()
+        test_invalid()
+        print("All tests passed!")
+    except Exception as e:
+        print(f"Test failed: {e}")
+        raise e
