diff --git a/_check.py b/_check.py
new file mode 100644
index 000000000..e58e58151
--- /dev/null
+++ b/_check.py
@@ -0,0 +1,34 @@
+
+from fastapi import FastAPI, APIRouter
+from fastapi.staticfiles import StaticFiles
+
+def test_fastapi_frontend():
+    app = FastAPI()
+    app.frontend("/", directory="static")
+    # Check if the mount is present
+    # FastAPI.mount adds to app.routes
+    # We expect a Mount object in app.routes
+    from starlette.routing import Mount
+    mounts = [route for route in app.routes if isinstance(route, Mount)]
+    assert len(mounts) > 0
+    assert mounts[0].path == "/"
+    assert mounts[0].app.__class__.__name__ == "StaticFiles"
+
+def test_apirouter_frontend():
+    router = APIRouter()
+    router.frontend("/static", directory="static")
+    from starlette.routing import Mount
+    mounts = [route for route in router.routes if isinstance(route, Mount)]
+    assert len(mounts) > 0
+    assert mounts[0].path == "/static"
+    assert mounts[0].app.__class__.__name__ == "StaticFiles"
+
+if __name__ == "__main__":
+    try:
+        test_fastapi_frontend()
+        print("FastAPI frontend test passed!")
+        test_apirouter_frontend()
+        print("APIRouter frontend test passed!")
+    except Exception as e:
+        print(f"Test failed: {e}")
+        raise e
