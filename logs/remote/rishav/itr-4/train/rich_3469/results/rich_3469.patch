+
+from rich.text import Text
+
+def test_tabs():
+    tab_size = 8
+    test_cases = [
+        ("a\t", 1),
+        ("ab\t", 2),
+        ("abcdefg\t", 7),
+        ("abcdefgh\t", 8),
+        ("\t", 0),
+        ("あ\t", 2), # 全角
+    ]
+    
+    for text_str, pos in test_cases:
+        t = Text(text_str)
+        t.expand_tabs(tab_size)
+        result = t.plain
+        print(f"'{text_str}' (pos={pos}) -> '{result}' (len={len(result)})")
+
+if __name__ == "__main__":
+    test_tabs()
