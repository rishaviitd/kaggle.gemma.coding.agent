diff --git a/fix_indent.py b/fix_indent.py
new file mode 100644
index 00000000..89f3b45d
--- /dev/null
+++ b/fix_indent.py
@@ -0,0 +1,38 @@
+from pathlib import Path
+p = Path('fastapi/_compat/shared.py')
+t = p.read_text()
+
+old_text = """    )  # pyright: ignore[reportAttributeAccessIssue]
+
+
+    def is_typealiastype(obj: Any) -> bool:
+        return isinstance(obj, getattr(types, "TypeAliasType", type(None)))
+
+
+    def get_typealias_value(obj: Any) -> Any:
+        while is_typealiastype(obj):
+            obj = getattr(obj, "__value__", obj)
+        return obj
+
+
+    PYDANTIC_VERSION_MINOR_TUPLE = tuple(int(x) for x in PYDANTIC_VERSION.split(".")[:2])"""
+
+new_text = """    )  # pyright: ignore[reportAttributeAccessIssue]
+
+
+PYDANTIC_VERSION_MINOR_TUPLE = tuple(int(x) for x in PYDANTIC_VERSION.split(".")[:2])
+
+
+def is_typealiastype(obj: Any) -> bool:
+    return isinstance(obj, getattr(types, "TypeAliasType", type(None)))
+
+
+def get_typealias_value(obj: Any) -> Any:
+    while is_typealiastype(obj):
+        obj = getattr(obj, "__value__", obj)
+    return obj"""
+
+if old_text in t:
+    p.write_text(t.replace(old_text, new_text))
+else:
+    print("Old text not found")
