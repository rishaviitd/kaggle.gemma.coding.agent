new file mode 100644
index 00000000..f243846c
--- /dev/null
+++ b/_check.py
@@ -0,0 +1,45 @@
+from unittest.mock import patch, MagicMock
+from fastapi._compat import shared
+
+def test_get_typealias_value_called():
+    with patch('fastapi._compat.shared.get_typealias_value') as mock_get_value:
+        mock_get_value.return_value = list[int]
+        
+        shared.field_annotation_is_sequence(list[int])
+        assert mock_get_value.called
+        
+        mock_get_value.reset_mock()
+        shared.field_annotation_is_complex(list[int])
+        assert mock_get_value.called
+        
+        mock_get_value.reset_mock()
+        shared.field_annotation_is_scalar_sequence(list[int])
+        assert mock_get_value.called
+        
+        mock_get_value.reset_mock()
+        shared.is_bytes_or_nonable_bytes_annotation(bytes)
+        assert mock_get_value.called
+        
+        mock_get_value.reset_mock()
+        shared.is_uploadfile_or_nonable_uploadfile_annotation(None)
+        assert mock_get_value.called
+        
+        mock_get_value.reset_mock()
+        shared.is_bytes_sequence_annotation(list[bytes])
+        assert mock_get_value.called
+        
+        mock_get_value.reset_mock()
+        shared.is_uploadfile_sequence_annotation(list)
+        assert mock_get_value.called
+        
+        mock_get_value.reset_mock()
+        shared.annotation_is_pydantic_v1(None)
+        assert mock_get_value.called
+
+if __name__ == "__main__":
+    try:
+        test_get_typealias_value_called()
+        print("All tests passed!")
+    except Exception as e:
+        print(f"Test failed: {e}")
+        exit(1)
