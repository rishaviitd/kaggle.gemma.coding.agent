+from typing import Annotated, Union
+from pydantic import Field, TypeAdapter
+from pydantic.fields import FieldInfo
+
+class MyModel:
+    pass
+
+# Simulate the situation
+annotation = Annotated[Union[int, str], Field(discriminator='type')]
+metadata = (Field(discriminator='type'),)
+field_info = FieldInfo(annotation=annotation)
+
+annotated_args = (
+    annotation,
+    *metadata,
+    field_info,
+)
+
+print(f"annotated_args: {annotated_args}")
+try:
+    ta = TypeAdapter(Annotated[annotated_args])
+    print(f"TypeAdapter created: {ta}")
+except Exception as e:
+    print(f"Error creating TypeAdapter: {e}")
+
+# What it probably should be:
+# Since we can't do Annotated[*annotated_args], we might need to use something else.
+# But wait, if annotation is already Annotated, we might be nesting them.
