@@ -0,0 +1,21 @@
+from fastapi import FastAPI, Depends
+from fastapi.security import HTTPBearer
+import json
+
+app = FastAPI(dependencies=[Depends(HTTPBearer())])
+
+@app.get("/")
+def read_root():
+    return {"hello": "World"}
+
+openapi_schema = app.openapi()
+security_schemes = openapi_schema.get("components", {}).get("securitySchemes", {})
+print(f"Security Schemes: {security_schemes}")
+
+# The root path should have security requirements
+root_path = openapi_schema.get("paths", {}).get("/", {}).get("get", {})
+security_requirements = root_path.get("security", [])
+print(f"Root path security: {security_requirements}")
+
+assert len(security_schemes) > 0, "Security schemes should not be empty"
+assert len(security_requirements) > 0, "Root path should have security requirements"
