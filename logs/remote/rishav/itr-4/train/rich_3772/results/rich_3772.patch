+from rich.traceback import install
+from rich.console import Console
+import sys
+
+install(show_locals=True)
+
+class BadDict:
+    def __getitem__(self, key):
+        raise RuntimeError("Error in getitem")
+    def __iter__(self):
+        yield "key"
+    def __len__(self):
+        return 1
+    def items(self):
+        # This will be called by Pretty._traverse
+        raise RuntimeError("Error in items")
+
+def trigger_error():
+    bad = BadDict()
+    # This will raise ZeroDivisionError, and the traceback will contain 'bad' in locals
+    1 / 0
+
+if __name__ == "__main__":
+    trigger_error()
