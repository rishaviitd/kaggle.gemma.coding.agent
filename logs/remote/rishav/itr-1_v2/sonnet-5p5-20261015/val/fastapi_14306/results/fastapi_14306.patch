+def _extract_endpoint_context(func: Any, path_label: str) -> Dict[str, Any]:
+    """Extract file, line, function name and route label for error messages.
+
+    Computed once per route (not per request) to avoid runtime overhead.
+    """
+    ctx: Dict[str, Any] = {"path": path_label}
+    try:
+        target = inspect.unwrap(func)
+        code = getattr(target, "__code__", None)
+        if code is None:
+            code = getattr(getattr(target, "__call__", None), "__code__", None)
+        if code is not None:
+            ctx["file"] = code.co_filename
+            ctx["line"] = code.co_firstlineno
+            ctx["function"] = getattr(target, "__name__", code.co_name)
+    except Exception:  # pragma: no cover
+        pass
+    return ctx
+
