 class ValidationException(Exception):
-    def __init__(self, errors: Sequence[Any]) -> None:
+    def __init__(
+        self,
+        errors: Sequence[Any],
+        *,
+        _endpoint_context: Optional[str] = None,
+    ) -> None:
         self._errors = errors
+        # Traceback-like context (file, line, function, HTTP method and route)
+        # of the endpoint that raised this validation error, used to build a
+        # more helpful message in __str__.
+        self._endpoint_context = _endpoint_context
 
     def errors(self) -> Sequence[Any]:
         return self._errors
 
+    def __str__(self) -> str:
+        message = (
+            f"{len(self._errors)} validation error"
+            f"{'s' if len(self._errors) != 1 else ''}:\n"
+        )
+        for err in self._errors:
+            message += f"  {err}\n"
+        if self._endpoint_context:
+            message += f"\n{self._endpoint_context}"
+        return message
+
 
