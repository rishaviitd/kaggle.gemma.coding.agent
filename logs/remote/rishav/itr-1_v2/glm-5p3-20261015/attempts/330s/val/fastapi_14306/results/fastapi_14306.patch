+@functools.lru_cache(maxsize=None)
+def _get_endpoint_context(
+    endpoint: Callable[..., Any], method: str, route: str
+) -> str:
+    """
+    Build a traceback-like context string pointing at the endpoint (path
+    operation function) that raised a validation error.
+
+    The result is cached per (endpoint, method, route) so that the (possibly
+    expensive) introspection is only done once per endpoint.
+    """
+    function_name = getattr(endpoint, "__name__", None) or repr(endpoint)
+    code = getattr(endpoint, "__code__", None)
+    if code is not None:
+        filepath = code.co_filename
+        line_number = code.co_firstlineno
+    else:
+        filepath = "<unknown>"
+        line_number = 0
+    return (
+        f'  File "{filepath}", line {line_number}, in {function_name}\n'
+        f"    {method} {route}"
+    )
+
