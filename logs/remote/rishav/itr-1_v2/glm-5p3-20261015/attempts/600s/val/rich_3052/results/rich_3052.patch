diff --git a/tests/test_prompt.py b/tests/test_prompt.py
index 9a41cc39..8b063abf 100644
--- a/tests/test_prompt.py
+++ b/tests/test_prompt.py
@@ -93,3 +93,40 @@ def test_prompt_confirm_default():
     output = console.file.getvalue()
     print(repr(output))
     assert output == expected
+
+def test_prompt_case_insensitive_choices():
+    INPUT = "paul\n"
+    console = Console(file=io.StringIO())
+    name = Prompt.ask(
+        "Enter your name",
+        console=console,
+        choices=["Paul", "Jessica", "Duncan"],
+        default="Paul",
+        case_sensitive=False,
+        stream=io.StringIO(INPUT),
+    )
+    assert name == "paul"
+    expected = "Enter your name [Paul/Jessica/Duncan] (Paul): "
+    output = console.file.getvalue()
+    print(repr(output))
+    assert output == expected
+
+def test_prompt_case_sensitive_choices():
+    INPUT = "paul\nPaul\n"
+    console = Console(file=io.StringIO())
+    name = Prompt.ask(
+        "Enter your name",
+        console=console,
+        choices=["Paul", "Jessica", "Duncan"],
+        default="Paul",
+        stream=io.StringIO(INPUT),
+    )
+    assert name == "Paul"
+    expected = (
+        "Enter your name [Paul/Jessica/Duncan] (Paul): "
+        "Please select one of the available options\n"
+        "Enter your name [Paul/Jessica/Duncan] (Paul): "
+    )
+    output = console.file.getvalue()
+    print(repr(output))
+    assert output == expected
