+def _get_endpoint_context(
+    *,
+    call: Callable[..., Any],
+    method: Optional[str] = None,
+    path: Optional[str] = None,
+) -> Optional[str]:
+    endpoint = inspect.unwrap(call)
+    try:
+        code = endpoint.__code__
+    except AttributeError:
+        # Not a plain function (e.g. a callable class instance), there's no
+        # useful source location to report.
+        return None
+    name = get_name(endpoint)
+    context = f'  File "{code.co_filename}", line {code.co_firstlineno}, in {name}'
+    if method:
+        context += f"\n    {method} {path}"
+    return context
+
