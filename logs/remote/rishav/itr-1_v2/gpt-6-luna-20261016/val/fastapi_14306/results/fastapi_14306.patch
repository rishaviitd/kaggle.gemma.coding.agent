+    try:
+        _, line_number = inspect.getsourcelines(endpoint)
+    except (OSError, TypeError):
+        line_number = 0
+    return f'File "{source_file}", line {line_number}, in {get_name(endpoint)}'
+
+
+def _get_endpoint_context(
+    endpoint: Callable[..., Any], path: str, methods: Optional[Set[str]] = None
+) -> str:
+    source_context = _get_endpoint_source_context(endpoint)
+    if methods:
+        return f"{source_context} ({', '.join(sorted(methods))} {path})"
+    return f"{source_context} ({path})"
+
