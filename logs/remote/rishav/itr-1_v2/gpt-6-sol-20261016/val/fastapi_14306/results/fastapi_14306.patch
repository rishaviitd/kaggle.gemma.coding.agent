+def _get_endpoint_context(endpoint: Callable[..., Any]) -> str:
+    """Cache endpoint source information at route creation, not on each request."""
+    try:
+        source = inspect.unwrap(endpoint)
+    except ValueError:
+        source = endpoint
+    name = getattr(source, "__name__", type(source).__name__)
+    try:
+        filename = inspect.getsourcefile(source)
+        line = inspect.getsourcelines(source)[1]
+    except (OSError, TypeError):
+        return f"in {name}"
+    return f'File "{filename}", line {line}, in {name}' if filename else f"in {name}"
+
