+#!/usr/bin/env python3
+"""Test to reproduce the double-width character disappearing bug."""
+
+from rich._wrap import divide_line
+from rich.console import Console
+from io import StringIO
+
+# Test case 1: A line with double-width characters that need wrapping
+text1 = "わさび"  # 3 double-width chars = 6 cells total
+width = 4  # Can fit 2 double-width chars per line
+
+print("Test 1: Wrapping double-width characters")
+print(f"Text: '{text1}' (6 cells)")
+print(f"Width: {width}")
+divides = divide_line(text1, width, fold=True)
+print(f"Divides: {divides}")
+
+# Split based on divides
+if not divides:
+    lines = [text1]
+else:
+    lines = []
+    prev = 0
+    for div in divides:
+        lines.append(text1[prev:div])
+        prev = div
+    lines.append(text1[prev:])
+
+print(f"Lines: {lines}")
+for i, line in enumerate(lines):
+    print(f"  Line {i}: '{line}'")
+
+# Test with Console
+print("\n\nTest 2: Using Console to wrap")
+console = Console(width=4, file=StringIO(), legacy_windows=False)
+console.print("わさび")
+output = console.file.getvalue()
+print("Console output:")
+print(repr(output))
+print(output)
+
+# Test case 3: Mixed single and double-width
+text3 = "aわb"
+width3 = 2
+print(f"\n\nTest 3: Mixed single and double-width")
+print(f"Text: '{text3}' (4 cells total: a=1, わ=2, b=1)")
+print(f"Width: {width3}")
+divides3 = divide_line(text3, width3, fold=True)
+print(f"Divides: {divides3}")
+
+# Split based on divides
+if not divides3:
+    lines3 = [text3]
+else:
+    lines3 = []
+    prev = 0
+    for div in divides3:
+        lines3.append(text3[prev:div])
+        prev = div
+    lines3.append(text3[prev:])
+
+print(f"Lines: {lines3}")
+for i, line in enumerate(lines3):
+    print(f"  Line {i}: '{line}'")
