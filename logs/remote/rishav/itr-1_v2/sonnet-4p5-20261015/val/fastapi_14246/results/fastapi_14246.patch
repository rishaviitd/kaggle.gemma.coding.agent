+"""Test script to reproduce the nested model schema separation bug."""
+from fastapi import FastAPI
+from pydantic import BaseModel
+
+app = FastAPI(separate_input_output_schemas=True)
+
+
+class NestedModel(BaseModel):
+    value: str
+
+
+class MainModel(BaseModel):
+    nested: NestedModel
+
+
+@app.post("/test")
+def test_endpoint(data: MainModel) -> MainModel:
+    return data
+
+
+# Get the OpenAPI schema
+schema = app.openapi()
+
+# Print the components/schemas
+import json
+print("Components/Schemas:")
+print(json.dumps(schema.get("components", {}).get("schemas", {}), indent=2))
+
+# Check if we have the expected schemas
+schemas = schema.get("components", {}).get("schemas", {})
+expected_schemas = [
+    "MainModel-Input",
+    "MainModel-Output", 
+    "NestedModel-Input",
+    "NestedModel-Output"
+]
+
+print("\n\nSchema names present:")
+for name in sorted(schemas.keys()):
+    print(f"  - {name}")
+
+print("\n\nExpected schemas:")
+for name in expected_schemas:
+    present = name in schemas
+    print(f"  - {name}: {'✓' if present else '✗ MISSING'}")
+
+# Check for references in MainModel-Input and MainModel-Output
+print("\n\nReferences in MainModel schemas:")
+for model_name in ["MainModel-Input", "MainModel-Output"]:
+    if model_name in schemas:
+        nested_ref = schemas[model_name].get("properties", {}).get("nested", {}).get("$ref", "N/A")
+        print(f"  {model_name}.nested.$ref: {nested_ref}")
