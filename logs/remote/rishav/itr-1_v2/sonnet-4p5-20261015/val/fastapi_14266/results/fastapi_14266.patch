diff --git a/test_debug.py b/test_debug.py
new file mode 100644
index 00000000..fce1a1ed
--- /dev/null
+++ b/test_debug.py
@@ -0,0 +1,26 @@
+from fastapi import FastAPI, APIRouter, Depends
+from fastapi.security import HTTPBearer
+
+security_scheme = HTTPBearer()
+
+router = APIRouter(dependencies=[Depends(security_scheme)])
+
+@router.get("/test")
+def test_endpoint():
+    return {"message": "Hello World"}
+
+print("Router dependencies:", router.dependencies)
+print("Route dependencies before include:")
+for route in router.routes:
+    print(f"  {route.path}: {route.dependencies}")
+
+app = FastAPI()
+app.include_router(router)
+
+print("\nApp routes after include:")
+for route in app.routes:
+    if hasattr(route, 'dependencies'):
+        print(f"  {route.path}: {route.dependencies}")
+        if hasattr(route, 'dependant'):
+            print(f"    dependant.dependencies: {route.dependant.dependencies}")
+            print(f"    dependant.security_requirements: {route.dependant.security_requirements}")
diff --git a/test_fix.py b/test_fix.py
new file mode 100644
index 00000000..a4428897
--- /dev/null
+++ b/test_fix.py
@@ -0,0 +1,35 @@
+from fastapi import FastAPI, APIRouter, Depends
+from fastapi.security import HTTPBearer
+
+security_scheme = HTTPBearer()
+
+router = APIRouter(dependencies=[Depends(security_scheme)])
+
+@router.get("/test")
+def test_endpoint():
+    return {"message": "Hello World"}
+
+app = FastAPI()
+app.include_router(router)
+
+# Check if the security scheme is in the OpenAPI schema
+openapi_schema = app.openapi()
+
+print("OpenAPI Schema components.securitySchemes:")
+if 'components' in openapi_schema and 'securitySchemes' in openapi_schema['components']:
+    print(openapi_schema['components']['securitySchemes'])
+    print("\n✅ SUCCESS: Security schemes are present!")
+else:
+    print("None")
+    print("\n❌ FAIL: Security schemes are missing!")
+
+print("\nPath /test security requirements:")
+if 'paths' in openapi_schema and '/test' in openapi_schema['paths']:
+    path_info = openapi_schema['paths']['/test']
+    if 'get' in path_info:
+        security = path_info['get'].get('security', [])
+        print(security)
+        if security:
+            print("✅ Security requirements are present on the endpoint!")
+        else:
+            print("❌ Security requirements are missing on the endpoint!")
diff --git a/test_security_issue.py b/test_security_issue.py
new file mode 100644
index 00000000..3c5b6289
--- /dev/null
+++ b/test_security_issue.py
@@ -0,0 +1,50 @@
+"""Test for the security scheme issue at top-level app"""
+from fastapi import FastAPI, Depends, APIRouter
+from fastapi.security import HTTPBearer
+import json
+
+# Create security scheme
+security_scheme = HTTPBearer()
+
+# Create the main app with security dependency at top level
+app = FastAPI()
+
+# Create a router
+router = APIRouter()
+
+@router.get("/items/")
+def read_items():
+    return {"items": []}
+
+# Include router in app
+app.include_router(router)
+
+# Add a top-level dependency with security
+@app.get("/users/", dependencies=[Depends(security_scheme)])
+def read_users():
+    return {"users": []}
+
+# Generate OpenAPI schema
+openapi_schema = app.openapi()
+
+# Print the schema to see if security schemes are included
+print("=" * 80)
+print("OpenAPI Schema:")
+print("=" * 80)
+print(json.dumps(openapi_schema, indent=2))
+
+# Check if security schemes are present
+if "components" in openapi_schema and "securitySchemes" in openapi_schema["components"]:
+    print("\n" + "=" * 80)
+    print("✓ Security schemes found in components:")
+    print(json.dumps(openapi_schema["components"]["securitySchemes"], indent=2))
+else:
+    print("\n" + "=" * 80)
+    print("✗ Security schemes NOT found in components!")
+    
+# Check if security is applied to the endpoint
+if "/users/" in openapi_schema["paths"]:
+    users_path = openapi_schema["paths"]["/users/"]
+    print("\n" + "=" * 80)
+    print("/users/ path details:")
+    print(json.dumps(users_path, indent=2))
