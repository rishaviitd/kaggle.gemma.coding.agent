diff --git a/reproduce_issue.py b/reproduce_issue.py
new file mode 100644
index 00000000..a4f62f3f
--- /dev/null
+++ b/reproduce_issue.py
@@ -0,0 +1,17 @@
+
+from __future__ import annotations
+import inspect
+from fastapi.dependencies.utils import get_typed_signature, get_typed_return_annotation
+from typing import List
+
+def my_dependency(q: List[str]):
+    return q
+
+print(f"Signature: {get_typed_signature(my_dependency)}")
+print(f"Return Annotation: {get_typed_return_annotation(my_dependency)}")
+
+# Check if the annotation is actually a list
+sig = get_typed_signature(my_dependency)
+param = sig.parameters['q']
+print(f"Param q annotation: {param.annotation}")
+print(f"Is list: {param.annotation is List[str]}")
