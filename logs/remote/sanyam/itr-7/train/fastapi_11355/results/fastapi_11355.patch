new file mode 100644
index 00000000..b79fdc0d
--- /dev/null
+++ b/repro_hints.py
@@ -0,0 +1,37 @@
+
+from __future__ import annotations
+import inspect
+from typing import ForwardRef, Dict, Any, get_type_hints
+from fastapi.dependencies.utils import get_typed_signature
+
+class Item:
+    pass
+
+def func(item: Item):
+    return item
+
+def test_stringified_annotation():
+    print(f"Annotation: {func.__annotations__['item']} (type: {type(func.__annotations__['item'])})")
+    
+    # Using get_type_hints
+    try:
+        hints = get_type_hints(func)
+        print(f"Hints: {hints}")
+        annotation = hints['item']
+    except Exception as e:
+        print(f"get_type_hints failed: {e}")
+        annotation = None
+    
+    print(f"Resolved Annotation: {annotation} (type: {type(annotation)})")
+    
+    assert annotation is Item
+
+if __name__ == "__main__":
+    try:
+        test_stringified_annotation()
+        print("SUCCESS")
+    except Exception as e:
+        print(f"FAILURE: {e}")
+        import traceback
+        traceback.print_exc()
+        exit(1)
