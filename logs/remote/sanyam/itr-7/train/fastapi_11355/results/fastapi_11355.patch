diff --git a/repro.py b/repro.py
new file mode 100644
index 00000000..ba948432
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,34 @@
+
+from __future__ import annotations
+import inspect
+from typing import ForwardRef, Dict, Any
+from fastapi.dependencies.utils import get_typed_annotation, get_typed_signature
+
+class Item:
+    pass
+
+def func(item: Item):
+    pass
+
+def test_stringified_annotation():
+    print(f"Annotation: {func.__annotations__['item']} (type: {type(func.__annotations__['item'])})")
+    
+    unwrapped = inspect.unwrap(func)
+    globalns = getattr(unwrapped, "__globals__", {})
+    print(f"Item in globalns: {'Item' in globalns}")
+    
+    sig = get_typed_signature(func)
+    param = sig.parameters['item']
+    print(f"Typed Annotation: {param.annotation} (type: {type(param.annotation)})")
+    
+    assert param.annotation is Item
+
+if __name__ == "__main__":
+    try:
+        test_stringified_annotation()
+        print("SUCCESS")
+    except Exception as e:
+        print(f"FAILURE: {e}")
+        import traceback
+        traceback.print_exc()
+        exit(1)
