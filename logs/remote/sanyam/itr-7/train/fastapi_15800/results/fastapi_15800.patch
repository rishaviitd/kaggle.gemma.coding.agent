diff --git a/reproduction_script.py b/reproduction_script.py
new file mode 100644
index 000000000..de5cee6f1
--- /dev/null
+++ b/reproduction_script.py
@@ -0,0 +1,54 @@
+
+from fastapi import FastAPI, APIRouter
+from starlette.staticfiles import StaticFiles
+import pytest
+from fastapi.testclient import TestClient
+import os
+import shutil
+
+def test_fastapi_frontend():
+    app = FastAPI()
+    # Create a dummy directory for frontend
+    frontend_dir = "test_frontend_dir"
+    os.makedirs(frontend_dir, exist_ok=True)
+    with open(os.path.join(frontend_dir, "index.html"), "w") as f:
+        f.write("Hello Frontend")
+
+    try:
+        app.frontend("/", directory=frontend_dir)
+        client = TestClient(app)
+        response = client.get("/")
+        print(f"Status code: {response.status_code}, Text: {response.text}")
+        assert response.status_code == 200
+        assert response.text == "Hello Frontend"
+    finally:
+        shutil.rmtree(frontend_dir)
+
+def test_apirouter_frontend():
+    app = FastAPI()
+    router = APIRouter()
+    # Create a dummy directory for frontend
+    frontend_dir = "test_router_frontend_dir"
+    os.makedirs(frontend_dir, exist_ok=True)
+    with open(os.path.join(frontend_dir, "index.html"), "w") as f:
+        f.write("Hello Router Frontend")
+
+    try:
+        router.frontend("/static", directory=frontend_dir)
+        app.include_router(router)
+        client = TestClient(app)
+        response = client.get("/static")
+        assert response.status_code == 200
+        assert response.text == "Hello Router Frontend"
+    finally:
+        shutil.rmtree(frontend_dir)
+
+if __name__ == "__main__":
+    try:
+        test_fastapi_frontend()
+        print("FastAPI frontend test passed!")
+        test_apirouter_frontend()
+        print("APIRouter frontend test passed!")
+    except Exception as e:
+        print(f"Test failed: {e}")
+        raise e
