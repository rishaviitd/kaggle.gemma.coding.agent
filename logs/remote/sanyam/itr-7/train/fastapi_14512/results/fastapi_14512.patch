+++ b/repro.py
@@ -0,0 +1,57 @@
+
+from fastapi import FastAPI, Body
+from fastapi.testclient import TestClient
+from pydantic import BaseModel, Field
+from typing import Union, Annotated, Literal
+
+app = FastAPI()
+
+class ModelA(BaseModel):
+    x: int
+
+class ModelB(BaseModel):
+    kind: Literal["B"]
+    x: int
+
+# Case 1: Discriminator in Body()
+@app.post("/body-disc")
+async def body_disc(
+    data: Annotated[Union[ModelA, ModelB], Body(discriminator="kind")]
+):
+    return {"type": data.__class__.__name__}
+
+# Case 2: Discriminator in Field() inside Annotated
+@app.post("/field-disc")
+async def field_disc(
+    data: Annotated[Annotated[Union[ModelA, ModelB], Field(discriminator="kind")], Body()]
+):
+    return {"type": data.__class__.__name__}
+
+client = TestClient(app)
+
+def test_body_disc():
+    # Input matches both, but discriminator says it should be ModelB
+    resp = client.post("/body-disc", json={"kind": "B", "x": 1})
+    assert resp.status_code == 200
+    assert resp.json()["type"] == "ModelB"
+    print("test_body_disc passed")
+
+def test_field_disc():
+    # Input matches both, but discriminator says it should be ModelB
+    resp = client.post("/field-disc", json={"kind": "B", "x": 1})
+    assert resp.status_code == 200
+    # If discriminator is working, it should be ModelB
+    # If discriminator is ignored, it will be ModelA (because it's first in Union)
+    assert resp.json()["type"] == "ModelB"
+    print("test_field_disc passed")
+
+if __name__ == "__main__":
+    try:
+        test_body_disc()
+    except Exception as e:
+        print(f"test_body_disc failed: {e}")
+
+    try:
+        test_field_disc()
+    except Exception as e:
+        print(f"test_field_disc failed: {e}")
