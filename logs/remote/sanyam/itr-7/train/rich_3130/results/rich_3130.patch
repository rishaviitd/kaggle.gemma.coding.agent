index 00000000..90a8a75d
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,27 @@
+
+from rich.console import Console
+from rich.markdown import Markdown
+from io import StringIO
+
+def test_markdown_table_inline_styles():
+    console = Console(file=StringIO(), force_terminal=True)
+    markdown_text = "| Header 1 | Header 2 |\n| --- | --- |\n| This is [a link](https://google.com) and some text | Cell 2 |"
+    md = Markdown(markdown_text)
+    console.print(md)
+    output = console.file.getvalue()
+    
+    print(f"Output: {output!r}")
+    
+    # We expect all parts of the text to be present
+    assert "This is" in output
+    assert "a link" in output
+    assert "and some text" in output
+
+if __name__ == "__main__":
+    try:
+        test_markdown_table_inline_styles()
+        print("Test passed!")
+    except AssertionError as e:
+        print(f"Test failed: {e}")
+    except Exception as e:
+        print(f"An error occurred: {e}")
