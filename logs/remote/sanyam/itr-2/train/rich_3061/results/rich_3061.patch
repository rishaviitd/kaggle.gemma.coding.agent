+from rich.text import Text, Span
+
+def test_expand_tabs_style():
+    # Base style white, tab style red
+    t = Text("A\tB", style="white")
+    t._spans.append(Span(1, 2, "red"))
+    
+    t.expand_tabs(tab_size=4)
+    
+    # "A" (0) - white
+    # " " (1) - red (from part)
+    # " " (2) - red (from expanded spaces)
+    # " " (3) - red (from expanded spaces)
+    # "B" (4) - white
+    
+    # The result text should be "A   B"
+    assert t.plain == "A   B"
+    
+    # Check spans. 
+    # The tab was at index 1. 
+    # In the expanded text, the tab and its extra spaces should be red.
+    # The tab was at index 1, and it expanded to 3 spaces.
+    # So indices 1, 2, 3 should be red.
+    
+    # Let's see what spans we have.
+    print(f"Spans: {t._spans}")
+    
+    # We expect a span covering 1 to 4 with style "red" (or similar)
+    # Note: the base style is "white".
+    
+    found_red_span = False
+    for span in t._spans:
+        if span.style == "red" and span.start <= 1 and span.end >= 4:
+            found_red_span = True
+            break
+    
+    assert found_red_span, f"Expected red span for expanded tab, got {t._spans}"
+
+if __name__ == "__main__":
+    try:
+        test_expand_tabs_style()
+        print("Test passed!")
+    except AssertionError as e:
+        print(f"Test failed: {e}")
+        exit(1)
