new file mode 100644
index 00000000..e13ea06e
--- /dev/null
+++ b/_test_protocol.py
@@ -0,0 +1,18 @@
+
+from typing import Protocol, runtime_checkable
+
+@runtime_checkable
+class SupportsRead(Protocol):
+    def read(self, length: int = ...):
+        ...
+
+class MockRead:
+    def read(self, length: int = 10):
+        return b"data"
+
+class MockNoRead:
+    def write(self, data):
+        pass
+
+print(f"MockRead is SupportsRead: {isinstance(MockRead(), SupportsRead)}")
+print(f"MockNoRead is SupportsRead: {isinstance(MockNoRead(), SupportsRead)}")
