new file mode 100644
index 00000000..1d46dbf2
--- /dev/null
+++ b/_test_proxy.py
@@ -0,0 +1,17 @@
+
+from typing import Protocol, runtime_checkable
+
+@runtime_checkable
+class SupportsRead(Protocol):
+    def read(self, length: int = ...):
+        ...
+
+class Proxy:
+    def __getattr__(self, name):
+        if name == "read":
+            return lambda length=10: b"data"
+        raise AttributeError(name)
+
+p = Proxy()
+print(f"hasattr(p, 'read'): {hasattr(p, 'read')}")
+print(f"isinstance(p, SupportsRead): {isinstance(p, SupportsRead)}")
