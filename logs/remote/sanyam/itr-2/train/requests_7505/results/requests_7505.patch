@@ -0,0 +1,70 @@
+
+import requests
+from requests.models import Request
+from requests.sessions import Session
+
+class ProxyRead:
+    def __init__(self, data):
+        self._data = data
+    def __getattr__(self, name):
+        attr = getattr(self._data, name)
+        if callable(attr):
+            def wrapper(*args, **kwargs):
+                return attr(*args, **kwargs)
+            return wrapper
+        return attr
+
+def test_proxy_read_prepare_body():
+    # Test that a proxy object with a read method is treated as a read-like object
+    # and does not get encoded as application/x-www-form-urlencoded
+    
+    # Create a mock read-like object
+    class MockRead:
+        def read(self, size=-1):
+            return b"test data"
+    
+    read_obj = MockRead()
+    proxy_read = ProxyRead(read_obj)
+    
+    # We want to see if prepare_body handles proxy_read correctly.
+    # In prepare_body, if it's recognized as read-like, content_type remains None
+    # (or is set by something else), but it should NOT be set to application/x-www-form-urlencoded
+    # if it's recognized as read-like.
+    
+    # Actually, the logic is:
+    # if isinstance(data, basestring) or isinstance(data, _SupportsRead) or hasattr(data, "read"):
+    #     content_type = None
+    # else:
+    #     content_type = "application/x-www-form-urlencoded"
+    
+    # Let's use a Request object and call prepare_body
+    req = Request('POST', 'http://example.com', data=proxy_read)
+    session = Session()
+    # prepare_body is called during prepare_request
+    prepared = session.prepare_request(req)
+    
+    # If it was recognized as read-like, content_type should be None (unless it was set elsewhere)
+    # If it was NOT recognized, it would be 'application/x-www-form-urlencoded'
+    assert prepared.headers.get('Content-Type') != 'application/x-www-form-urlencoded', \
+        f"ProxyRead object was incorrectly identified as non-read-like. Content-Type: {prepared.headers.get('Content-Type')}"
+
+def test_proxy_read_encode_params():
+    # Test the other occurrence in _encode_params
+    # RequestEncodingMixin._encode_params is called when data is not a stream
+    # But wait, the check is in prepare_body, which calls _encode_params.
+    
+    # Let's test the logic in _encode_params indirectly via prepare_body
+    # The first occurrence was:
+    # if isinstance(data, basestring) or isinstance(data, _SupportsRead) or hasattr(data, "read"):
+    #     # ...
+    
+    # Let's just use the same test as above, as it covers the logic.
+    pass
+
+if __name__ == "__main__":
+    try:
+        test_proxy_read_prepare_body()
+        print("Test passed!")
+    except Exception as e:
+        print(f"Test failed: {e}")
+        exit(1)
