@@ -0,0 +1,27 @@
+from typing import Annotated, Any
+from fastapi import FastAPI, Query
+from pydantic import BeforeValidator, WithJsonSchema
+import pytest
+
+app = FastAPI()
+
+FilterableStr = Annotated[
+    str | dict,
+    BeforeValidator(lambda x: x),
+    WithJsonSchema({"type": "string"}, mode="serialization"),
+]
+
+try:
+    @app.get("/hello")
+    async def get_hello(data: FilterableStr | None = Query(default=None)) -> Any:
+        return data
+except AssertionError as e:
+    print(f"Caught expected AssertionError: {e}")
+    assert str(e) == "Query param 'data' must be of one of the supported types"
+    print("Error message is correct!")
+except Exception as e:
+    print(f"Caught unexpected exception: {type(e).__name__}: {e}")
+    raise e
+else:
+    print("No AssertionError raised, but one was expected.")
+    raise AssertionError("No AssertionError raised")
