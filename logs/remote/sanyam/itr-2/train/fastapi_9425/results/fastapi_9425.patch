diff --git a/_check.py b/_check.py
new file mode 100644
index 00000000..107e7b2e
--- /dev/null
+++ b/_check.py
@@ -0,0 +1,24 @@
+from fastapi import FastAPI, Response
+from fastapi.testclient import TestClient
+
+app = FastAPI()
+
+@app.get("/none_str", status_code=204)
+def read_none_str() -> "None":
+    return None
+
+client = TestClient(app)
+
+def test_none_str_return():
+    response = client.get("/none_str")
+    assert response.status_code == 204
+    print("Test passed!")
+
+if __name__ == "__main__":
+    try:
+        test_none_str_return()
+    except Exception as e:
+        print(f"Test failed: {e}")
+        import traceback
+        traceback.print_exc()
+        exit(1)
