new file mode 100644
index 00000000..286c7a59
--- /dev/null
+++ b/_check.py
@@ -0,0 +1,31 @@
+from rich.console import Console
+import os
+
+def test_html_export():
+    console = Console(force_terminal=True, record=True)
+    console.print("Hello World")
+    html_content = console.export_html()
+    
+    print(html_content)
+    assert "<head>" in html_content
+    assert "</head>" in html_content
+    assert "<html" in html_content
+    assert "</html>" in html_content
+    
+    # Check if <html> comes before <head>
+    head_start = html_content.find("<head>")
+    html_start = html_content.find("<html")
+    
+    if html_start == -1 or html_start > head_start:
+        print(f"FAIL: <html tag is missing or comes after <head> tag. html_start: {html_start}, head_start: {head_start}")
+        assert False, "<html tag should come before <head> tag"
+    else:
+        print("PASS: <html tag comes before <head> tag")
+
+if __name__ == "__main__":
+    try:
+        test_html_export()
+        print("Test passed!")
+    except Exception as e:
+        print(f"Test failed: {e}")
+        exit(1)
