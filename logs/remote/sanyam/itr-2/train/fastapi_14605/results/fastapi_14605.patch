diff --git a/_check.py b/_check.py
new file mode 100644
index 00000000..29945677
--- /dev/null
+++ b/_check.py
@@ -0,0 +1,23 @@
+import warnings
+from fastapi.exceptions import FastAPIDeprecationWarning
+from fastapi.temp_pydantic_v1_params import Param
+
+def test_deprecation_warning():
+    with warnings.catch_warnings(record=True) as w:
+        warnings.simplefilter("always")
+        # Trigger the warning in Param.__init__
+        Param(example="some example")
+        
+        # Check if any warning was emitted
+        assert len(w) > 0
+        # Check if the warning is of type FastAPIDeprecationWarning
+        assert issubclass(w[-1].category, FastAPIDeprecationWarning)
+        assert "`example` has been deprecated" in str(w[-1].message)
+
+if __name__ == "__main__":
+    try:
+        test_deprecation_warning()
+        print("Check passed!")
+    except Exception as e:
+        print(f"Check failed: {e}")
+        exit(1)
