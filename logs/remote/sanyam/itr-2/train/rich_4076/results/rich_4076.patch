@@ -0,0 +1,17 @@
+from rich.text import Text
+
+def test_fit_preserves_newlines():
+    text = Text("line1\nline2\n")
+    # Current behavior: fit(10) -> [Text("line1"), Text("line2")]
+    # Desired behavior: fit(10) -> [Text("line1"), Text("line2"), Text("")]
+    lines = text.fit(10)
+    assert len(lines) == 3, f"Expected 3 lines, got {len(lines)}"
+    assert lines[2].plain == "", f"Expected last line to be empty, got {repr(lines[2].plain)}"
+
+if __name__ == "__main__":
+    try:
+        test_fit_preserves_newlines()
+        print("Test passed!")
+    except AssertionError as e:
+        print(f"Test failed: {e}")
+        exit(1)
