index 00000000..2ce00957
--- /dev/null
+++ b/_check.py
@@ -0,0 +1,42 @@
+
+from fastapi import FastAPI, Depends, Security
+from fastapi.testclient import TestClient
+import pytest
+
+counter = 0
+
+def dep_a():
+    global counter
+    counter += 1
+    return "a"
+
+def dep_b(a=Depends(dep_a)):
+    return a
+
+def dep_c(a=Depends(dep_a)):
+    return a
+
+app = FastAPI()
+
+@app.get("/")
+async def root(b=Security(dep_b, scopes=["read"]), c=Security(dep_c, scopes=["write"])):
+    return {"b": b, "c": c}
+
+client = TestClient(app)
+
+def test_cache_with_different_scopes():
+    global counter
+    counter = 0
+    response = client.get("/")
+    assert response.status_code == 200
+    assert response.json() == {"b": "a", "c": "a"}
+    print(f"dep_a was called {counter} times")
+    assert counter == 1, f"dep_a should be called once, but was called {counter} times"
+
+if __name__ == "__main__":
+    try:
+        test_cache_with_different_scopes()
+        print("Test passed!")
+    except AssertionError as e:
+        print(f"Test failed: {e}")
+        exit(1)
