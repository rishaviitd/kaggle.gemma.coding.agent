+from rich.console import Console
+from rich.table import Table
+from rich.text import Text
+
+def test_highlight_added_columns():
+    console = Console(force_terminal=True)
+    # Create a table with highlight=True
+    table = Table(highlight=True)
+    
+    # Add a row with more columns than the table has (currently 0)
+    # This will trigger the creation of new columns in add_row
+    table.add_row("1", "2")
+    
+    # We want to check if the created columns have highlight=True
+    for col in table.columns:
+        print(f"Column {col._index} highlight: {col.highlight}")
+        assert col.highlight is True, f"Column {col._index} should have highlight=True"
+
+if __name__ == "__main__":
+    try:
+        test_highlight_added_columns()
+        print("Test passed!")
+    except AssertionError as e:
+        print(f"Test failed: {e}")
+        exit(1)
+    except Exception as e:
+        print(f"An error occurred: {e}")
+        exit(1)
