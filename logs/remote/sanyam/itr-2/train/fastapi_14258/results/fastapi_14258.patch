+from fastapi import FastAPI, APIRouter
+from fastapi.exceptions import FastAPIError
+import pytest
+
+def test_include_router_into_itself():
+    router = APIRouter()
+    try:
+        router.include_router(router)
+    except FastAPIError as exc:
+        assert str(exc) == "Cannot include a router into itself"
+        print("Caught expected FastAPIError")
+        return
+    except Exception as exc:
+        print(f"Caught unexpected exception: {type(exc).__name__}: {exc}")
+        raise exc
+    else:
+        print("Failed to raise FastAPIError when including router into itself")
+        raise AssertionError("Should have raised FastAPIError")
+
+if __name__ == "__main__":
+    try:
+        test_include_router_into_itself()
+        print("Test passed!")
+    except Exception as e:
+        print(f"Test failed: {e}")
+        exit(1)
