diff --git a/_check.py b/_check.py
new file mode 100644
index 00000000..ee7af855
--- /dev/null
+++ b/_check.py
@@ -0,0 +1,30 @@
+
+from rich.console import Console
+from rich.file_proxy import FileProxy
+import io
+
+class MockFile(io.TextIOBase):
+    def isatty(self):
+        return True
+    def write(self, s):
+        pass
+    def flush(self):
+        pass
+
+def test_file_proxy_isatty():
+    mock_file = MockFile()
+    proxy = FileProxy(Console(), mock_file)
+    console = Console(file=proxy)
+    
+    print(f"Is terminal: {console.is_terminal}")
+    assert console.is_terminal is True
+
+if __name__ == "__main__":
+    try:
+        test_file_proxy_isatty()
+        print("Test passed!")
+    except Exception as e:
+        print(f"Test failed: {e}")
+        import traceback
+        traceback.print_exc()
+        exit(1)
