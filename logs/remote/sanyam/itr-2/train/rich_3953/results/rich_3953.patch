@@ -0,0 +1,24 @@
+from rich.cells import cell_len
+
+test_cases = [
+    ("A", 1),
+    ("👨", 2),
+    ("👨\u200d💻", 2),
+    ("👨\u200d💻\u200d👩", 2),
+    ("A\u200d", 1),
+    ("\u200d", 0),
+    ("\u200d\u200d", 0),
+    ("A\u200dB", 1),
+    ("A\u200dB\u200dC", 1),
+    ("👨\u200d", 2),
+    ("👨\u200d\u200d💻", 2),
+]
+
+for text, expected in test_cases:
+    try:
+        actual = cell_len(text)
+        print(f"text={text!r}, expected={expected}, actual={actual}")
+        assert actual == expected, f"Failed for {text!r}: expected {expected}, got {actual}"
+    except Exception as e:
+        print(f"text={text!r} raised exception: {e}")
+        raise e
