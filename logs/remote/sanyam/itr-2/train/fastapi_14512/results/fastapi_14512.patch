+from fastapi import FastAPI, Body
+from fastapi.testclient import TestClient
+from typing import Literal, Union, Annotated
+from pydantic import BaseModel, Field
+import json
+
+class Cat(BaseModel):
+    meow: bool
+    kind: Literal["cat"]
+
+class Dog(BaseModel):
+    bark: bool
+    kind: Literal["dog"]
+
+Pet = Annotated[Union[Cat, Dog], Field(discriminator="kind")]
+
+app = FastAPI()
+
+@app.post("/pet")
+async def create_pet(pet: Annotated[Pet, Body()]):
+    return pet
+
+def test_openapi_schema():
+    schema = app.openapi()
+    paths = schema["paths"]
+    pet_post = paths["/pet"]["post"]
+    request_body = pet_post["requestBody"]["content"]["application/json"]["schema"]
+    print(json.dumps(request_body, indent=2))
+    assert "oneOf" in request_body, "Schema should have 'oneOf'"
+    assert "discriminator" in request_body, "Schema should have 'discriminator'"
+
+if __name__ == "__main__":
+    try:
+        test_openapi_schema()
+        print("Test passed!")
+    except Exception as e:
+        print(f"Test failed: {e}")
+        import traceback
+        traceback.print_exc()
+        exit(1)
