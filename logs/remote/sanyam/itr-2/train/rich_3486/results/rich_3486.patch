diff --git a/_check_rich_traceback.py b/_check_rich_traceback.py
new file mode 100644
index 00000000..343d388c
--- /dev/null
+++ b/_check_rich_traceback.py
@@ -0,0 +1,16 @@
+from rich.traceback import Traceback
+import sys
+
+def foo():
+    1/0
+
+try:
+    foo()
+except Exception as e:
+    exc_type, exc_value, tb_obj = sys.exc_info()
+    tb = Traceback.from_exception(exc_type, exc_value, tb_obj)
+    for stack in tb.trace.stacks:
+        for frame in stack.frames:
+            print(f"File: {frame.filename}, Line: {frame.lineno}, Col: {frame.colno}, End Col: {frame.end_colno}")
+            assert frame.colno is not None, "colno should be populated"
+            assert frame.end_colno is not None, "end_colno should be populated"
