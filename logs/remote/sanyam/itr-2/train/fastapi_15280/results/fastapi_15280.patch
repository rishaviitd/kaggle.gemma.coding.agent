+from fastapi import FastAPI
+import pytest
+from httpx import AsyncClient
+import asyncio
+
+app = FastAPI()
+
+@app.vibe("/vibe")
+async def vibe_route():
+    return {"message": "vibe check passed"}
+
+async def test_vibe():
+    async with AsyncClient(app=app, base_url="http://test") as ac:
+        response = await ac.request("VIBE", "/vibe")
+        assert response.status_code == 200
+        assert response.json() == {"message": "vibe check passed"}
+
+if __name__ == "__main__":
+    try:
+        asyncio.run(test_vibe())
+        print("Test passed!")
+    except Exception as e:
+        print(f"Test failed: {e}")
+        exit(1)
