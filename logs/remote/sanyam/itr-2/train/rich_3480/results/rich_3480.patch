diff --git a/_check.py b/_check.py
new file mode 100644
index 00000000..22aa461d
--- /dev/null
+++ b/_check.py
@@ -0,0 +1,15 @@
+from rich.text import Text
+import time
+
+def test_infinite_loop():
+    print("Testing for infinite loop in Text.append(self) with style...")
+    t = Text("Hello", style="red")
+    try:
+        # This should trigger the infinite loop if t._spans is not empty
+        t.append(t)
+        print("Finished without infinite loop!")
+    except Exception as e:
+        print(f"Caught exception: {e}")
+
+if __name__ == "__main__":
+    test_infinite_loop()
