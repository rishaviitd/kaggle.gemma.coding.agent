+from __future__ import annotations
+from typing import ForwardRef, get_type_hints
+from fastapi import FastAPI, Depends
+from pydantic import BaseModel
+import inspect
+
+app = FastAPI()
+
+class Item(BaseModel):
+    name: str
+    price: float
+
+def get_item():
+    return Item(name="Test", price=10.0)
+
+# Manually set a ForwardRef in annotations
+def read_root(item: Item = Depends(get_item)):
+    return item
+
+read_root.__annotations__['item'] = ForwardRef('Item')
+
+def test_annotations():
+    from fastapi.dependencies.utils import get_typed_signature
+    sig = get_typed_signature(read_root)
+    annotation = sig.parameters["item"].annotation
+    print(f"Annotation: {annotation}")
+    print(f"Type of annotation: {type(annotation)}")
+    assert annotation is Item, f"Expected Item class, got {annotation} of type {type(annotation)}"
+
+if __name__ == "__main__":
+    try:
+        test_annotations()
+        print("Test passed!")
+    except AssertionError as e:
+        print(f"Test failed: {e}")
+    except Exception as e:
+        print(f"An error occurred: {e}")
+        import traceback
+        traceback.print_exc()
