@@ -0,0 +1,22 @@
+from rich.text import Text
+from rich._wrap import divide_line
+
+def test_cjk_wrap():
+    # CJK character 'こ' has cell_len 2.
+    # If width is 1, it should be folded.
+    word = "こ"
+    width = 1
+    divides = divide_line(word, width, fold=True)
+    lines = Text(word).divide(divides)
+    
+    for line in lines:
+        assert str(line) != ""
+
+if __name__ == "__main__":
+    try:
+        test_cjk_wrap()
+        print("Test passed!")
+    except AssertionError:
+        print("Test failed: Empty line found!")
+    except Exception as e:
+        print(f"An error occurred: {e}")
