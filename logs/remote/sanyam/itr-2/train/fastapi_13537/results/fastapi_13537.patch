diff --git a/_check.py b/_check.py
new file mode 100644
index 00000000..540438e0
--- /dev/null
+++ b/_check.py
@@ -0,0 +1,30 @@
+
+from fastapi import FastAPI, Form
+from fastapi.testclient import TestClient
+from typing import Optional
+import pytest
+
+app = FastAPI()
+
+@app.post("/test")
+async def test_endpoint(value: Optional[int] = Form(None)):
+    return {"value": value}
+
+client = TestClient(app)
+
+def test_empty_string_as_none():
+    # Sending an empty string for an optional int field with default None
+    # should result in the value being None, not a validation error.
+    response = client.post("/test", data={"value": ""})
+    assert response.status_code == 200
+    assert response.json() == {"value": None}
+
+if __name__ == "__main__":
+    try:
+        test_empty_string_as_none()
+        print("Test passed!")
+    except Exception as e:
+        print(f"Test failed: {e}")
+        import traceback
+        traceback.print_exc()
+        exit(1)
