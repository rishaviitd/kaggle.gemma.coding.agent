+from rich.console import Console
+
+def test_broken_pipe():
+    # We can't easily simulate | head here without a subprocess, 
+    # but we can simulate writing to a closed file.
+    import os
+    r, w = os.pipe()
+    os.close(r)
+    
+    # Use a Console with the write end of the pipe
+    console = Console(file=os.fdopen(w, 'w'))
+    
+    # We want to see if rich handles BrokenPipeError internally
+    # If it doesn't, this will raise BrokenPipeError
+    try:
+        for i in range(10000):
+            console.print(f"Line {i}")
+    except BrokenPipeError:
+        print("BrokenPipeError propagated")
+    except Exception as e:
+        print(f"Other exception: {type(e).__name__}: {e}")
+    else:
+        print("No exception")
+
+if __name__ == "__main__":
+    test_broken_pipe()
