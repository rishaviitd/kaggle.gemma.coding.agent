@@ -0,0 +1,61 @@
+
+import asyncio
+import functools
+import inspect
+from fastapi.dependencies.models import Dependant
+
+async def async_func():
+    return "hello"
+
+def sync_func():
+    return "hello"
+
+class CallableClass:
+    async def __call__(self):
+        return "hello"
+
+class SyncCallableClass:
+    def __call__(self):
+        return "hello"
+
+def test_dependant_properties():
+    # Async function
+    d_async = Dependant(call=async_func)
+    print(f"Async func: is_coroutine_callable={d_async.is_coroutine_callable}")
+    
+    # Partial of async function
+    p_async = functools.partial(async_func)
+    d_p_async = Dependant(call=p_async)
+    print(f"Partial async func: is_coroutine_callable={d_p_async.is_coroutine_callable}")
+    
+    # Sync function
+    d_sync = Dependant(call=sync_func)
+    print(f"Sync func: is_coroutine_callable={d_sync.is_coroutine_callable}")
+    
+    # Partial of sync function
+    p_sync = functools.partial(sync_func)
+    d_p_sync = Dependant(call=p_sync)
+    print(f"Partial sync func: is_coroutine_callable={d_p_sync.is_coroutine_callable}")
+    
+    # Async callable class
+    c_async = CallableClass()
+    d_c_async = Dependant(call=c_async)
+    print(f"Async callable class: is_coroutine_callable={d_c_async.is_coroutine_callable}")
+    
+    # Partial of async callable class
+    p_c_async = functools.partial(c_async)
+    d_p_c_async = Dependant(call=p_c_async)
+    print(f"Partial async callable class: is_coroutine_callable={d_p_c_async.is_coroutine_callable}")
+
+    # Sync callable class
+    c_sync = SyncCallableClass()
+    d_c_sync = Dependant(call=c_sync)
+    print(f"Sync callable class: is_coroutine_callable={d_c_sync.is_coroutine_callable}")
+    
+    # Partial of sync callable class
+    p_c_sync = functools.partial(c_sync)
+    d_p_c_sync = Dependant(call=p_c_sync)
+    print(f"Partial sync callable class: is_coroutine_callable={d_p_c_sync.is_coroutine_callable}")
+
+if __name__ == "__main__":
+    test_dependant_properties()
diff --git a/_test_unwrap.py b/_test_unwrap.py
new file mode 100644
index 00000000..1fa4f1b0
--- /dev/null
+++ b/_test_unwrap.py
@@ -0,0 +1,62 @@
+
+import functools
+import inspect
+import asyncio
+
+async def async_func():
+    pass
+
+def sync_func():
+    pass
+
+def wrap(f):
+    def wrapper(*args, **kwargs):
+        return f(*args, **kwargs)
+    wrapper.__wrapped__ = f
+    return wrapper
+
+def test_unwrap():
+    # Simple
+    assert unwrap_partial(async_func) == async_func
+    
+    # Partial
+    p = functools.partial(async_func)
+    assert unwrap_partial(p) == async_func
+    
+    # Nested partial
+    pp = functools.partial(p)
+    assert unwrap_partial(pp) == async_func
+    
+    # Wrapped
+    w = wrap(async_func)
+    assert unwrap_partial(w) == async_func
+    
+    # Partial of wrapped
+    pw = functools.partial(w)
+    assert unwrap_partial(pw) == async_func
+    
+    # Wrapped of partial
+    wp = wrap(p)
+    assert unwrap_partial(wp) == async_func
+    
+    # Nested everything
+    nested = functools.partial(wrap(functools.partial(async_func)))
+    assert unwrap_partial(nested) == async_func
+
+def unwrap_partial(call):
+    while True:
+        if isinstance(call, functools.partial):
+            call = call.func
+            continue
+        unwrapped = inspect.unwrap(call)
+        if unwrapped is call:
+            break
+        call = unwrapped
+    return call
+
+if __name__ == "__main__":
+    try:
+        test_unwrap()
+        print("All tests passed!")
+    except AssertionError as e:
+        print(f"Test failed: {e}")
