diff --git a/_check.py b/_check.py
new file mode 100644
index 00000000..90128f78
--- /dev/null
+++ b/_check.py
@@ -0,0 +1,26 @@
+
+import pickle
+import requests
+from requests.exceptions import JSONDecodeError
+
+def test_json_decode_error_pickle():
+    try:
+        # Simulate a JSONDecodeError
+        err = JSONDecodeError("msg", "doc", 0)
+        print(f"Original error: {err}")
+        
+        pickled = pickle.dumps(err)
+        unpickled = pickle.loads(pickled)
+        
+        print(f"Unpickled error: {unpickled}")
+        
+        assert type(err) is type(unpickled)
+        assert err.args == unpickled.args
+        print("Pickling successful!")
+        
+    except Exception as e:
+        print(f"Pickling failed with error: {e}")
+        raise e
+
+if __name__ == "__main__":
+    test_json_decode_error_pickle()
