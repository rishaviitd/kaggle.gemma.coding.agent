+from rich.console import Console
+from rich.panel import Panel
+from rich.segment import Segment
+
+def get_title_line(title, align):
+    console = Console(width=40)
+    panel = Panel("Content", title=title, title_align=align)
+    # We want to capture the output of the panel
+    # Since __rich_console__ is a generator of segments, we can collect them
+    segments = list(panel.__rich_console__(console, console.options))
+    
+    # The title line is the first line of segments
+    # But segments are not grouped by line.
+    # We need to find where the first line ends.
+    
+    line = ""
+    for segment in segments:
+        if segment.text == "\n":
+            break
+        line += segment.text
+    return line
+
+print(f"Left:   '{get_title_line('Title', 'left')}'")
+print(f"Center: '{get_title_line('Title', 'center')}'")
+print(f"Right:  '{get_title_line('Title', 'right')}'")
