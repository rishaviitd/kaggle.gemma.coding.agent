+def graphemes(text: str) -> Iterable[str]:
+    """Split text into graphemes."""
+    grapheme = []
+    for i, char in enumerate(text):
+        is_combining = (
+            unicodedata.combining(char)
+            or unicodedata.category(char).startswith("M")
+        )
+        is_zwj = char == "\u200d"
+        prev_was_zwj = i > 0 and text[i - 1] == "\u200d"
+
+        if is_combining or is_zwj or prev_was_zwj:
+            grapheme.append(char)
+        else:
+            if grapheme:
+                yield "".join(grapheme)
+            grapheme = [char]
+    if grapheme:
+        yield "".join(grapheme)
+
