diff --git a/_check.py b/_check.py
new file mode 100644
index 00000000..5746ade8
--- /dev/null
+++ b/_check.py
@@ -0,0 +1,35 @@
+
+from typing import ForwardRef, List
+import inspect
+from fastapi.dependencies.utils import get_typed_annotation
+
+class Item:
+    pass
+
+def foo(a: ForwardRef("List[Item]")):
+    pass
+
+def test_forwardref_not_string():
+    annotation = foo.__annotations__['a']
+    print(f"Annotation type: {type(annotation)}")
+    print(f"Annotation value: {annotation}")
+    
+    globalns = foo.__globals__
+    resolved = get_typed_annotation(annotation, globalns)
+    
+    print(f"Resolved annotation: {resolved}")
+    
+    expected = List[Item]
+    print(f"Expected: {expected}")
+    
+    assert resolved == expected, f"Expected {expected}, got {resolved}"
+
+if __name__ == "__main__":
+    try:
+        test_forwardref_not_string()
+        print("Test passed!")
+    except Exception as e:
+        print(f"Test failed: {e}")
+        import traceback
+        traceback.print_exc()
+        exit(1)
