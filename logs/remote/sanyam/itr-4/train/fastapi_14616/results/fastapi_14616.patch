+
+from fastapi import FastAPI, Form
+from pydantic import Json
+from fastapi.testclient import TestClient
+from typing import List
+
+app = FastAPI()
+
+@app.post("/test_json")
+async def test_json(tags: Json[List[str]] = Form()):
+    return {"tags": tags}
+
+@app.post("/test_list")
+async def test_list(tags: List[str] = Form()):
+    return {"tags": tags}
+
+client = TestClient(app)
+
+if __name__ == "__main__":
+    print(f"JSON form: {client.post('/test_json', data={'tags': '[\"abc\", \"def\"]'}).json()}")
+    print(f"List form: {client.post('/test_list', data={'tags': '[\"abc\", \"def\"]'}).json()}")
