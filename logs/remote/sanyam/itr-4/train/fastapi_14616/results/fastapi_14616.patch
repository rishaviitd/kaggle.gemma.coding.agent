+
+from pydantic import BaseModel, Json
+from typing import List
+
+class Model(BaseModel):
+    tags: Json[List[str]]
+
+print(f"Parsing string: {Model(tags='[\"abc\", \"def\"]')}")
+try:
+    print(f"Parsing list: {Model(tags=['[\"abc\", \"def\"]'])}")
+except Exception as e:
+    print(f"Parsing list failed: {e}")
