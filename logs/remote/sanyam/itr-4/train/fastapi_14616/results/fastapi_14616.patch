@@ -0,0 +1,34 @@
+
+from fastapi import FastAPI, Form
+from pydantic import Json
+from fastapi.testclient import TestClient
+from typing import List
+
+app = FastAPI()
+
+@app.post("/test")
+async def test(tags: Json[List[str]] = Form()):
+    return {"tags": tags}
+
+client = TestClient(app)
+
+def test_json_form():
+    # This should work: send a JSON string
+    response = client.post("/test", data={"tags": '["abc", "def"]'})
+    print(f"Response 1: {response.json()}")
+    assert response.status_code == 200
+
+def test_json_form_failure():
+    # This is what happens when FastAPI uses getlist()
+    # It wraps the string in a list: ['["abc", "def"]']
+    # Pydantic's Json validator will then fail because it gets a list instead of a string.
+    # We can simulate this by sending the same key twice or something that forces getlist?
+    # No, if is_sequence_field is True, FastAPI calls getlist() even for one value.
+    pass
+
+if __name__ == "__main__":
+    try:
+        test_json_form()
+        print("Success!")
+    except Exception as e:
+        print(f"Error: {e}")
