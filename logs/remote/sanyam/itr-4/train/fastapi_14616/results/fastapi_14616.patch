@@ -0,0 +1,34 @@
+
+from typing import Annotated, List
+from pydantic import Json
+from fastapi import FastAPI, Form, UploadFile
+from fastapi.testclient import TestClient
+
+app = FastAPI()
+
+@app.post("/upload")
+def upload(
+    file: UploadFile,
+    tags: Annotated[Json[List[str]], Form()]
+):
+    return {"file": file.filename, "tags": tags}
+
+client = TestClient(app)
+
+def test_upload_json_list():
+    # We need a file for UploadFile
+    file_content = b"hello"
+    files = {"file": ("test.txt", file_content), "tags": '["abc", "def"]'}
+    response = client.post("/upload", files=files)
+    print(f"Response: {response.json()}")
+    assert response.status_code == 200
+    assert response.json()["tags"] == ["abc", "def"]
+
+if __name__ == "__main__":
+    try:
+        test_upload_json_list()
+        print("Test passed!")
+    except Exception as e:
+        print(f"Test failed: {e}")
+        import traceback
+        traceback.print_exc()
