+
+from typing import List
+from pydantic import Json
+from fastapi.dependencies.utils import is_sequence_field
+
+class MockField:
+    def __init__(self, annotation):
+        self.field_info = type('FieldInfo', (), {'annotation': annotation})()
+
+field_json_list = MockField(Json[List[str]])
+print(f"Annotation: {repr(field_json_list.field_info.annotation)}")
+print(f"is_sequence_field(Json[list[str]]): {is_sequence_field(field_json_list)}")
