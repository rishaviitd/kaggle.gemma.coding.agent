diff --git a/_check.py b/_check.py
new file mode 100644
index 00000000..dc6cd18a
--- /dev/null
+++ b/_check.py
@@ -0,0 +1,35 @@
+
+import pickle
+import json
+from requests.exceptions import JSONDecodeError
+
+def test_json_decode_error_pickle():
+    # json.JSONDecodeError(msg, doc, pos)
+    # requests.exceptions.JSONDecodeError takes *args, **kwargs
+    # and calls CompatJSONDecodeError.__init__(self, *args)
+    # then InvalidJSONError.__init__(self, *self.args, **kwargs)
+    
+    try:
+        # Create a JSONDecodeError instance
+        # Typical args: message, doc, pos
+        e = JSONDecodeError("msg", "doc", 0)
+        print(f"Original error: {e}")
+        
+        # Pickle it
+        pickled = pickle.dumps(e)
+        print("Pickled successfully")
+        
+        # Unpickle it
+        unpickled = pickle.loads(pickled)
+        print(f"Unpickled error: {unpickled}")
+        
+        assert isinstance(unpickled, JSONDecodeError)
+        assert unpickled.args == e.args
+        print("Success!")
+        
+    except Exception as ex:
+        print(f"Failed: {ex}")
+        raise ex
+
+if __name__ == "__main__":
+    test_json_decode_error_pickle()
diff --git a/_check_invalid.py b/_check_invalid.py
new file mode 100644
index 00000000..b33993f4
--- /dev/null
+++ b/_check_invalid.py
@@ -0,0 +1,18 @@
+
+import pickle
+from requests.exceptions import InvalidJSONError
+
+def test_invalid_json_error_pickle():
+    try:
+        e = InvalidJSONError("some error")
+        pickled = pickle.dumps(e)
+        unpickled = pickle.loads(pickled)
+        assert isinstance(unpickled, InvalidJSONError)
+        assert unpickled.args == e.args
+        print("InvalidJSONError pickled successfully")
+    except Exception as ex:
+        print(f"InvalidJSONError failed: {ex}")
+        raise ex
+
+if __name__ == "__main__":
+    test_invalid_json_error_pickle()
