@@ -0,0 +1,40 @@
+from fastapi import FastAPI, Depends, Security, APIRouter
+from fastapi.security import SecurityScopes
+from fastapi.testclient import TestClient
+
+def dep_a(security_scopes: SecurityScopes):
+    return security_scopes.scopes
+
+def dep_b(security_scopes: SecurityScopes, a_scopes = Depends(dep_a)):
+    return {"a_scopes": a_scopes, "b_scopes": security_scopes.scopes}
+
+router = APIRouter(dependencies=[Security(dep_a, scopes=["scope_router"])])
+
+@router.get("/test")
+def read_test(res = Security(dep_b, scopes=["scope_route"])):
+    return res
+
+app = FastAPI()
+app.include_router(router)
+
+client = TestClient(app)
+
+def test_propagation():
+    response = client.get("/test")
+    print(f"Response: {response.json()}")
+    assert response.status_code == 200
+    # dep_b should see both scope_router (from router) and scope_route (from route)
+    # Let's see if it does.
+    expected_scopes = ["scope_router", "scope_route"]
+    # The order might be different
+    assert sorted(response.json()["b_scopes"]) == sorted(expected_scopes)
+    assert sorted(response.json()["a_scopes"]) == sorted(expected_scopes)
+
+if __name__ == "__main__":
+    try:
+        test_propagation()
+        print("Test passed!")
+    except AssertionError as e:
+        print(f"Test failed: {e}")
+    except Exception as e:
+        print(f"Error: {e}")
