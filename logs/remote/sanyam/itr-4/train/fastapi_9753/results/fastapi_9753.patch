diff --git a/_check.py b/_check.py
new file mode 100644
index 00000000..f00f0b41
--- /dev/null
+++ b/_check.py
@@ -0,0 +1,62 @@
+
+import asyncio
+import functools
+from fastapi.dependencies.models import Dependant
+from typing import Any
+
+async def async_dep():
+    return "async_dep_value"
+
+def sync_dep():
+    return "sync_dep_value"
+
+async def async_gen_dep():
+    yield "async_gen_value"
+
+def sync_gen_dep():
+    yield "sync_gen_value"
+
+class ClassDep:
+    async def __call__(self):
+        return "class_dep_value"
+
+class SyncClassDep:
+    def __call__(self):
+        return "sync_class_dep_value"
+
+async def test_dependencies():
+    # Async function
+    dep_async = Dependant(call=async_dep)
+    dep_partial_async = Dependant(call=functools.partial(async_dep))
+    
+    # Sync function
+    dep_sync = Dependant(call=sync_dep)
+    dep_partial_sync = Dependant(call=functools.partial(sync_dep))
+    
+    # Async gen function
+    dep_async_gen = Dependant(call=async_gen_dep)
+    dep_partial_async_gen = Dependant(call=functools.partial(async_gen_dep))
+    
+    # Sync gen function
+    dep_sync_gen = Dependant(call=sync_gen_dep)
+    dep_partial_sync_gen = Dependant(call=functools.partial(sync_gen_dep))
+    
+    # Async class
+    class_dep = ClassDep()
+    dep_class_async = Dependant(call=class_dep)
+    dep_partial_class_async = Dependant(call=functools.partial(class_dep))
+    
+    # Sync class
+    sync_class_dep = SyncClassDep()
+    dep_class_sync = Dependant(call=sync_class_dep)
+    dep_partial_class_sync = Dependant(call=functools.partial(sync_class_dep))
+
+    print(f"Async: is_coroutine={dep_async.is_coroutine_callable}, partial={dep_partial_async.is_coroutine_callable}")
+    print(f"Sync: is_coroutine={dep_sync.is_coroutine_callable}, partial={dep_partial_sync.is_coroutine_callable}")
+    print(f"Async Gen: is_async_gen={dep_async_gen.is_async_gen_callable}, partial={dep_partial_async_gen.is_async_gen_callable}")
+    print(f"Sync Gen: is_gen={dep_sync_gen.is_gen_callable}, partial={dep_partial_sync_gen.is_gen_callable}")
+    print(f"Class Async: is_coroutine={dep_class_async.is_coroutine_callable}, partial={dep_partial_class_async.is_coroutine_callable}")
+    print(f"Class Sync: is_coroutine={dep_class_sync.is_coroutine_callable}, partial={dep_partial_class_sync.is_coroutine_callable}")
+
+if __name__ == "__main__":
+    asyncio.run(test_dependencies())
