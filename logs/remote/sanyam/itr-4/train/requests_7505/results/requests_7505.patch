new file mode 100644
index 00000000..e736b757
--- /dev/null
+++ b/_check_proxy.py
@@ -0,0 +1,10 @@
+from requests._types import SupportsRead
+class Proxy:
+    def __getattr__(self, name):
+        if name == 'read':
+            return lambda length=None: b"data"
+        raise AttributeError(name)
+
+p = Proxy()
+print(f"hasattr(p, 'read'): {hasattr(p, 'read')}")
+print(f"isinstance(p, SupportsRead): {isinstance(p, SupportsRead)}")
