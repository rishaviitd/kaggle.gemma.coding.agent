diff --git a/_check.py b/_check.py
new file mode 100644
index 00000000..a4b20b73
--- /dev/null
+++ b/_check.py
@@ -0,0 +1,33 @@
+
+import requests
+from requests._types import is_supports_read
+
+class ProxyRead:
+    def __getattr__(self, name):
+        if name == "read":
+            return lambda: b"proxy data"
+        raise AttributeError(name)
+
+def test_is_supports_read():
+    proxy = ProxyRead()
+    # This should return True now
+    assert is_supports_read(proxy) is True, "ProxyRead should be identified as supporting read"
+    
+    # Normal readable object
+    from io import BytesIO
+    bio = BytesIO(b"hello")
+    assert is_supports_read(bio) is True, "BytesIO should be identified as supporting read"
+    
+    # Non-readable object
+    assert is_supports_read(123) is False, "int should not be identified as supporting read"
+
+if __name__ == "__main__":
+    try:
+        test_is_supports_read()
+        print("Check passed!")
+    except AssertionError as e:
+        print(f"Check failed: {e}")
+        exit(1)
+    except Exception as e:
+        print(f"An unexpected error occurred: {e}")
+        exit(1)
