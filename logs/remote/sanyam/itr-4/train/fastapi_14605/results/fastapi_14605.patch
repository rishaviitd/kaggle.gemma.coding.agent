diff --git a/_check.py b/_check.py
new file mode 100644
index 00000000..f7e89de3
--- /dev/null
+++ b/_check.py
@@ -0,0 +1,14 @@
+import warnings
+import pytest
+from fastapi.params import Param
+from fastapi.exceptions import FastAPIDeprecationWarning
+
+def test_param_example_deprecation():
+    with pytest.warns(FastAPIDeprecationWarning) as record:
+        Param(example="some example")
+    assert "`example` has been deprecated" in str(record[-1].message)
+
+def test_param_regex_deprecation():
+    with pytest.warns(FastAPIDeprecationWarning) as record:
+        Param(regex="some regex")
+    assert "`regex` has been deprecated" in str(record[-1].message)
