+
+from fastapi import FastAPI
+from fastapi.testclient import TestClient
+from pydantic import BaseModel, ConfigDict
+
+class Unserializable:
+    def __init__(self):
+        self.value = "hello"
+    def __repr__(self):
+        return "Unserializable"
+
+class Model(BaseModel):
+    model_config = ConfigDict(arbitrary_types_allowed=True)
+    name: str
+    arb: Unserializable
+
+app = FastAPI()
+
+@app.get("/")
+def read_root():
+    return Model(name="test", arb=Unserializable())
+
+client = TestClient(app)
+
+def test_routing_arbitrary_type():
+    try:
+        response = client.get("/")
+        print(f"Response status: {response.status_code}")
+        print(f"Response body: {response.json()}")
+        assert response.status_code == 200
+        # If it uses mode="json", this might be {"name": "test", "arb": {}} or fail.
+        # If it uses mode="python", it should be {"name": "test", "arb": {"value": "hello"}}
+        assert response.json() == {"name": "test", "arb": {"value": "hello"}}
+        print("SUCCESS")
+    except Exception as e:
+        print(f"FAILED: {type(e).__name__}: {e}")
+        raise e
+
+if __name__ == "__main__":
+    test_routing_arbitrary_type()
