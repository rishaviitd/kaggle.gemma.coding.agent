diff --git a/_check.py b/_check.py
new file mode 100644
index 00000000..1e53004a
--- /dev/null
+++ b/_check.py
@@ -0,0 +1,15 @@
+from rich.text import Text, Span
+
+def test_infinite_loop():
+    print("Testing infinite loop in Text.append when appending self with spans...")
+    t = Text("hello")
+    t._spans.append(Span(0, 5, "red"))
+    
+    try:
+        t.append(t)
+        print("Successfully appended self without infinite loop")
+    except Exception as e:
+        print(f"Caught exception: {e}")
+
+if __name__ == "__main__":
+    test_infinite_loop()
