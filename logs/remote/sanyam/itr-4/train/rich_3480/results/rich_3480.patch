@@ -0,0 +1,17 @@
+from rich.text import Text
+
+def test_copy_styles_infinite_loop():
+    print("Testing infinite loop in Text.copy_styles when copying from self...")
+    t = Text("hello")
+    t._spans.append(Text()._spans[0] if t._spans else None) # Just something
+    # Actually just add a span
+    from rich.text import Span
+    t._spans.append(Span(0, 1, "red"))
+    try:
+        t.copy_styles(t)
+        print("Successfully copied styles from self without infinite loop")
+    except Exception as e:
+        print(f"Caught exception: {e}")
+
+if __name__ == "__main__":
+    test_copy_styles_infinite_loop()
