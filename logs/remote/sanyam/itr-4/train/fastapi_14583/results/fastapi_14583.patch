@@ -0,0 +1,42 @@
+
+import warnings
+from fastapi.utils import create_model_field
+from fastapi._compat import may_v1
+
+def test_pydantic_v1_warning():
+    with warnings.catch_warnings(record=True) as w:
+        warnings.simplefilter("always")
+        
+        # Trigger via annotation_is_pydantic_v1
+        from fastapi._compat.shared import annotation_is_pydantic_v1
+        from pydantic import BaseModel as PydanticBaseModel
+        
+        # In Pydantic v2, if we want a v1 model, we use pydantic.v1.BaseModel
+        # But we need to make sure may_v1.BaseModel is indeed Pydantic v1.
+        # Let's try creating a Pydantic v1 model using may_v1.BaseModel
+        class V1Model(may_v1.BaseModel):
+            x: int
+        
+        annotation_is_pydantic_v1(V1Model)
+        
+        # Check if DeprecationWarning was issued
+        v1_warnings = [warn for warn in w if issubclass(warn.category, DeprecationWarning) and "Pydantic v1 is deprecated" in str(warn.message)]
+        assert len(v1_warnings) > 0, "DeprecationWarning not issued for Pydantic v1 model"
+        
+        # Should only be issued once
+        create_model_field("field", int, version="1")
+        v1_warnings_after = [warn for warn in w if issubclass(warn.category, DeprecationWarning) and "Pydantic v1 is deprecated" in str(warn.message)]
+        assert len(v1_warnings_after) == 1, f"DeprecationWarning issued more than once: {len(v1_warnings_after)}"
+
+    print("Warning test passed!")
+
+    print("Warning test passed!")
+
+if __name__ == "__main__":
+    try:
+        test_pydantic_v1_warning()
+    except Exception as e:
+        print(f"Test failed: {e}")
+        import traceback
+        traceback.print_exc()
+        exit(1)
diff --git a/_check_once.py b/_check_once.py
new file mode 100644
index 00000000..de6e29c7
--- /dev/null
+++ b/_check_once.py
@@ -0,0 +1,45 @@
+
+import warnings
+from fastapi import FastAPI
+from pydantic.v1 import BaseModel
+import pytest
+
+def test_pydantic_v1_warning_once():
+    with warnings.catch_warnings(record=True) as w:
+        warnings.simplefilter("always")
+        
+        class ItemV1(BaseModel):
+            name: str
+            price: float
+
+        class OtherItemV1(BaseModel):
+            name: str
+
+        app = FastAPI()
+
+        @app.get("/1")
+        def read_item1(item: ItemV1):
+            return item
+
+        @app.get("/2")
+        def read_item2(item: OtherItemV1):
+            return item
+
+        v1_warnings = [
+            warn for warn in w 
+            if issubclass(warn.category, DeprecationWarning) and "Pydantic v1" in str(warn.message)
+        ]
+        
+        assert len(v1_warnings) == 1, f"Expected exactly 1 DeprecationWarning, got {len(v1_warnings)}"
+        print(f"Caught {len(v1_warnings)} warning(s)")
+
+if __name__ == "__main__":
+    try:
+        test_pydantic_v1_warning_once()
+        print("Check passed!")
+    except AssertionError as e:
+        print(f"Check failed: {e}")
+        exit(1)
+    except Exception as e:
+        print(f"An error occurred: {e}")
+        exit(1)
