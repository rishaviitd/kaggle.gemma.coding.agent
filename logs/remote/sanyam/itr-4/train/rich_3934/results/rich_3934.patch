+from rich.live import Live
+from rich.console import Console
+from rich.text import Text
+import time
+
+def test_empty_live_clear_multi():
+    console = Console(force_terminal=True)
+    console.width = 20
+    
+    with Live(Text("Line 1\nLine 2"), console=console) as live:
+        time.sleep(0.1)
+        live.update("") # Update to empty string
+        time.sleep(0.1)
+        console.print("Something else")
+
+if __name__ == "__main__":
+    test_empty_live_clear_multi()
