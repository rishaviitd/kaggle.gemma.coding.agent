+from rich.text import Text
+from rich.console import Console
+from io import StringIO
+
+def test_double_width_wrap():
+    console = Console(width=1, force_terminal=False, file=StringIO())
+    
+    # "你好" - each char is 2 width.
+    # With width 1, it MUST fold.
+    text = Text("你好")
+    lines = text.wrap(console, 1, overflow="fold")
+    for line in lines:
+        console.print(line)
+    
+    output = console.file.getvalue()
+    print(f"Output:\n{output}")
+    
+    assert "你好" in output.replace('\n', ''), "Double-width characters disappeared!"
+
+if __name__ == "__main__":
+    try:
+        test_double_width_wrap()
+        print("Test passed!")
+    except AssertionError as e:
+        print(f"Test failed: {e}")
+        exit(1)
+    except Exception as e:
+        print(f"Unexpected error: {e}")
+        exit(1)
