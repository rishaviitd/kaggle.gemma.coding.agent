--- /dev/null
+++ b/_test_regex.py
@@ -0,0 +1,9 @@
+import re
+def escape_backslashes(match):
+    backslashes, text = match.groups()
+    return f"{backslashes}{backslashes}\\{text}"
+
+_escape = re.compile(r"(\\*)(\[[a-z#/@][^[]*?])").sub
+print(f"Result: {_escape(escape_backslashes, 'hello [bold]')!r}")
+print(f"Result: {_escape(escape_backslashes, 'hello \\[bold]')!r}")
+print(f"Result: {_escape(escape_backslashes, 'hello \\\\ [bold]')!r}")
