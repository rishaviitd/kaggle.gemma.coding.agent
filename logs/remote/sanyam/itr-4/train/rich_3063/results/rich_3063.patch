diff --git a/_check_escape.py b/_check_escape.py
new file mode 100644
index 00000000..51a1ea25
--- /dev/null
+++ b/_check_escape.py
@@ -0,0 +1,11 @@
+from rich.markup import escape, render
+def test_escape(text):
+    escaped = escape(text)
+    rendered = render(escaped)
+    print(f"Original: {text!r} -> Escaped: {escaped!r} -> Rendered: {rendered}")
+
+test_escape("hello [bold]world[/bold]")
+test_escape("hello [bold]")
+test_escape("hello \\")
+test_escape("hello \\\\")
+test_escape("hello \\[")
diff --git a/_test_regex.py b/_test_regex.py
new file mode 100644
