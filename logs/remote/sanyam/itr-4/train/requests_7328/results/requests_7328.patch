+import requests
+from requests import Session, Response
+from requests.models import Request
+from requests.utils import CaseInsensitiveDict
+
+def test_self_reference():
+    s = Session()
+    
+    # Mock responses
+    # Resp 1: 302 -> Resp 2
+    # Resp 2: 302 -> Resp 3
+    # Resp 3: 200
+    
+    class MockResponse(Response):
+        def __init__(self, status_code, url, location=None, history=None):
+            super().__init__()
+            self.status_code = status_code
+            self.url = url
+            self.history = history or []
+            self.headers = CaseInsensitiveDict({'Location': location}) if location else CaseInsensitiveDict()
+            self.raw = None
+
+    responses = [
+        MockResponse(302, 'http://example.com/1', location='http://example.com/2'),
+        MockResponse(302, 'http://example.com/2', location='http://example.com/3'),
+        MockResponse(200, 'http://example.com/3'),
+    ]
+    
+    from requests.adapters import HTTPAdapter
+    
+    class MockAdapter(HTTPAdapter):
+        def __init__(self, *args, **kwargs):
+            super().__init__(*args, **kwargs)
+            self.count = 0
+            
+        def send(self, request, **kwargs):
+            res = responses[self.count]
+            self.count += 1
+            return res
+            
+    s.mount('http://', MockAdapter())
+    
+    resp = s.get('http://example.com/1', allow_redirects=True)
+    
+    print(f"Final response URL: {resp.url}")
+    print(f"Final response history length: {len(resp.history)}")
+    for i, h in enumerate(resp.history):
+        print(f"History[{i}] URL: {h.url}")
+        if h is resp:
+            print(f"SELF REFERENCE FOUND at index {i}!")
+            
+    assert resp not in resp.history, "Current response is in its own history!"
+    print("No self reference found.")
+
+if __name__ == "__main__":
+    try:
+        test_self_reference()
+    except AssertionError as e:
+        print(f"Assertion failed: {e}")
+    except Exception as e:
+        import traceback
+        traceback.print_exc()
