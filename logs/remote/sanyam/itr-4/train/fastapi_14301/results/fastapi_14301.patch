index 00000000..fb0b243c
--- /dev/null
+++ b/_check.py
@@ -0,0 +1,40 @@
+import asyncio
+from fastapi import FastAPI, Depends
+from fastapi.testclient import TestClient
+from typing import Annotated
+
+app = FastAPI()
+count = 0
+
+async def dep_func():
+    global count
+    count += 1
+    return "value"
+
+async def dep_second(val: Annotated[str, Depends(dep_func)]):
+    return val
+
+@app.get("/test")
+async def test_route(
+    val1: Annotated[str, Depends(dep_func, scope="function")],
+    val2: Annotated[str, Depends(dep_second)],
+):
+    return {"val1": val1, "val2": val2}
+
+client = TestClient(app)
+
+def test_scope_function():
+    global count
+    count = 0
+    response = client.get("/test")
+    print(f"Count: {count}")
+    assert response.status_code == 200
+    assert count == 2, f"Expected 2, got {count}"
+
+if __name__ == "__main__":
+    try:
+        test_scope_function()
+        print("Test passed!")
+    except AssertionError as e:
+        print(f"Test failed: {e}")
+        exit(1)
