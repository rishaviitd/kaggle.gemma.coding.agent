diff --git a/fastapi/openapi/utils.py b/fastapi/openapi/utils.py
index 812003ae..d237f4c4 100644
--- a/fastapi/openapi/utils.py
+++ b/fastapi/openapi/utils.py
@@ -476,6 +476,18 @@ def get_fields_from_routes(
     return flat_models
 
 
+def replace_binary_format(schema: Any) -> None:
+    if isinstance(schema, dict):
+        if schema.get("format") == "binary":
+            schema["contentMediaType"] = "application/octet-stream"
+            del schema["format"]
+        for value in schema.values():
+            replace_binary_format(value)
+    elif isinstance(schema, list):
+        for item in schema:
+            replace_binary_format(item)
+
+
 def get_openapi(
     *,
     title: str,
@@ -568,4 +580,5 @@ def get_openapi(
         output["tags"] = tags
     if external_docs:
         output["externalDocs"] = external_docs
+    replace_binary_format(output)
     return jsonable_encoder(OpenAPI(**output), by_alias=True, exclude_none=True)  # type: ignore
