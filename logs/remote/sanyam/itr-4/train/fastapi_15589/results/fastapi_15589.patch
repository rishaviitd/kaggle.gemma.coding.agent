diff --git a/_check.py b/_check.py
new file mode 100644
index 000000000..11fa264e9
--- /dev/null
+++ b/_check.py
@@ -0,0 +1,59 @@
+
+from fastapi import FastAPI, Header
+from fastapi.testclient import TestClient
+from typing import Optional
+
+app = FastAPI()
+
+@app.get("/headers")
+async def read_headers(my_header: Optional[str] = Header(default=None)):
+    return {"my_header": my_header}
+
+@app.get("/headers_disabled")
+async def read_headers_disabled(my_header: Optional[str] = Header(default=None, convert_underscores=False)):
+    return {"my_header": my_header}
+
+client = TestClient(app)
+
+def test_default_behavior():
+    print("Testing default behavior (convert_underscores=True)...")
+    # Should accept 'my-header'
+    response = client.get("/headers", headers={"my-header": "hyphen"})
+    assert response.json() == {"my_header": "hyphen"}
+    print("  Accepted 'my-header' - OK")
+    
+    # Should NOT accept 'my_header' (should be None)
+    response = client.get("/headers", headers={"my_header": "underscore"})
+    print(f"  Response for 'my_header': {response.json()}")
+    assert response.json() == {"my_header": None}
+    print("  Rejected 'my_header' (got None) - OK")
+
+def test_disabled_behavior():
+    print("Testing disabled behavior (convert_underscores=False)...")
+    # Should accept 'my_header'
+    response = client.get("/headers_disabled", headers={"my_header": "underscore"})
+    assert response.json() == {"my_header": "underscore"}
+    print("  Accepted 'my_header' - OK")
+    
+    # Should NOT accept 'my-header' (should be None)
+    response = client.get("/headers_disabled", headers={"my-header": "hyphen"})
+    print(f"  Response for 'my-header': {response.json()}")
+    assert response.json() == {"my_header": None}
+    print("  Rejected 'my-header' (got None) - OK")
+
+if __name__ == "__main__":
+    try:
+        test_default_behavior()
+        print("test_default_behavior passed")
+    except Exception as e:
+        print(f"test_default_behavior failed: {e}")
+        import traceback
+        traceback.print_exc()
+
+    try:
+        test_disabled_behavior()
+        print("test_disabled_behavior passed")
+    except Exception as e:
+        print(f"test_disabled_behavior failed: {e}")
+        import traceback
+        traceback.print_exc()
diff --git a/_check_pydantic.py b/_check_pydantic.py
new file mode 100644
index 000000000..f1867f1ce
--- /dev/null
+++ b/_check_pydantic.py
@@ -0,0 +1,40 @@
+
+from fastapi import FastAPI, Header
+from fastapi.testclient import TestClient
+from pydantic import BaseModel
+from typing import Optional
+
+app = FastAPI()
+
+class HeaderModel(BaseModel):
+    my_header: Optional[str] = None
+
+@app.get("/headers")
+async def read_headers(header: HeaderModel = Header()):
+    return header
+
+client = TestClient(app)
+
+def test_pydantic_model_behavior():
+    print("Testing Pydantic model behavior (convert_underscores=True by default)...")
+    # Should accept 'my-header'
+    response = client.get("/headers", headers={"my-header": "hyphen"})
+    print(f"  Response for 'my-header': {response.json()}")
+    assert response.json() == {"my_header": "hyphen"}
+    print("  Accepted 'my-header' - OK")
+    
+    # Should NOT accept 'my_header' (should be None in the resulting model)
+    response = client.get("/headers", headers={"my_header": "underscore"})
+    print(f"  Response for 'my_header': {response.json()}")
+    # If the bug exists, this will be {"my_header": "underscore"}
+    assert response.json() == {"my_header": None}, f"Bug found! Expected {{'my_header': None}}, got {response.json()}"
+    print("  Rejected 'my_header' (got None) - OK")
+
+if __name__ == "__main__":
+    try:
+        test_pydantic_model_behavior()
+        print("test_pydantic_model_behavior passed")
+    except Exception as e:
+        print(f"test_pydantic_model_behavior failed: {e}")
+        import traceback
+        traceback.print_exc()
