+    @cached_property
+    def uses_scopes(self) -> bool:
+        if self.security_scopes_param_name is not None:
+            return True
+        if self.declared_scopes:
+            return True
+        for dep in self.dependencies:
+            if dep.uses_scopes:
+                return True
+        return False
+
     @cached_property
     def cache_key(self) -> DependencyCacheKey:
+        if self.uses_scopes:
+            scopes = tuple(sorted(set(self.security_scopes or [])))
+        else:
+            scopes = ()
         return (
             self.call,
-            tuple(sorted(set(self.security_scopes or []))),
+            scopes,
             self.computed_scope or "",
         )
 
