@@ -0,0 +1,21 @@
+
+import os
+
+def check_license_identifier():
+    filepath = "docs_src/metadata/tutorial001_1_py39.py"
+    with open(filepath, "r") as f:
+        content = f.read()
+        if '"identifier": "MIT"' in content:
+            print("Fail: Found 'identifier': 'MIT' in " + filepath)
+            return False
+        if '"identifier": "Apache-2.0"' not in content:
+            print("Fail: Did not find 'identifier': 'Apache-2.0' in " + filepath)
+            return False
+        print("Pass: License identifier is correctly set to 'Apache-2.0'")
+        return True
+
+if __name__ == "__main__":
+    if check_license_identifier():
+        exit(0)
+    else:
+        exit(1)
