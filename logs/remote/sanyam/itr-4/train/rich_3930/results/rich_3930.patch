+def split_graphemes(text: str) -> Iterator[str]:
+    """Split text into graphemes.
+
+    Args:
+        text (str): Text to split.
+
+    Returns:
+        Iterator[str]: An iterator of graphemes.
+    """
+    if not text:
+        return
+
+    grapheme = ""
+    for char in text:
+        if not grapheme:
+            grapheme += char
+            continue
+
+        if unicodedata.category(char).startswith("M") or char == "\u200d":
+            grapheme += char
+            continue
+
+        if grapheme[-1] == "\u200d":
+            grapheme += char
+            continue
+
+        yield grapheme
+        grapheme = char
+
+    if grapheme:
+        yield grapheme
+
+
