+import re
+from rich.cells import _is_single_cell_widths
+
+def test_fast_path():
+    # 'o' is \u006f. 'p' is \u0070.
+    # The current regex is [\\u0020-\\u006f\\u00a0\\u02ff\\u0370-\\u0482]*
+    
+    assert _is_single_cell_widths("hello"), "Should be True for 'hello'"
+    # 'hello' only contains characters up to 'o' (\u006f)
+    
+    # 'pizza' contains 'z' (\u007a), which is > \u006f
+    assert _is_single_cell_widths("pizza"), "Should be True for 'pizza' (contains 'z')"
+    
+    # 'test' contains 't' (\u0074), which is > \u006f
+    assert _is_single_cell_widths("test"), "Should be True for 'test' (contains 't')"
+
+if __name__ == "__main__":
+    try:
+        test_fast_path()
+        print("PASSED")
+    except AssertionError as e:
+        print(f"FAILED: {e}")
+    except Exception as e:
+        print(f"ERROR: {e}")
