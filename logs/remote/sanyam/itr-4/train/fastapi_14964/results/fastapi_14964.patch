new file mode 100644
index 00000000..87da57d0
--- /dev/null
+++ b/_check.py
@@ -0,0 +1,37 @@
+import warnings
+from unittest.mock import patch
+from fastapi.responses import UJSONResponse, ORJSONResponse
+
+def test_ujson_deprecation():
+    print("Testing UJSONResponse deprecation...")
+    with patch('fastapi.responses.UJSONResponse.render', return_value=b'{}'):
+        with warnings.catch_warnings(record=True) as w:
+            warnings.simplefilter("always")
+            UJSONResponse({"foo": "bar"})
+            deprecation_warnings = [warning for warning in w if warning.category is DeprecationWarning]
+            assert len(deprecation_warnings) > 0, "No DeprecationWarning issued for UJSONResponse"
+            assert any("UJSONResponse" in str(warning.message) for warning in deprecation_warnings)
+            print("UJSONResponse deprecation verified.")
+
+def test_orjson_deprecation():
+    print("Testing ORJSONResponse deprecation...")
+    with patch('fastapi.responses.ORJSONResponse.render', return_value=b'{}'):
+        with warnings.catch_warnings(record=True) as w:
+            warnings.simplefilter("always")
+            ORJSONResponse({"foo": "bar"})
+            deprecation_warnings = [warning for warning in w if warning.category is DeprecationWarning]
+            assert len(deprecation_warnings) > 0, "No DeprecationWarning issued for ORJSONResponse"
+            assert any("ORJSONResponse" in str(warning.message) for warning in deprecation_warnings)
+            print("ORJSONResponse deprecation verified.")
+
+if __name__ == "__main__":
+    try:
+        test_ujson_deprecation()
+        test_orjson_deprecation()
+        print("All tests passed!")
+    except AssertionError as e:
+        print(f"Test failed: {e}")
+        exit(1)
+    except Exception as e:
+        print(f"An unexpected error occurred: {e}")
+        exit(1)
