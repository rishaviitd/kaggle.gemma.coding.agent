diff --git a/_check.py b/_check.py
new file mode 100644
index 00000000..ddf2a862
--- /dev/null
+++ b/_check.py
@@ -0,0 +1,25 @@
+
+from fastapi import FastAPI
+from fastapi.testclient import TestClient
+
+def test_external_docs():
+    app = FastAPI(
+        title="Test API",
+        version="1.0.0",
+        external_docs={"url": "https://fastapi.tiangolo.com/", "description": "External Docs"}
+    )
+    client = TestClient(app)
+    response = client.get("/openapi.json")
+    assert response.status_code == 200
+    data = response.json()
+    assert "info" in data
+    assert data["info"]["externalDocs"] == {"url": "https://fastapi.tiangolo.com/", "description": "External Docs"}
+
+if __name__ == "__main__":
+    try:
+        test_external_docs()
+        print("Test passed!")
+    except Exception as e:
+        print(f"Test failed: {e}")
+        import sys
+        sys.exit(1)
