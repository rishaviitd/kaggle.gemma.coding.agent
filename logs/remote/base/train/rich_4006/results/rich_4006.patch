diff --git a/test_cell_len_zwj.py b/test_cell_len_zwj.py
new file mode 100644
index 00000000..d9e7bcc2
--- /dev/null
+++ b/test_cell_len_zwj.py
@@ -0,0 +1,13 @@
+from rich.cells import cell_len
+
+def test_cell_len_zwj():
+    # ZWJ is \u200d
+    # Test string: "A\u200dB"
+    text = "A\u200dB"
+    width = cell_len(text)
+    print(f"Text: {text!r}, Width: {width}")
+    assert width == 2
+    print("Cell len ZWJ test passed!")
+
+if __name__ == "__main__":
+    test_cell_len_zwj()
diff --git a/test_zwj.py b/test_zwj.py
new file mode 100644
index 00000000..e3573203
--- /dev/null
+++ b/test_zwj.py
@@ -0,0 +1,26 @@
+from rich.cells import split_graphemes
+
+def test_zwj_skipping():
+    # ZWJ is \u200d
+    # Test string: "A\u200dB"
+    text = "A\u200dB"
+    spans, total_width = split_graphemes(text)
+    print(f"Text: {text!r}")
+    print(f"Spans: {spans}")
+    print(f"Total width: {total_width}")
+    
+    # Expected: 
+    # 'A' is at index 0, width 1.
+    # '\u200d' is at index 1, width 0, associated with 'A'.
+    # 'B' is at index 2, width 1.
+    # Spans should be [(0, 2, 1), (2, 3, 1)]
+    # Total width should be 2.
+    
+    assert len(spans) == 2
+    assert spans[0] == (0, 2, 1)
+    assert spans[1] == (2, 3, 1)
+    assert total_width == 2
+    print("ZWJ skipping test passed!")
+
+if __name__ == "__main__":
+    test_zwj_skipping()
