--- /dev/null
+++ b/reproduce_issue.py
@@ -0,0 +1,51 @@
+from fastapi import FastAPI, Body
+from fastapi.testclient import TestClient
+from typing import Literal, Union, Annotated
+from pydantic import BaseModel, Field
+
+class Cat(BaseModel):
+    meow: bool
+    type: Literal["cat"]
+
+class Dog(BaseModel):
+    bark: bool
+    type: Literal["dog"]
+
+app = FastAPI()
+
+@app.post("/pet")
+async def create_pet(pet: Annotated[Union[Cat, Dog], Field(discriminator="type"), Body()]):
+    return pet
+
+client = TestClient(app)
+
+def test_tagged_union_body():
+    # Test Cat
+    response = client.post("/pet", json={"type": "cat", "meow": True})
+    assert response.status_code == 200
+    assert response.json() == {"type": "cat", "meow": True}
+
+    # Test Dog
+    response = client.post("/pet", json={"type": "dog", "bark": True})
+    assert response.status_code == 200
+    assert response.json() == {"type": "dog", "bark": True}
+
+    # Test invalid discriminator
+    response = client.post("/pet", json={"type": "bird", "fly": True})
+    assert response.status_code == 422
+    
+    # Check if it's a tagged union error or a regular union error
+    detail = response.json()["detail"]
+    # For a tagged union, we expect a 'union_tag_invalid' error
+    # For a regular union, we expect multiple errors (one for each union member)
+    assert len(detail[0]["loc"]) == 1 # should be ['body'] or similar, not ['body', 'Cat', ...]
+    assert detail[0]["type"] == "union_tag_invalid"
+
+if __name__ == "__main__":
+    try:
+        test_tagged_union_body()
+        print("Test passed!")
+    except Exception as e:
+        print(f"Test failed: {e}")
+        import traceback
+        traceback.print_exc()
