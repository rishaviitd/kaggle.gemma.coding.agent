diff --git a/pydantic_test.py b/pydantic_test.py
new file mode 100644
index 00000000..c5a253fe
--- /dev/null
+++ b/pydantic_test.py
@@ -0,0 +1,18 @@
+from typing import Literal, Union, Annotated
+from pydantic import BaseModel, Field, TypeAdapter, ValidationError
+
+class Cat(BaseModel):
+    meow: bool
+    type: Literal["cat"]
+
+class Dog(BaseModel):
+    bark: bool
+    type: Literal["dog"]
+
+Pet = Annotated[Union[Cat, Dog], Field(discriminator="type")]
+adapter = TypeAdapter(Pet)
+
+try:
+    adapter.validate_json(b'{"type": "bird", "fly": true}')
+except ValidationError as e:
+    print(e.json())
diff --git a/reproduce_issue.py b/reproduce_issue.py
new file mode 100644
