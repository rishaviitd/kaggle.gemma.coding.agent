+++ b/repro_alias.py
@@ -0,0 +1,43 @@
+
+from fastapi import FastAPI, Query
+from fastapi.testclient import TestClient
+from pydantic import Field
+from typing import Annotated
+
+app = FastAPI()
+
+@app.get("/")
+async def root(
+    q: Annotated[str, Query(validation_alias="query_alias")] = "default"
+):
+    return {"q": q}
+
+client = TestClient(app)
+
+def test_validation_alias():
+    response = client.get("/?query_alias=hello")
+    assert response.status_code == 200
+    assert response.json() == {"q": "hello"}
+
+def test_alias_fallback():
+    # Test that regular alias still works
+    @app.get("/alias")
+    async def alias_endpoint(
+        q: Annotated[str, Query(alias="alias_name")] = "default"
+    ):
+        return {"q": q}
+    
+    response = client.get("/alias?alias_name=world")
+    assert response.status_code == 200
+    assert response.json() == {"q": "world"}
+
+if __name__ == "__main__":
+    try:
+        test_validation_alias()
+        print("test_validation_alias passed!")
+        test_alias_fallback()
+        print("test_alias_fallback passed!")
+    except AssertionError as e:
+        print(f"Test failed: {e}")
+    except Exception as e:
+        print(f"An error occurred: {e}")
