@@ -0,0 +1,28 @@
+from fastapi import FastAPI
+from pydantic import BaseModel, ConfigDict
+from fastapi.utils import create_model_field
+from fastapi._compat import ModelField
+import pytest
+
+def test_arbitrary_types_allowed():
+    class MyType:
+        pass
+
+    # Pydantic v1 style config
+    class V1Config:
+        arbitrary_types_allowed = True
+
+    try:
+        # This should work if arbitrary_types_allowed is respected
+        field = create_model_field(
+            name="my_field",
+            type_=MyType,
+            model_config=V1Config
+        )
+        print("Field created successfully")
+    except Exception as e:
+        print(f"Field creation failed: {e}")
+        raise e
+
+if __name__ == "__main__":
+    test_arbitrary_types_allowed()
