@@ -0,0 +1,12 @@
+import traceback
+import sys
+
+def foo():
+    return 1 / 0
+
+try:
+    foo()
+except Exception as e:
+    te = traceback.TracebackException.from_exception(e)
+    for frame in te.stack:
+        print(f"File: {frame.filename}, Line: {frame.lineno}, Col: {getattr(frame, 'colno', 'N/A')}, Name: {frame.name}")
diff --git a/test_pep657_2.py b/test_pep657_2.py
new file mode 100644
index 00000000..d4fdb9ea
--- /dev/null
+++ b/test_pep657_2.py
@@ -0,0 +1,21 @@
+import traceback
+import sys
+
+def foo():
+    return 1 / 0
+
+try:
+    foo()
+except Exception as e:
+    exc_type, exc_value, tb = sys.exc_info()
+    
+    # Using walk_tb
+    print("walk_tb:")
+    for frame, lineno in traceback.walk_tb(tb):
+        print(f"Line: {lineno}")
+
+    # Using TracebackException
+    print("\nTracebackException:")
+    te = traceback.TracebackException(exc_type, exc_value, tb)
+    for frame_summary in te.stack:
+        print(f"Line: {frame_summary.lineno}, Col: {getattr(frame_summary, 'colno', 'N/A')}")
