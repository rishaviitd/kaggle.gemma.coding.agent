diff --git a/test_final.py b/test_final.py
new file mode 100644
index 00000000..1f571798
--- /dev/null
+++ b/test_final.py
@@ -0,0 +1,13 @@
+from rich.markup import _parse
+
+def test_parse_case(markup, expected):
+    result = list(_parse(markup))
+    print(f"Markup: {markup!r} -> Result: {result} | Expected: {expected}")
+    assert result == expected
+
+test_parse_case(r"hello\\world", [(0, "hello", None), (5, "\\", None), (6, "world", None)])
+test_parse_case(r"hello\world", [(0, "hello", None), (5, "\\", None), (6, "world", None)])
+test_parse_case(r"hello\\", [(0, "hello", None), (5, "\\", None)])
+test_parse_case(r"hello\", [(0, "hello", None), (5, "\\", None)])
+test_parse_case(r"\[escaped]", [(0, "[escaped]", None)])
+test_parse_case(r"\\[escaped]", [(0, "\\", None), (1, None, Tag(name="escaped"))]) # Wait, this depends on Tag definition
