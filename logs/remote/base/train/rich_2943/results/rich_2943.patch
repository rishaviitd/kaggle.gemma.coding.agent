+from rich.style import Style
+
+def test_clear_meta_and_links_hash():
+    style = Style.parse("bold red on black link https://example.org") + Style.on(
+        click="CLICK"
+    )
+    
+    # Trigger hash calculation
+    original_hash = hash(style)
+    print(f"Original hash: {original_hash}")
+    
+    clear_style = style.clear_meta_and_links()
+    
+    # Trigger hash calculation for clear_style
+    clear_hash = hash(clear_style)
+    print(f"Clear hash: {clear_hash}")
+    
+    assert original_hash != clear_hash, f"Hash should be different, but both are {original_hash}"
+    print("Test passed!")
+
+if __name__ == "__main__":
+    try:
+        test_clear_meta_and_links_hash()
+    except AssertionError as e:
+        print(f"Test failed: {e}")
+    except Exception as e:
+        print(f"An error occurred: {e}")
