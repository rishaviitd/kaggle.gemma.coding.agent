+from fastapi import FastAPI, Header
+from fastapi.testclient import TestClient
+from pydantic import BaseModel
+
+class HeaderModel(BaseModel):
+    x_token: str
+
+app = FastAPI()
+
+@app.get("/header")
+async def read_header(headers: HeaderModel = Header()):
+    return {"headers": headers}
+
+client = TestClient(app)
+
+def test_underscore_header():
+    response = client.get("/header", headers={"x_token": "foo"})
+    print(f"Underscore header response: {response.json()}")
+    assert response.status_code == 200
+    assert response.json() == {"headers": {"x_token": "foo"}}
+
+def test_hyphen_header():
+    response = client.get("/header", headers={"x-token": "bar"})
+    print(f"Hyphen header response: {response.json()}")
+    assert response.status_code == 200
+    assert response.json() == {"headers": {"x_token": "bar"}}
+
+if __name__ == "__main__":
+    try:
+        test_underscore_header()
+        print("test_underscore_header passed")
+    except Exception as e:
+        print(f"test_underscore_header failed: {e}")
+
+    try:
+        test_hyphen_header()
+        print("test_hyphen_header passed")
+    except Exception as e:
+        print(f"test_hyphen_header failed: {e}")
