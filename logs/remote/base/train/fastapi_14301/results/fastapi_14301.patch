diff --git a/reproduce_issue.py b/reproduce_issue.py
new file mode 100644
index 00000000..ce5f9fa9
--- /dev/null
+++ b/reproduce_issue.py
@@ -0,0 +1,42 @@
+
+from fastapi import FastAPI, Depends
+from fastapi.testclient import TestClient
+import pytest
+
+def test_dependency_scope_function():
+    app = FastAPI()
+    call_count = 0
+
+    def my_dependency():
+        nonlocal call_count
+        call_count += 1
+        return True
+
+    @app.get("/", dependencies=[Depends(my_dependency, scope="function")])
+    async def root(dep=Depends(my_dependency)):
+        return {"message": "Hello World"}
+
+    client = TestClient(app)
+    response = client.get("/")
+    assert response.status_code == 200
+    # Should be called twice because scope="function"
+    assert call_count == 2
+
+def test_dependency_scope_request():
+    app = FastAPI()
+    call_count = 0
+
+    def my_dependency():
+        nonlocal call_count
+        call_count += 1
+        return True
+
+    @app.get("/", dependencies=[Depends(my_dependency, scope="request")])
+    async def root(dep=Depends(my_dependency)):
+        return {"message": "Hello World"}
+
+    client = TestClient(app)
+    response = client.get("/")
+    assert response.status_code == 200
+    # Should be called once because scope="request" (cached)
+    assert call_count == 1
