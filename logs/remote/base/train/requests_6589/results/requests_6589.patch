@@ -0,0 +1,21 @@
+
+from requests.utils import super_len
+
+def test_super_len():
+    # ASCII string
+    s1 = "hello"
+    print(f"s1: {s1}, len: {len(s1)}, super_len: {super_len(s1)}")
+    
+    # Non-ASCII string
+    s2 = "你好"
+    print(f"s2: {s2}, len: {len(s2)}, super_len: {super_len(s2)}")
+    
+    # Bytes
+    b1 = b"hello"
+    print(f"b1: {b1}, len: {len(b1)}, super_len: {super_len(b1)}")
+    
+    b2 = "你好".encode("utf-8")
+    print(f"b2: {b2}, len: {len(b2)}, super_len: {super_len(b2)}")
+
+if __name__ == "__main__":
+    test_super_len()
