diff --git a/repro.py b/repro.py
new file mode 100644
index 000000000..06933499a
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,52 @@
+from fastapi import FastAPI, APIRouter
+from fastapi.testclient import TestClient
+import pytest
+
+def test_empty_path():
+    app = FastAPI()
+    router = APIRouter()
+    @router.get("")
+    async def root():
+        return {"message": "Hello World"}
+    app.include_router(router)
+    client = TestClient(app)
+    response = client.get("/")
+    assert response.status_code == 200
+    assert response.json() == {"message": "Hello World"}
+
+def test_slash_path():
+    app = FastAPI()
+    router = APIRouter()
+    @router.get("/")
+    async def root():
+        return {"message": "Hello World"}
+    app.include_router(router)
+    client = TestClient(app)
+    response = client.get("/")
+    assert response.status_code == 200
+    assert response.json() == {"message": "Hello World"}
+
+def test_prefix_empty_path():
+    app = FastAPI()
+    router = APIRouter()
+    @router.get("")
+    async def root():
+        return {"message": "Hello World"}
+    app.include_router(router, prefix="/users")
+    client = TestClient(app)
+    response = client.get("/users")
+    assert response.status_code == 200
+    assert response.json() == {"message": "Hello World"}
+
+if __name__ == "__main__":
+    try:
+        test_empty_path()
+        print("test_empty_path passed!")
+        test_slash_path()
+        print("test_slash_path passed!")
+        test_prefix_empty_path()
+        print("test_prefix_empty_path passed!")
+        print("All tests passed!")
+    except Exception as e:
+        print(f"Test failed: {e}")
+        raise e
