FROM swebench-sandbox:latest

# The organizer's prebuilt wheel cache contains a Starlette version newer than
# this FastAPI snapshot supports. Install the task-compatible version directly.
COPY wheels-fastapi-11194/ /tmp/task-wheels/
RUN python3 -m pip install --no-index --find-links=/tmp/task-wheels --no-deps starlette==0.48.0 \
    && rm -rf /tmp/task-wheels \
    && touch /usr/local/lib/python3.13/site-packages/.swegemma_whl_starlette
