+    (0xE0100, 0xE01EF),
+]
+
+
+def iter_graphemes(text: str):
+    """Iterate over the grapheme clusters in a string."""
+    if not text:
+        return
+
+    grapheme = ""
+    for char in text:
+        cp = ord(char)
+        is_continuation = False
+        for start, end in _GRAPHEME_CONTINUATION_RANGES:
+            if start <= cp <= end:
+                is_continuation = True
+                break
+
+        if grapheme and is_continuation:
+            grapheme += char
+        else:
+            if grapheme:
+                yield grapheme
+            grapheme = char
+    if grapheme:
+        yield grapheme
