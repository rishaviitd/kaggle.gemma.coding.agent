index 00000000..f620780d
--- /dev/null
+++ b/test_graphemes_fix.py
@@ -0,0 +1,55 @@
+from rich.cells import set_cell_size, chop_cells, cell_len
+
+def test_graphemes():
+    # Emoji with modifier: 👩‍👩‍👧‍👦 (Family: Woman, Woman, Girl, Boy)
+    # This is a sequence of emojis joined by ZWJ.
+    # It should be treated as a single grapheme.
+    family = "👩‍👩‍👧‍👦"
+    # In many terminals, this is 2 cells wide per emoji, but let's see what cell_len says.
+    # Actually, cell_len for this family emoji might be 8 (4 * 2).
+    # But it should be treated as one unit for wrapping/cropping.
+    
+    # Let's use a simpler example: a character with a combining mark.
+    # 'a' + combining acute accent (U+0301)
+    combined = "a\u0301" 
+    print(f"Combined: {combined}, len: {len(combined)}, cell_len: {cell_len(combined)}")
+    
+    # set_cell_size should not split 'a' and its accent.
+    # If total=1, it should keep both if the combined width is 1.
+    res = set_cell_size(combined, 1)
+    print(f"set_cell_size(combined, 1): {res}, len: {len(res)}")
+    assert res == combined
+    
+    # If total=0, it should be empty.
+    res = set_cell_size(combined, 0)
+    print(f"set_cell_size(combined, 0): {res}, len: {len(res)}")
+    assert res == ""
+
+    # chop_cells should not split 'a' and its accent.
+    res = chop_cells(combined, 1)
+    print(f"chop_cells(combined, 1): {res}")
+    assert res == [combined]
+    
+    # Test with a string that should be split
+    text = "abc\u0301def" # 'c' has an accent
+    # cell_len("abc\u0301def") = 1+1+1+0+1+1+1 = 6
+    print(f"Text: {text}, cell_len: {cell_len(text)}")
+    
+    # Chop at width 3: "abc\u0301" (width 3), "def" (width 3)
+    res = chop_cells(text, 3)
+    print(f"chop_cells(text, 3): {res}")
+    assert res == ["abc\u0301", "def"]
+
+    # Set cell size to 3: "abc\u0301"
+    res = set_cell_size(text, 3)
+    print(f"set_cell_size(text, 3): {res}")
+    assert res == "abc\u0301"
+
+    # Set cell size to 4: "abc\u0301d"
+    res = set_cell_size(text, 4)
+    print(f"set_cell_size(text, 4): {res}")
+    assert res == "abc\u0301d"
+
+if __name__ == "__main__":
+    test_graphemes()
+    print("All tests passed!")
