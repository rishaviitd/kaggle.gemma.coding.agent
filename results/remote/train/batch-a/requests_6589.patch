+++ b/test_super_len.py
@@ -0,0 +1,13 @@
+from requests.utils import super_len
+
+def test_super_len_str():
+    s = "🚀"
+    print(f"String: {s}, len(): {len(s)}, super_len(): {super_len(s)}")
+    # Expected: super_len should be 4 (UTF-8 bytes for 🚀)
+
+    s2 = "hello"
+    print(f"String: {s2}, len(): {len(s2)}, super_len(): {super_len(s2)}")
+    # Expected: super_len should be 5
+
+if __name__ == '__main__':
+    test_super_len_str()
