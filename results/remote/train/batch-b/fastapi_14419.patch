diff --git a/reproduce_issue.py b/reproduce_issue.py
new file mode 100644
index 00000000..728c43c8
--- /dev/null
+++ b/reproduce_issue.py
@@ -0,0 +1,44 @@
+from fastapi import FastAPI, Depends
+from fastapi.testclient import TestClient
+from fastapi.dependencies import SecurityScopes
+import pytest
+
+app = FastAPI()
+
+call_count = 0
+
+def dep_no_scopes():
+    global call_count
+    call_count += 1
+    return "value"
+
+@app.get("/")
+def read_root(d1=Depends(dep_no_scopes), d2=Depends(dep_no_scopes)):
+    return {"d1": d1, "d2": d2}
+
+client = TestClient(app)
+
+def test_dependency_caching_no_scopes():
+    global call_count
+    call_count = 0
+    response = client.get("/")
+    assert response.status_code == 200
+    assert response.json() == {"d1": "value", "d2": "value"}
+    assert call_count == 1
+
+def dep_with_scopes(scopes: SecurityScopes):
+    global call_count
+    call_count += 1
+    return "value"
+
+@app.get("/scopes")
+def read_scopes(d1=Depends(dep_with_scopes), d2=Depends(dep_with_scopes)):
+    return {"d1": d1, "d2": d2}
+
+def test_dependency_caching_with_scopes():
+    global call_count
+    call_count = 0
+    response = client.get("/scopes")
+    assert response.status_code == 200
+    assert response.json() == {"d1": "value", "d2": "value"}
+    assert call_count == 1
