--- /dev/null
+++ b/reproduction_script.py
@@ -0,0 +1,23 @@
+from rich.text import Text
+import pytest
+
+def test_append_self():
+    t = Text("hello")
+    with pytest.raises(ValueError, match="Cannot append Text to itself"):
+        t.append(t)
+
+def test_append_text_self():
+    t = Text("hello")
+    with pytest.raises(ValueError, match="Cannot append Text to itself"):
+        t.append_text(t)
+
+if __name__ == "__main__":
+    try:
+        test_append_self()
+        print("test_append_self passed")
+        test_append_text_self()
+        print("test_append_text_self passed")
+        print("All tests passed!")
+    except Exception as e:
+        print(f"Test failed: {e}")
+        raise e
