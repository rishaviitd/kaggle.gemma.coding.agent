KAGGLE_API_TOKEN=""
VLLM_API_KEY=""

# Model routing. The current local vLLM setup remains the default.
MODEL_PROVIDER="vllm"
MODEL_NAME="gemma4"
LOCAL_INFERENCE_URL="http://127.0.0.1:18001/v1"

# Set the matching key when using --provider openai, anthropic, or gemini.
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""

# Optional custom provider endpoints.
OPENAI_API_BASE=""
ANTHROPIC_API_BASE=""
GEMINI_API_BASE=""

# Langfuse is used only by the local offline artifact importer. Do not add
# these credentials to the internet-disabled Kaggle notebook.
LANGFUSE_PUBLIC_KEY="pk-lf-your-public-key"
LANGFUSE_SECRET_KEY="sk-lf-your-secret-key"
LANGFUSE_BASE_URL="https://us.cloud.langfuse.com"
